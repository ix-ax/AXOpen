# Auto detect text files and perform LF normalization
*          text=auto
# AxCode related files
*.yml  text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.st  text eol=lf
*.mon  text eol=lf

#DotNET related files
*.cs       text diff=csharp
*.cshtml   text diff=html
*.csx      text diff=csharp
*.sln      text eol=crlf
*.slnx     text eol=crlf
*.csproj   text eol=crlf
