@namespace AXOpen.Inspectors

<div class="flex flex-col items-center flex-shrink-0 @Class">
    @switch (@Result)
    {
        case 0:
            <Operon.Icons.HeroIcon Icon="minus-circle" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            break;
        case 10:
            <Operon.Icons.HeroIcon Icon="play-circle" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            break;
        case 20:
            <Operon.Icons.HeroIcon Icon="check-circle" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            break;
        case 30:
            <Operon.Icons.HeroIcon Icon="x-circle" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            break;
        case 35:
            <Operon.Icons.HeroIcon Icon="exclamation-circle" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            break;
        case 40:
            <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            break;
        case 50:
            <Operon.Icons.HeroIcon Icon="chevron-double-right" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            break;
    }

    @if (HasLabel)
    {
        <div>
            @switch (@Result)
            {
                case 0:
                    <p>@Localizer["NoAction"]</p>
                    break;
                case 10:
                    <p>@Localizer["Running"]</p>
                    break;
                case 20:
                    <p>@Localizer["Passed"]</p>
                    break;
                case 30:
                    <p>@Localizer["Failed"]</p>
                    break;
                case 35:
                    <p>@Localizer["Inconclusive"]</p>
                    break;
                case 40:
                    <p>@Localizer["Excluded"]</p>
                    break;
                case 50:
                    <p>@Localizer["Bypassed"]</p>
                    break;
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public short Result { get; set; }

    [Parameter]
    public bool HasLabel { get; set; } = true;

    [Parameter]
    public string Class { get; set; }
}