@namespace AXOpen.Inspectors
@using System.Globalization
@using AXOpen.Core.Blazor.AxoDialogs
@using AXSharp.Connector.Localizations
@using Microsoft.AspNetCore.Components.Authorization;
@inherits AxoDialogBaseView<AxoInspectorDialog>
@inject AuthenticationStateProvider _asp

<div class="border border-2 rounded p-3">
    <div class="p-3 mx-auto" style="width: 600px;">
        <h3>@InspectionDescription</h3>
    </div>
    <div class="d-flex flex-column align-items-center">
        <div>
            @switch (InspectorType)
            {
                case eInspectorType.Digital:
                    <RenderableContentControl Context="Component._digitalInspectorData" Presentation="Status"/>
                    break;
                case eInspectorType.Analogue:
                    <RenderableContentControl Context="Component._analogInspectorData" Presentation="Status"/>
                    break;
                case eInspectorType.Data:
                    <RenderableContentControl Context="Component._dataInspectorData" Presentation="Status"/>
                    break;
            }

        </div>

        <div class="mt-3" style="width: 100%;">
            <!-- Buttons in a row, centered horizontally -->
            <div class="d-flex justify-content-center">
                <button type="button" class="btn btn-secondary m-2 w-50" disabled="@RetryDisabled" @onclick="Retry">Retry</button>
                <button type="button" class="btn btn-secondary m-2 w-50" @onclick="Terminate">Terminate</button>
                <button type="button" class="btn btn-secondary m-2 w-50" @onclick="Override">Override</button>
            </div>
        </div>
    </div>

    <div class="mt-4">
        @if (!_asp.GetAuthenticationStateAsync().Result.User.Identity.IsAuthenticated)
        {
            <p>You are not authorized, please <a href="Identity/Account/Login">Log In</a>.</p>
        }
    </div>
</div>

@code
{
    string InspectionDescription { get; set; }
    eInspectorType InspectorType { get; set; }
    async Task<eInspectorType> GetInspectorType()
    {
        return (eInspectorType) await Component._inspectorType.GetAsync();
    }

    protected override async Task<Task> OnInitializedAsync()
    {
        InspectionDescription = await Component._inspectionDetails.GetAsync();
        InspectionDescription= Component.GetConnector().Translate(InspectionDescription, CultureInfo.CurrentCulture);
        InspectorType = await GetInspectorType();
        return base.OnInitializedAsync();
    }
}
