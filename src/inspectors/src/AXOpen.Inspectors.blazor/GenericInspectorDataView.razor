@namespace AXOpen.Inspectors

<div class="flex flex-col gap-4">
    <div class="flex flex-row gap-4">
        @if (Presentation != "ShadowControl")
        {
            @if (Presentation == "ShadowDisplay")
            {
                <RenderableContentControl Context="@Data.Timestamp" Presentation="ShadowDisplay" Class="w-1/3 card p-2" />
            }
            else
            {
                <RenderableContentControl Context="@Data.Timestamp" Presentation="Display" Class="w-1/3 card p-2" />
            }
        }

        <RenderableContentControl Context="@Data.FailTime" Presentation="@Presentation" Class="w-1/3 card p-2" />
        <RenderableContentControl Context="@Data.PassTime" Presentation="@Presentation" Class="w-1/3 card p-2" />
    </div>
    <div class="flex flex-row gap-4">
        @if (Presentation != "ShadowControl")
        {
            @if (Presentation == "ShadowDisplay")
            {
                <RenderableContentControl Context="@Data.Result" Presentation="ShadowDisplay" Class="w-1/3 card p-2" />
            }
            else
            {
                <RenderableContentControl Context="@Data.Result" Presentation="Display" Class="w-1/3 card p-2" />
            }
        }

        <RenderableContentControl Context="@Data.NumberOfAllowedRetries" Presentation="@Presentation" Class="w-1/3 card p-2" />

        @if (Presentation != "ShadowControl")
        {
            @if (Presentation == "ShadowDisplay")
            {
                <RenderableContentControl Context="@Data.RetryAttemptsCount" Presentation="ShadowDisplay" Class="w-1/3 card p-2" />
            }
            else
            {
                <RenderableContentControl Context="@Data.RetryAttemptsCount" Presentation="Display" Class="w-1/3 card p-2" />
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public AxoInspectorData Data { get; set; }
    [Parameter]
    public string Presentation { get; set; }
}