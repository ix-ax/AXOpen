@namespace AXOpen.Inspectors
@using AXSharp.Connector
@using System.Globalization
@using AXSharp.Connector.Localizations
@inherits RenderableComplexComponentBase<AxoDataInspectorData>




<InspectorViewTemplate Data="Component"
                       Name="@getNameOrSymbol()"
                       Presentation="Control"/>



@code {
    private string ID = "M" + Guid.NewGuid().ToString();

    public string getNameOrSymbol()
    {
        return string.IsNullOrEmpty(Component.AttributeName) ? Component.GetSymbolTail() : Component.GetAttributeName(CultureInfo.CurrentUICulture);
    }


    public override void ConfigurePolling()
    {
        this.StartPolling(this.Component, 500);
    }
}
