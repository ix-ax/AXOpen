@using Operon.Icons

<header style="position:fixed; top:0; left:0; right:0; height:3.75rem; margin-right:@(Main?.NavMenu?.NavCollapsed == true ? "0" : "16rem"); z-index:500; transition:margin 0.4s;" class="flex flex-wrap bg-slate-100">
    <div class="flex flex-wrap items-center mx-2">
        <a href="">
            <img src="logo-no-background.svg" alt="Logo" class="w-16" />
        </a>
    </div>

    <div class="flex flex-1 items-center justify-center">
        <span class="text-lg font-semibold text-text">AXOpen Showcase</span>
    </div>

    <div class="flex items-center mx-2">
        <AxOpen.Security.Views.LoginDisplay />
    </div>

    @if (Main?.NavMenu?.NavCollapsed == true)
    {
        <button class="btn btn-no-bg-primary" @onclick="() => Main?.NavMenu?.NavToggle()">
            <HeroIcon Icon="bars-3" Type="IconType.Outline" Class="size-6" />
        </button>
    }
</header>

@code {
    [Parameter]
    public MainLayout? Main { get; set; }

    public void StateHasChangedExternal()
    {
        StateHasChanged();
    }
}
