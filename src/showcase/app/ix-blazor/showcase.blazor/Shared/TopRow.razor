@using Operon.Icons
@inject IJSRuntime JS

<header style="position:fixed; top:0; left:0; right:0; height:3.75rem; margin-right:@(Main?.NavMenu?.NavCollapsed == true ? "0" : "16rem"); z-index:500; transition:margin 0.4s;" class="flex flex-wrap items-center border-b border-border bg-background-light/90 backdrop-blur">
    <div class="flex flex-wrap items-center mx-2">
        <a href="">
            <img src="logo-no-background.svg" alt="Logo" class="w-16" />
        </a>
    </div>

    <div class="flex flex-1 items-center justify-center">
        <span class="text-lg font-semibold text-text">AXOpen Showcase</span>
    </div>

    <div class="flex items-center mx-2 gap-2">
        <button class="flex items-center gap-1.5 rounded-lg border border-border bg-background/80 px-3 py-1.5 text-sm text-text-light hover:text-text hover:border-primary/40 transition-colors"
                @onclick="OpenSearch">
            <HeroIcon Icon="magnifying-glass" Type="IconType.Outline" Class="size-4" />
            <span class="hidden sm:inline text-xs">Search</span>
            <kbd class="hidden sm:inline text-[10px] text-text-light border border-border rounded px-1 py-0.5 font-mono ml-1">Ctrl+K</kbd>
        </button>

        <button class="flex items-center justify-center rounded-lg border border-border bg-background/80 p-1.5 text-text-light hover:text-text hover:border-primary/40 transition-colors"
                @onclick="ToggleThemeAsync" title="@(_dark ? "Switch to light" : "Switch to dark")" aria-label="Toggle theme">
            <HeroIcon Icon="@(_dark ? "sun" : "moon")" Type="IconType.Outline" Class="size-4" />
        </button>

        <AXOpen.Security.Blazor.Pages.LoginDisplay />
    </div>

    @if (Main?.NavMenu?.NavCollapsed == true)
    {
        <button class="btn btn-no-bg-primary" @onclick="() => Main?.NavMenu?.NavToggle()">
            <HeroIcon Icon="bars-3" Type="IconType.Outline" Class="size-6" />
        </button>
    }
</header>

@code {
    [Parameter]
    public MainLayout? Main { get; set; }

    private bool _dark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("themeInterop.get");
                if (theme == "dark") { _dark = true; StateHasChanged(); }
            }
            catch { }
        }
    }

    private async Task ToggleThemeAsync()
    {
        _dark = !_dark;
        try { await JS.InvokeVoidAsync("themeInterop.set", _dark ? "dark" : "light"); } catch { }
    }

    private void OpenSearch()
    {
        Main?.SearchDialog?.Open();
        Main?.StateHasChangedExternal();
    }

    public void StateHasChangedExternal()
    {
        StateHasChanged();
    }
}
