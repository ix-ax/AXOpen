@inherits LayoutComponentBase
@implements IDisposable
@using Operon.Components.Toast

<PageTitle>AXOpen Showcase</PageTitle>

<div style="display:flex; flex-direction:row; width:100%;" class="bg-background">
    <main style="flex:1; margin-top:3.75rem; margin-right:@(NavMenu?.NavCollapsed == true ? "0" : "16rem"); overflow:auto; transition:margin 0.4s;">
        <TopRow @ref="TopRow" Main="this" />
        <article class="p-4">
            @Body
        </article>
    </main>

    <NavMenu @ref="NavMenu" Main="this" />

    <ToastView />
</div>

@code {
    public NavMenu? NavMenu { get; set; }
    public TopRow? TopRow { get; set; }

    [Inject]
    private NavigationManager _navigationManager { get; set; } = default!;

    protected override void OnInitialized()
    {
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void StateHasChangedExternal()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
    }
}
