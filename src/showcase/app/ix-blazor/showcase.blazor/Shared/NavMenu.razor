@using Operon.Icons
@using showcase.blazor.Shared.Menu
@inject NavigationManager NavigationManager
@implements IDisposable

<div style="position:fixed; top:0; right:0; bottom:0; width:16rem; z-index:550; overflow-x:hidden; overflow-y:auto; transform:@(NavCollapsed ? "translateX(100%)" : "none"); transition:transform 0.4s;" class="flex flex-col bg-background-light">
    <nav class="nav">
        <!-- Sidebar Header / Brand -->
        <div class="flex flex-wrap p-4 gap-2 border-b-1 border-border items-center w-full">
            <div class="flex flex-wrap items-center gap-2">
                <div class="p-2 rounded-xl text-primary/90 bg-primary/8">
                    <HeroIcon Icon="bolt" Type="IconType.Solid" Class="size-7" />
                </div>
                <div class="flex flex-wrap flex-col">
                    <div class="text-xl text-text font-bold">AXOpen</div>
                    <div class="text-sm text-text/60 font-semibold">SHOWCASE</div>
                </div>
            </div>
            <!-- Desktop collapse toggle -->
            <button class="btn btn-no-bg-primary mx-2 ms-auto" @onclick="NavToggle" title="@(NavCollapsed ? "Expand menu" : "Collapse menu")">
                <HeroIcon Icon="chevron-right" Type="IconType.Outline" Class="size-5" />
            </button>
        </div>

        <!-- Navigation items — generated from the single ShowcaseCatalog source of truth -->
        <MenuItem Name="Home" Link="/" Icon="home" Description="DASHBOARD" />

        @foreach (var grp in _groupOrder)
        {
            var items = InGroup(grp.Name).ToList();
            if (items.Count == 0)
            {
                continue;
            }
            <ExpandableMenuItem Name="@grp.Name" Icon="@grp.Icon" Description="@grp.Description">
                @foreach (var d in items)
                {
                    <MenuItem Name="@d.Title" Link="@d.Route" Icon="@d.Icon" />
                }
            </ExpandableMenuItem>
        }

        <!-- Static items (kept out of the catalog-generated groups) -->
        <MenuItem Name="Visual Composer" Link="VisualComposer" Icon="eye" Description="VISUAL COMPOSER" />
        <MenuItem Name="Security" Link="Security" Icon="lock-closed" Description="ADMINISTRATION" />
    </nav>

    <!-- Bottom toggle -->
    <div class="flex flex-wrap justify-center p-4 mt-auto">
        <button class="btn btn-no-bg-primary w-full" @onclick="NavToggle">
            <HeroIcon Icon="bars-3" Type="IconType.Outline" Class="size-6" />
        </button>
    </div>

    <!-- Sidebar Footer -->
    <div class="flex flex-wrap p-4 sticky bottom-0 w-full">
        <a href="" class="opacity-75 hover:opacity-100">
            <img src="logo-header.svg" alt="Logo" class="h-15" />
        </a>
    </div>
</div>

@code {
    [Parameter]
    public MainLayout? Main { get; set; }

    public bool NavCollapsed = false;

    // Ordered navigation groups and their presentation; items come from the catalog by NavGroup.
    private static readonly (string Name, string Icon, string Description)[] _groupOrder =
    [
        ("Core", "cube", "FRAMEWORK"),
        ("Data", "circle-stack", "DATA MANAGEMENT"),
        ("Components", "squares-2x2", "GENERIC COMPONENTS"),
        ("Vendor Components", "building-office-2", "VENDOR-SPECIFIC"),
        ("Foundation", "wrench-screwdriver", "TOOLING"),
    ];

    private static IEnumerable<ShowcasePageDescriptor> InGroup(string group) =>
        ShowcaseCatalog.All
            .Where(d => d.ShowInNav && d.NavGroup == group)
            .OrderBy(d => d.NavOrder)
            .ThenBy(d => d.Title);

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        NavCollapsed = false;
        StateHasChanged();
    }

    public void NavToggle()
    {
        NavCollapsed = !NavCollapsed;
        StateHasChanged();
        Main?.StateHasChangedExternal();
        Main?.TopRow?.StateHasChangedExternal();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
