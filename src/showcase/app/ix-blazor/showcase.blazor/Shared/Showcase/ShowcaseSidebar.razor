@*
    ShowcaseSidebar — component overview, source references, and the LibraryResources panel,
    all projected from the descriptor.
*@
<aside class="space-y-4 xl:col-span-1">
    <section class="rounded-card border border-border bg-background-light p-4">
        <h2 class="text-base font-semibold text-text">Component Overview</h2>
        <ul class="mt-3 space-y-2 text-sm text-text-light">
            <li><span class="font-medium text-text">Category:</span> @Descriptor.Category</li>
            @if (!string.IsNullOrWhiteSpace(Descriptor.Vendor))
            {
                <li><span class="font-medium text-text">Vendor:</span> @Descriptor.Vendor</li>
            }
            @if (Descriptor.Components.Count > 0)
            {
                <li><span class="font-medium text-text">Components:</span> @string.Join(", ", Descriptor.Components.Select(c => c.DisplayName))</li>
            }
        </ul>
    </section>

    @{ var refs = Descriptor.SourceReferences().ToList(); }
    @if (refs.Count > 0)
    {
        <section class="rounded-card border border-border bg-background-light p-4 min-w-0">
            <h2 class="text-base font-semibold text-text">Source References</h2>
            <ul class="mt-3 space-y-2 text-sm min-w-0">
                @foreach (var r in refs)
                {
                    <li class="min-w-0"><SourceFileLink Path="@r.Path" Label="@(r.Label ?? r.Path)" Mono="@r.Mono" OnOpen="OnOpen" /></li>
                }
            </ul>
        </section>
    }

    @if (Descriptor.LibraryDocs.Count > 0 || Descriptor.LibrarySources.Count > 0 || Descriptor.HardwareAssets.Count > 0 || !string.IsNullOrWhiteSpace(Descriptor.Vendor))
    {
        <LibraryResources VendorName="@Descriptor.Vendor" VendorUrl="@Descriptor.VendorUrl">
            <Documentation>
                @foreach (var r in Descriptor.LibraryDocs)
                {
                    <li class="min-w-0"><SourceFileLink Path="@r.Path" Label="@(r.Label ?? r.Path)" Mono="@r.Mono" OnOpen="OnOpen" /></li>
                }
            </Documentation>
            <HardwareAssets>
                @foreach (var r in Descriptor.HardwareAssets)
                {
                    <li class="min-w-0"><SourceFileLink Path="@r.Path" Label="@(r.Label ?? r.Path)" Mono="@r.Mono" OnOpen="OnOpen" /></li>
                }
            </HardwareAssets>
            <PlcSource>
                @foreach (var r in Descriptor.LibrarySources)
                {
                    <li class="min-w-0"><SourceFileLink Path="@r.Path" Label="@(r.Label ?? r.Path)" Mono="@r.Mono" OnOpen="OnOpen" /></li>
                }
            </PlcSource>
        </LibraryResources>
    }
</aside>

@code {
    [Parameter] public ShowcasePageDescriptor Descriptor { get; set; } = default!;
    [Parameter] public EventCallback<string> OnOpen { get; set; }
}
