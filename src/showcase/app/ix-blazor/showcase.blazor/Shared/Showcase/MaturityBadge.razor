@*
    MaturityBadge.razor — component maturity from COMPONENTS_MATURITY.md, rendered as Momentum
    token-coloured pills (success / warning / danger).

    Usage: <MaturityBadge ComponentName="Pneumatics" />
*@
@using showcase.Services
@inject ComponentMaturityService MaturityService

<div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="inline-flex items-center gap-1.5 rounded-badge border border-border bg-background px-2 py-0.5">
        <span class="inline-block size-2 rounded-full" style="background-color:@DotColor(_maturity.Implemented)"></span>
        <span class="text-text-light">Implemented</span>
    </span>
    <span class="inline-flex items-center gap-1.5 rounded-badge border border-border bg-background px-2 py-0.5">
        <span class="inline-block size-2 rounded-full" style="background-color:@DotColor(_maturity.Tested)"></span>
        <span class="text-text-light">Tested</span>
    </span>
    <span class="inline-flex items-center gap-1.5 rounded-badge border border-border bg-background px-2 py-0.5">
        <span class="inline-block size-2 rounded-full" style="background-color:@DotColor(_maturity.BattleTested)"></span>
        <span class="text-text-light">Battle Tested</span>
    </span>
</div>

@code {
    [Parameter] public string ComponentName { get; set; } = string.Empty;

    private MaturityInfo _maturity = new("red", "red", "red");

    protected override void OnParametersSet()
    {
        _maturity = MaturityService.GetMaturity(ComponentName);
    }

    private static string DotColor(string level) => level?.ToLowerInvariant() switch
    {
        "green" => "var(--color-success)",
        "yellow" => "var(--color-warning)",
        _ => "var(--color-danger)"
    };
}
