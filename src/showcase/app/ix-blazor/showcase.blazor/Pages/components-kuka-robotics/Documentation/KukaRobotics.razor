													<div class="mt-4 p-4 text-sm text-orange-700 bg-orange-50 rounded border border-orange-200">
														No sequencer step blocks were detected.
													</div>
												}
											</article>
										</div>
									</TabPage>
								</Tab>
							</div>
						</TabPage>
						<TabPage Title="AxoKrc5 — Manual control">
							<div class="mt-4 space-y-4">
								<div class="flex items-center gap-2">
									<span class="text-xs font-medium text-slate-500">Maturity:</span>
