											</div>

											<div>
												<h4 class="text-sm font-semibold text-gray-900 mb-1">Component Run call (ST)</h4>
												<p class="text-xs text-slate-500 mb-2">
													<SourceFileLink Path="@_plcComponent4Path" Label="@_plcComponent4Path" OnOpen="OpenModalAsync" />
													— &lt;Initialization&gt; region
												</p>
												@if (_c4InitSnippet != null && !_c4InitSnippet.IsError)
												{
													<CodeBlock Content="@(_c4InitSnippet.Content ?? string.Empty)" Language="language-iecst" />
												}
												else if (_loadingCode)
												{
													<div class="p-4 text-center text-slate-500">Loading...</div>
												}
