												}
											</div>
										</div>
									</TabPage>

									<TabPage Title="Example sequence">
										<div class="mt-4">
											<AXOpen.Core.AxoTaskCommandView Component="@Entry.Plc.Ctx.siem_identification_documentation.axo_IdentDevice.Sequencer" />
											<AXOpen.Core.AxoSequencerCommandView Component="@Entry.Plc.Ctx.siem_identification_documentation.axo_IdentDevice.Sequencer" />
											<article class="rounded-xl border border-slate-200 bg-white p-4">
												<h4 class="text-lg font-semibold text-slate-900">Sequencer Step Logic</h4>
												<p class="mt-1 text-sm text-slate-600">Each block below is parsed from
													<SourceFileLink Path="@_plcComponent1Path" Label="Axo_IdentDevice_Showcase.st" OnOpen="OpenModalAsync" />.
												</p>
												@if (_c1StepLogicBlocks.Count > 0)
												{
													<div class="mt-4 space-y-3">
														@foreach (var step in _c1StepLogicBlocks)
														{
															_c1StepsBySymbol.TryGetValue(step.StepSymbol, out var liveStep);
															<AxoStepCard Step="step" LiveStep="liveStep" />
														}
													</div>
												}
												else if (_loadingCode)
												{
													<div class="mt-4 p-4 text-sm text-slate-500">Loading step logic...</div>
												}
												else
												{
													<div class="mt-4 p-4 text-sm text-orange-700 bg-orange-50 rounded border border-orange-200">
														No sequencer step blocks were detected.
													</div>
												}
											</article>
										</div>
									</TabPage>
								</Tab>
							</div>
						</TabPage>

