										<div class="mt-4">
											<RenderableContentControl Context="@Entry.Plc.Ctx.siem_identification_documentation.axo_IdentDevice" Presentation="@_selectedPresentation" />
										</div>
									</TabPage>

									<TabPage Title="Code reference">
										<div class="mt-4 space-y-6">
											<div>
												<h4 class="text-sm font-semibold text-gray-900 mb-1">Component declaration (ST)</h4>
												<p class="text-xs text-slate-500 mb-2">
													<SourceFileLink Path="@_plcComponent1Path" Label="@_plcComponent1Path" OnOpen="OpenModalAsync" />
													— &lt;ComponentDeclaration&gt; region
												</p>
												@if (_c1DeclarationSnippet != null && !_c1DeclarationSnippet.IsError)
												{
													<CodeBlock Content="@(_c1DeclarationSnippet.Content ?? string.Empty)" Language="language-iecst" />
												}
												else if (_loadingCode)
												{
													<div class="p-4 text-center text-slate-500">Loading...</div>
												}
												else
												{
													<p class="text-xs text-orange-600">Unable to load snippet</p>
												}
											</div>

											<div>
												<h4 class="text-sm font-semibold text-gray-900 mb-1">Component Run call (ST)</h4>
												<p class="text-xs text-slate-500 mb-2">
													<SourceFileLink Path="@_plcComponent1Path" Label="@_plcComponent1Path" OnOpen="OpenModalAsync" />
													— &lt;Initialization&gt; region
												</p>
												@if (_c1InitSnippet != null && !_c1InitSnippet.IsError)
												{
													<CodeBlock Content="@(_c1InitSnippet.Content ?? string.Empty)" Language="language-iecst" />
												}
												else if (_loadingCode)
												{
													<div class="p-4 text-center text-slate-500">Loading...</div>
												}
												else
												{
													<p class="text-xs text-orange-600">Unable to load snippet</p>
												}
											</div>
										</div>
									</TabPage>

									<TabPage Title="Hardware configuration">
