@page "/"

<PageTitle>AXOpen Showcase</PageTitle>

<h1 class="text-2xl font-bold mb-4">AXOpen Unified Showcase</h1>

<p class="mb-6">
    This application demonstrates all AXOpen libraries running together in a single PLC program and a single Blazor host.
    Use the navigation menu to explore each library section.
</p>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

    <a href="/Core/AxoTask" class="card p-4 hover:shadow-lg">
        <h2 class="font-semibold">Core</h2>
        <p class="text-sm">AxoTask, AxoSequencer, AxoComponent, AxoMessaging, AxoDialogs</p>
    </a>

    <a href="/Data/DataExchange" class="card p-4 hover:shadow-lg">
        <h2 class="font-semibold">Data</h2>
        <p class="text-sm">AxoDataExchange, AxoDataFragments, AxoDataPersistent, AxoDataDistributed</p>
    </a>

    <a href="/Drives/Documentation" class="card p-4 hover:shadow-lg">
        <h2 class="font-semibold">Components — Drives</h2>
        <p class="text-sm">AxoDrive documentation and sandbox</p>
    </a>

    <a href="/Elements/Documentation" class="card p-4 hover:shadow-lg">
        <h2 class="font-semibold">Components — Elements</h2>
        <p class="text-sm">Elements documentation and sandbox</p>
    </a>

    <a href="/Pneumatics/Documentation" class="card p-4 hover:shadow-lg">
        <h2 class="font-semibold">Components — Pneumatics</h2>
        <p class="text-sm">Pneumatic components documentation and sandbox</p>
    </a>

    <a href="/Robotics/Documentation" class="card p-4 hover:shadow-lg">
        <h2 class="font-semibold">Components — Robotics</h2>
        <p class="text-sm">Robotics components documentation and sandbox</p>
    </a>

    <a href="/Inspectors/Documentation" class="card p-4 hover:shadow-lg">
        <h2 class="font-semibold">Inspectors</h2>
        <p class="text-sm">Inspection components documentation</p>
    </a>

    <a href="/Security" class="card p-4 hover:shadow-lg">
        <h2 class="font-semibold">Security</h2>
        <p class="text-sm">User and role management</p>
    </a>

</div>
