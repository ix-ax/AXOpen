@page "/"
@using showcase.Catalog
@using Operon.Icons

<PageTitle>AXOpen Showcase</PageTitle>

<div class="mx-auto max-w-7xl space-y-8 px-4 py-6">

    <header class="relative overflow-hidden rounded-card border border-border p-8"
            style="background-image:linear-gradient(120deg, color-mix(in srgb, var(--color-primary) 16%, var(--color-background)) 0%, var(--color-background) 65%);">
        <div class="flex items-start gap-4">
            <div class="shrink-0 rounded-2xl p-3" style="color:var(--color-primary); background-color:color-mix(in srgb, var(--color-primary) 12%, transparent);">
                <HeroIcon Icon="bolt" Type="IconType.Solid" Class="size-8" />
            </div>
            <div>
                <h1 class="text-3xl font-bold text-text">AXOpen Showcase</h1>
                <p class="mt-2 max-w-2xl text-text-light">
                    Every AXOpen library running together in a single PLC program and a single Blazor host —
                    live, against the connected controller.
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-text-light">
                    <span class="rounded-badge border border-border bg-background px-2 py-0.5">one PLC context</span>
                    <span class="rounded-badge border border-border bg-background px-2 py-0.5">one Blazor host</span>
                    <span class="rounded-badge border border-border bg-background px-2 py-0.5">press <kbd class="font-mono">Ctrl+K</kbd> to search</span>
                </div>
            </div>
        </div>
    </header>

    @foreach (var group in ShowcaseCatalog.All.GroupBy(d => d.Category).OrderBy(g => g.Key))
    {
        <section>
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-text-light">@group.Key</h2>
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var d in group.OrderBy(d => d.NavOrder))
                {
                    var accent = string.IsNullOrWhiteSpace(d.AccentColor) ? "var(--color-primary)" : d.AccentColor;
                    <a href="@d.Route" class="hover-lift block rounded-card border border-border bg-background-light p-4 no-underline"
                       style="border-left:3px solid @accent;">
                        <div class="flex items-center gap-2">
                            <span style="color:@accent;">
                                <HeroIcon Icon="@(string.IsNullOrWhiteSpace(d.BrandIcon) ? d.Icon : d.BrandIcon)" Type="IconType.Solid" Class="size-5" />
                            </span>
                            <h3 class="font-semibold text-text">@d.Title</h3>
                        </div>
                        <p class="mt-1 text-sm text-text-light">@d.Description</p>
                        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-text-light">
                            @if (!string.IsNullOrWhiteSpace(d.Vendor))
                            {
                                <span class="rounded-badge border border-border px-2 py-0.5">@d.Vendor</span>
                            }
                            <span class="rounded-badge border border-border px-2 py-0.5">@d.Components.Count comp.</span>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <section>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-text-light">Explore by area</h2>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var a in _areas)
            {
                <a href="@a.Link" class="hover-lift block rounded-card border border-border bg-background-light p-4 no-underline">
                    <div class="flex items-center gap-2">
                        <span class="text-primary"><HeroIcon Icon="@a.Icon" Type="IconType.Solid" Class="size-5" /></span>
                        <h3 class="font-semibold text-text">@a.Title</h3>
                    </div>
                    <p class="mt-1 text-sm text-text-light">@a.Desc</p>
                </a>
            }
        </div>
    </section>
</div>

@code {
    private record Area(string Title, string Desc, string Link, string Icon);

    private readonly Area[] _areas =
    [
        new("Core", "AxoTask, AxoSequencer, AxoComponent, AxoMessaging, AxoDialogs", "/core/AxoTask", "cube"),
        new("Data", "AxoDataExchange, Fragments, Persistent, Distributed", "/data/DataExchange", "circle-stack"),
        new("Components", "Drives, Elements, Pneumatics, Robotics", "/components-drives/Documentation/DrivesShowcase", "squares-2x2"),
        new("Foundation", "Abstractions, Inspectors, I/O, Probers, Timers, Utils", "/inspectors/Documentation/InspectorsShowcase", "wrench-screwdriver"),
        new("Visual Composer", "Drag-and-drop HMI composition", "/VisualComposer", "eye"),
        new("Security", "Users, roles, and access control", "/Security", "lock-closed"),
    ];
}
