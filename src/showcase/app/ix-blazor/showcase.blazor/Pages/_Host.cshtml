@page "/"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Mvc.TagHelpers
@namespace showcase.blazor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link href="showcase.blazor.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <!-- Momentum CSS (Operon Design System) -->
    <link href="_content/Inxton.Operon/css/momentum.css" rel="stylesheet" />
    <link href="_content/AXSharp.Presentation.Blazor.Controls/css/momentum.css" rel="stylesheet" />
    <link href="_content/AXOpen.Operon.Blazor/css/momentum.css" rel="stylesheet" />

    <!-- Prism.js syntax highlighting (IEC 61131-3 ST, YAML, XML, Markdown + extras) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />

    <!-- Override prose defaults for code blocks in rendered documentation -->
    <style>
        .prose pre { background-color: #1e1e2e; color: #cdd6f4; border-radius: 0.5rem; padding: 1rem; overflow-x: auto; }
        .prose pre code { color: inherit; background: transparent; font-size: 0.8125rem; }
        .prose :not(pre) > code { background-color: #f1f5f9; color: #0f172a; padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875em; }
    </style>

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            
        </environment>        
    </div>
    <script src="_framework/blazor.server.js"></script>
    <!-- Mermaid.js for rendering diagrams in documentation -->
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
    <script>
        mermaid.initialize({ startOnLoad: false, theme: 'default' });
        // Interop: render all mermaid diagram blocks inside a container element.
        // Markdig outputs <pre class="mermaid">...</pre> for ```mermaid blocks.
        window.renderMermaidDiagrams = async function (container) {
            if (!window.mermaid || !container) return;
            var blocks = container.querySelectorAll('pre.mermaid');
            for (var i = 0; i < blocks.length; i++) {
                var pre = blocks[i];
                var source = pre.textContent;
                var id = 'mermaid-' + Date.now() + '-' + i;
                try {
                    var result = await mermaid.render(id, source);
                    var div = document.createElement('div');
                    div.className = 'mermaid-diagram my-4';
                    div.innerHTML = result.svg;
                    pre.parentElement.replaceChild(div, pre);
                } catch (e) {
                    console.warn('Mermaid render error:', e);
                }
            }
        };
    </script>
    <!-- Prism core + grammars loaded manually so we control when highlighting runs -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
    <script>
        // Tell autoloader where to find grammar files
        if (window.Prism && Prism.plugins && Prism.plugins.autoloader) {
            Prism.plugins.autoloader.languages_path =
                'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/';
        }
        // Interop: highlight all <code> elements that carry a language-* class
        window.prismHighlightAll = function () {
            if (window.Prism) { Prism.highlightAll(); }
        };
        // Interop: copy text to clipboard, returns true on success
        window.copyToClipboard = function (text) {
            if (!navigator.clipboard) return Promise.resolve(false);
            return navigator.clipboard.writeText(text).then(() => true, () => false);
        };

        // Interop: register global keyboard shortcut for search dialog
        window.registerSearchShortcut = function (dotNetRef) {
            document.addEventListener('keydown', function (e) {
                var tag = e.target.tagName;
                var isInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || e.target.isContentEditable;
                if ((e.ctrlKey && e.key === 'k') || (e.key === '/' && !isInput)) {
                    e.preventDefault();
                    dotNetRef.invokeMethodAsync('OpenSearch');
                }
            });
        };

        // Interop: focus an element reference
        window.focusElement = function (element) {
            if (element) { element.focus(); }
        };
    </script>
</body>
</html>
