@page "/components-zebra-vision/Documentation/ZebraVision"
@using AXOpen.Core;
@using Operon.Components.Tab
@using showcase.Services;
@inherits RenderableComponentBase

<PageTitle>Zebra Vision - Documentation</PageTitle>

<SourceViewerModal @ref="_modal" />

