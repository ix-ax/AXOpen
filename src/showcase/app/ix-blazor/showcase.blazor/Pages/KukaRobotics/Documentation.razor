									<TabPage Title="Example sequence">
										<div class="mt-4">
											<AXOpen.Core.AxoTaskCommandView Component="@Entry.Plc.Ctx.kuka_robotics_documentation.componentTwo.Sequencer" />
											<AXOpen.Core.AxoSequencerCommandView Component="@Entry.Plc.Ctx.kuka_robotics_documentation.componentTwo.Sequencer" />
											<article class="rounded-xl border border-slate-200 bg-white p-4">
												<h4 class="text-lg font-semibold text-slate-900">Sequencer Step Logic</h4>
												<p class="mt-1 text-sm text-slate-600">Each block below is parsed from
