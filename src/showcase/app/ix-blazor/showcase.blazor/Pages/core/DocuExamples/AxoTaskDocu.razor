@page "/CoreDocSnippets/AxoTaskDocu"
@using AXOpen.Core;
<h3>AxoTaskDocu</h3>

<div class="max-w-4xl mx-auto">
    <div class="card">
        <div class="flex items-center px-4 py-3 border-b border-primary">
            <div class="text-primary font-semibold">Task example.</div>
        </div>
        <div class="card-body">
            <div class="text-left">
                <div class="flex flex-col gap-4">
                    <div class="flex-1">
                        <div class="card p-2">
                            <label>Displayed using AxoTaskView. Controlable as the value of Disable is FALSE"</label>
                            //<AxoTaskViewControlable>
                            <AxoTaskView Component="@Entry.Plc.Ctx.AxoTaskDocu._myTask" Disable="false" />
                            //</AxoTaskViewControlable>
                        </div>
                        <div class="card p-2">
                            <label>Displayed using AxoTaskView. Viewable only as the value of Disable is TRUE"</label>
                            //<AxoTaskViewDisplayOnly>
                            <AxoTaskView Component="@Entry.Plc.Ctx.AxoTaskDocu._myTask" Disable="true" />
                            //</AxoTaskViewDisplayOnly>
                        </div>
                        <div class="card p-2">
                            <label>Rendered by using RenderableContentControl. Controllable as the Presentation is Command</label>
                            //<RenderableContentControlCommand>
                            <RenderableContentControl Context="@Entry.Plc.Ctx.AxoTaskDocu._myTask" Presentation="Command" />
                            //</RenderableContentControlCommand>
                        </div>
                        <div class="card p-2">
                            <label>Rendered by using RenderableContentControl. Viewable only as the Presentation is Status</label>
                            //<RenderableContentControlStatus>
                            <RenderableContentControl Context="@Entry.Plc.Ctx.AxoTaskDocu._myTask" Presentation="Status"/>
                            //</RenderableContentControlStatus>
                        </div>
                   </div>
                </div>
            </div>
        </div>
     </div>
</div>

