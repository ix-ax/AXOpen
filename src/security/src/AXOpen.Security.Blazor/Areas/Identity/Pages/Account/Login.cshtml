@page
@using AXOpen.Security.Blazor.Resources;
@using Microsoft.Extensions.Localization;
@model LoginModel
@inject IStringLocalizer<BlazorResources> Localizer

@{
    ViewData["Title"] = "Log in";
}

<div class="flex justify-center">
    <div class="w-md">
        <h4>Log in</h4>
        <hr class="mb-2" />
        <form id="account" method="post">
            <div asp-validation-summary="All"></div>
            <div class="input-group">
                <label asp-for="Input.Username">@Localizer["Username"]</label>
                <input asp-for="Input.Username" />
                <span asp-validation-for="Input.Username"></span>
            </div>
            <div class="input-group">
                <label asp-for="Input.Password">@Localizer["Password"]</label>
                <input asp-for="Input.Password" />
                <span asp-validation-for="Input.Password"></span>
            </div>
            <button type="submit" class="btn btn-primary mt-2 w-full">@Localizer["Log in"]</button>
        </form>
    </div>
</div>