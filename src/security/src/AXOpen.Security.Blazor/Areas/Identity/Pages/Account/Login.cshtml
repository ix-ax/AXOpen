@page
@using AXOpen.Security.Blazor.Resources;
@using Microsoft.Extensions.Localization;
@model LoginModel
@inject IStringLocalizer<BlazorResources> Localizer

@{
    ViewData["Title"] = "Log in";
}

<div class="flex justify-center">
    <div class="w-xl mt-16">
        <h2>Log in</h2>
        <hr />
        <div>
            <form id="account" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="input-group">
                    <label asp-for="Input.Username" class="me-2">@Localizer["Username"]</label>
                    <input asp-for="Input.Username" />
                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                </div>
                <div class="input-group">
                    <label asp-for="Input.Password" class="me-2">@Localizer["Password"]</label>
                    <input asp-for="Input.Password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-full mt-2">@Localizer["Log in"]</button>
            </form>
        </div>
    </div>
</div>