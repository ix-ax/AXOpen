@using Microsoft.AspNetCore.Components.Authorization;
@using Operon.Components.Tab

@namespace AxOpen.Security.Views

<AuthorizeView Roles="Administrator">
    <Authorized>
        <Tab>
            <TabPage Title="@Localizer["User Management"]">
                <UserManagementView @ref="@userManagementView"></UserManagementView>
            </TabPage>
            <TabPage Title="@Localizer["Group Management"]">
                <GroupManagementView @ref="@groupManagementView"></GroupManagementView>
            </TabPage>
        </Tab>
    </Authorized>
    <NotAuthorized>
        <p>@Localizer["Sorry, you are not authorized to access user management. Please log in as administrator."]</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserManagementView userManagementView { get; set; }
    private GroupManagementView groupManagementView { get; set; }
}