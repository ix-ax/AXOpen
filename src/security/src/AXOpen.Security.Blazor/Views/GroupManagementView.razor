@namespace AxOpen.Security.Views
@using Operon.Components
@inherits BaseSecurityView

<div class="overflow-x-auto">
    <table class="table table-striped w-full">
        <thead>
            <tr>
                <th>@Localizer["Group name"]</th>
                <th>@Localizer["Created"]</th>
                <th>@Localizer["Modified"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in _roleGroupManager.GetAllGroup())
            {
                <tr @onclick="@(() => GroupClicked(group))" class="@((SelectedGroupN != null) ? ((SelectedGroupN.Name == group.Name) ? "active" : "") : "")">
                    <th>@group.Name</th>
                    <th>@group.Created</th>
                    <th>@group.Modified</th>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card mt-4">
    <h5>@Localizer["Create new group"]:</h5>
    <div class="flex">
        <div class="input">
            <label class="me-2">@Localizer["Group name"]</label>
            <input @bind="newGroupName" type="text" placeholder=@Localizer["Group name"] />
        </div>
        <button class="btn btn-primary" @onclick="@(() => CreateGroup())">@Localizer["Create"]</button>
    </div>
</div>

@if (SelectedGroupN != null)
{
    <div class="mt-8 mx-4">
        <h4 class="me-auto">@Localizer["Selected group:"] @SelectedGroupN.Name</h4>
        <div class="">
            <div class="flex justify-center flex-wrap">
                <div class="w-auto me-4">
                    <div class="min-vh-40">
                        <h5>@Localizer["Available roles:"]</h5>
                        <div class="input-checkbox my-2">
                            <label for="checkbox">
                                <input type="checkbox" class="peer" id="selectAllAvailableCheckbox" @bind="SelectAllAvailable" />
                                <span>
                                    <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                                </span>
                            </label>
                            <label for="selectAllAvailableCheckbox">@Localizer["Select all"]</label>
                        </div>

                        <div class="">
                            @if (AvailableRoles != null)
                            {
                                <div class="p-2">
                                    @foreach (var role in AvailableRoles)
                                    {
                                        <div class="input-checkbox">
                                            <label for="@role.Role.Name">
                                                <input type="checkbox" class="peer" id="@role.Role.Name" @bind="role.IsSelected" />
                                                <span>
                                                    <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                                                </span>
                                            </label>
                                            <label for="@role.Role.Name">@role.Role.Name</label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="w-auto flex flex-col">
                    <button class="btn btn-primary m-1" @onclick="@(() => AssignRoles())">
                        <Operon.Icons.HeroIcon Icon="arrow-right" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                    </button>
                    <button class="btn btn-primary m-1" @onclick="@(() => ReturnRoles())">
                        <Operon.Icons.HeroIcon Icon="arrow-left" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                    </button>
                </div>
                <div class="w-auto ms-4">
                    <div class="min-vh-40">
                        <h5>@Localizer["Assigned roles:"]</h5>
                        <div class="input-checkbox my-2">
                            <label for="checkbox">
                                <input type="checkbox" class="peer" id="selectAllAssignedCheckbox" @bind="SelectAllAssigned" />
                                <span>
                                    <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                                </span>
                            </label>
                            <label for="selectAllAssignedCheckbox">@Localizer["Select all"]</label>
                        </div>

                        <div class="">
                            @if (AssignedRoles != null)
                            {
                                <div class="p-2">
                                    @foreach (var role in AssignedRoles)
                                    {
                                        <div class="input-checkbox">
                                            <label for="@role.Role.Name">
                                                <input type="checkbox" class="peer" id="@role.Role.Name" @bind="role.IsSelected" />
                                                <span>
                                                    <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                                                </span>
                                            </label>
                                            <label for="@role.Role.Name">@role.Role.Name</label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-danger m-2" @onclick="() => _deleteModalOpen = !_deleteModalOpen">@Localizer["Delete"]</button>
        </div>
    </div>

    <Modal @bind-Value="_deleteModalOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Localizer["Delete group"]</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _deleteModalOpen = false">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            <h6>@Localizer["Do you want to delete group"] @SelectedGroupN.Name?</h6>
            <div class="ms-auto">
                <button type="button" class="btn btn-secondary m-2" @onclick="() => _deleteModalOpen = false">@Localizer["Close"]</button>
                <button type="button" class="btn btn-danger m-2" data-bs-dismiss="modal" @onclick="@(() => { _deleteModalOpen = false; DeleteGroup(SelectedGroupN); })">@Localizer["Delete"]</button>
            </div>
        </div>
    </Modal>
}

@code {
    private bool _deleteModalOpen = false;
}