@namespace AxOpen.Security.Views
@using Operon.Components
@inherits BaseSecurityView

<div class="overflow-x-auto">
    <table class="table table-hover table-striped w-full">
        <thead>
            <tr>
                <th>@Localizer["Group name"]</th>
                <th>@Localizer["Created"]</th>
                <th>@Localizer["Modified"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in _roleGroupManager.GetAllGroup())
            {
                <tr @onclick="@(() => GroupClicked(group))" class="@((SelectedGroupN != null) ? ((SelectedGroupN.Name == group.Name) ? "active" : "") : "")">
                    <th>@group.Name</th>
                    <th>@group.Created</th>
                    <th>@group.Modified</th>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card mt-4">
    <h5>@Localizer["Create new group"]:</h5>
    <div class="flex flex-wrap">
        <BaseInput @bind-Value="newGroupName" Label="@Localizer["Group name"]" Placeholder="@Localizer["Group name"]" />
        <button class="btn btn-primary" @onclick="@(() => CreateGroup())">@Localizer["Create"]</button>
    </div>
</div>

@if (SelectedGroupN != null)
{
    <div class="mt-8 mx-4">
        <h4 class="me-auto">@Localizer["Selected group:"] @SelectedGroupN.Name</h4>
        <div class="">
            <div class="flex flex-wrap justify-center">
                <div class="w-auto me-4">
                    <div class="min-vh-40">
                        <h5>@Localizer["Available roles:"]</h5>
                        <BaseInput @bind-Value="SelectAllAvailable" Label="@Localizer["Select all"]" />

                        <div class="">
                            @if (AvailableRoles != null)
                            {
                                <div class="p-2">
                                    @foreach (var role in AvailableRoles)
                                    {
                                        <BaseInput @bind-Value="role.IsSelected" Label="@role.Role.Name" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="w-auto flex flex-col">
                    <button class="btn btn-primary m-1" @onclick="@(() => AssignRoles())">
                        <Operon.Icons.HeroIcon Icon="arrow-right" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                    </button>
                    <button class="btn btn-primary m-1" @onclick="@(() => ReturnRoles())">
                        <Operon.Icons.HeroIcon Icon="arrow-left" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                    </button>
                </div>
                <div class="w-auto ms-4">
                    <div class="min-vh-40">
                        <h5>@Localizer["Assigned roles:"]</h5>
                        <BaseInput @bind-Value="SelectAllAssigned" Label="@Localizer["Select all"]" />

                        <div class="">
                            @if (AssignedRoles != null)
                            {
                                <div class="p-2">
                                    @foreach (var role in AssignedRoles)
                                    {
                                        <BaseInput @bind-Value="role.IsSelected" Label="@role.Role.Name" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-danger m-2" @onclick="() => _modalDelete.Toggle()">@Localizer["Delete"]</button>
        </div>
    </div>

    <Modal @ref="_modalDelete">
        <div class="modal-header">
            <h2 class="text-xl font-bold">@Localizer["Delete group"]</h2>
            <button type="button" class="cursor-pointer ms-auto my-auto" @onclick="() => _modalDelete.CloseModal()">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-body">
            <h6>@Localizer["Do you want to delete group"] @SelectedGroupN.Name?</h6>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" @onclick="() => _modalDelete.CloseModal()">@Localizer["Close"]</button>
            <button type="button" class="btn btn-danger m-2" @onclick="@(() => { _modalDelete.CloseModal(); DeleteGroup(SelectedGroupN); })">@Localizer["Delete"]</button>
        </div>
    </Modal>
}

@code {
    private Modal _modalDelete { get; set; }
}