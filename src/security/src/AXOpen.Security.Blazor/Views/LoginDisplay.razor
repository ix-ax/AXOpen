@using Microsoft.AspNetCore.Mvc
@using AxOpen.Security.Entities
@attribute [IgnoreAntiforgeryToken]
@namespace AxOpen.Security.Views

<AuthorizeView>
    <Authorized>
        <div class="dropdown">
            <button class="btn btn-primary" @onclick="() => _dropdownCollapsed = !_dropdownCollapsed">
                @context.User.Identity.Name
                <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 collapse-button-icon " + (_dropdownCollapsed ? "open" : null))" />
            </button>
            @if (!_dropdownCollapsed)
            {
                <div class="dropdown-body card">
                    <a class="block px-2 py-2 text-sm text-gray-700" href="Identity/Account/Manage">@Localizer["Profile"]</a>
                    <form asp-area="Identity" action="Identity/Account/Logout" asp-route-returnUrl="/" method="post">
                        <AntiforgeryToken />
                        <button class="block px-2 py-2 text-sm text-gray-700 hover:font-normal cursor-pointer" type="submit">@Localizer["Log out"]</button>
                    </form>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-primary" href="Identity/Account/Login" role="button">@Localizer["Log in"]</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _dropdownCollapsed = true;
}