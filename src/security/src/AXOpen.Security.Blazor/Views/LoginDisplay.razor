@using AXOpen.Security.Services
@using Microsoft.AspNetCore.Mvc
@using AxOpen.Security.Entities
@using Operon.Components.Dropdown
@attribute [IgnoreAntiforgeryToken]
@namespace AxOpen.Security.Views
@inject IServiceProvider _serviceProvider

<div class="flex flex-wrap">
    <AuthorizeView>
        <Authorized>
            <Dropdown @ref="_dropdownLogin">
                <DropdownButton>
                    <button type="button" class="btn btn-primary" @onclick="_dropdownLogin.Toggle">
                        @context.User.Identity.Name
                        <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 icon-button-rotate " + (_dropdownLogin?.Open ?? false ? "rotated" : null))" />
                    </button>
                </DropdownButton>
                <DropdownBody>
                    <a class="dropdown-item" href="Identity/Account/Manage">@Localizer["Profile"]</a>
                    <form asp-area="Identity" action="Identity/Account/Logout" asp-route-returnUrl="/" method="post">
                        <AntiforgeryToken />
                        <button class="dropdown-item cursor-pointer" type="submit">@Localizer["Log out"]</button>
                    </form>
                </DropdownBody>
            </Dropdown>
        </Authorized>
        <NotAuthorized>
            <a class="btn btn-primary" href="Identity/Account/Login" role="button">@Localizer["Log in"]</a>
        </NotAuthorized>
    </AuthorizeView>

    @if (_serialService != null && !_serialService.PortOpen && _showConnectButton)
    {
        <button class="btn btn-primary" @onclick="ConnectAsync">Connect to Serial Port</button>
    }
</div>

@code {
    private Dropdown _dropdownLogin { get; set; }

    private bool _showConnectButton { get; set; } = false;

    private ISerialService? _serialService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _serialService = (ISerialService?)_serviceProvider.GetService(typeof(ISerialService));
        if (_serialService != null)
        {
            _serialService.AfterOpenPort += StateHasChanged;
            await ChangeAfterDelayAsync();
        }
    }

    private async Task ChangeAfterDelayAsync()
    {
        await Task.Delay(2000);
        _showConnectButton = true;
        StateHasChanged();
    }

    private async Task ConnectAsync()
    {
        try
        {
            bool portSelected = await _serialService.OpenPortAsync(9600);
            if (portSelected)
            {
                Console.WriteLine("Connected to serial port.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }
}