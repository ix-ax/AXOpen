@page "/Identity/Account/Manage"
@using AXOpen.Security.Services
@using AxOpen.Security.Entities;
@using AxOpen.Security.Models;
@using AxOpen.Security.Services;
@using Microsoft.AspNetCore.Components.Forms;
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.AspNetCore.Identity;
@using Operon.Components.Toast
@using System.Text
@namespace AxOpen.Security.Views
@inject UserManager<User> _userManager
@inject SignInManager<User> _signInManager
@inject IRepositoryService _repositoryService
@inject IToastService _toastService
@inject AuthenticationStateProvider _authenticationStateProvider
@inject IServiceProvider _serviceProvider
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <div class="flex justify-center">
            <div class="w-md">
                <h2>@Localizer["Account Manage"]</h2>
                <hr class="mb-2" />
                <EditForm Model="@_model" OnValidSubmit="OnValidUpdate" Context="accountManagementContext">
                    <DataAnnotationsValidator />
                    <div class="input-group">
                        <label>@Localizer["Username"]</label>
                        <InputText @bind-Value="_model.Username" type="text" disabled />
                    </div>
                    <div class="input-group">
                        <label>@Localizer["Group"]</label>
                        <InputText @bind-Value="_model.Group" type="text" disabled />
                    </div>
                    <div class="input-group">
                        <label>Email</label>
                        <InputText @bind-Value="_model.Email" type="email" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>
                    @if (!string.IsNullOrEmpty(_model.ExternalAuthId))
                    {
                        <p>@Localizer["External Auth is set"]</p>
                        <button class="btn btn-secondary" @onclick="ClearExternalAuthId">@Localizer["Remove External Auth"]</button>
                    }
                    @if (_model.CanUserChangePassword)
                    {
                        <div class="input-group">
                            <label>@Localizer["Old password"]</label>
                            <InputText @bind-Value="_model.OldPassword" type="password" />
                            <ValidationMessage For="@(() => _model.OldPassword)" />
                        </div>
                        <div class="input-group">
                            <label>@Localizer["New password"]</label>
                            <InputText @bind-Value="_model.Password" type="password" />
                            <ValidationMessage For="@(() => _model.Password)" />
                        </div>
                        <div class="input-group">
                            <label>@Localizer["Confirm new password"]</label>
                            <InputText @bind-Value="_model.ConfirmPassword" type="password" />
                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </div>
                    }

                    <button type="submit" class="btn btn-primary mt-2 w-full">@Localizer["Update"]</button>
                </EditForm>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>@Localizer["Sorry, you are not logged in. Please log in."]</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ManageUserModel _model { get; set; }

    private ISerialService? _serialService { get; set; }

    private async void OnValidUpdate()
    {
        User _user = await _userManager.FindByNameAsync(_model.Username);

        if (_model.CanUserChangePassword && _model.OldPassword != null && _model.OldPassword != "" && _model.Password != null && _model.Password != "" && _model.ConfirmPassword != null && _model.ConfirmPassword == _model.Password)
        {
            await _userManager.ChangePasswordAsync(_user, _model.OldPassword, _model.Password);
        }
        _user.Email = _model.Email;
        _user.Modified = DateTime.Now;

        if (_user.ExternalAuthId != _model.ExternalAuthId)
        {
            if (!string.IsNullOrEmpty(_model.ExternalAuthId))
            {
                List<User> users = _repositoryService.UserRepository.GetRecords().Where(user => user.ExternalAuthId != null && user.ExternalAuthId.Equals(_model.ExternalAuthId)).ToList();
                if (users.Any())
                {
                    _toastService?.AddToast(eToastType.Danger, Localizer["Not updated!"], "User was not updated, because externalId has using diferent user!", 10);
                    return;
                }

                string externalAuthIdHashed = _model.ExternalAuthId;
                _user.ExternalAuthId = externalAuthIdHashed;
            }
            else
            {
                _user.ExternalAuthId = null;
            }
        }

        var result = await _userManager.UpdateAsync(_user);
        if (result.Succeeded)
        {
            _signInManager.RefreshSignInAsync(_user);
            _toastService.AddToast(eToastType.Success, Localizer["Updated!"], Localizer["User succesfully updated."], 10);
            //TcoAppDomain.Current.Logger.Information($"User '{_user.UserName}' has changed.{{payload}}", new { UserName = _user.UserName, Email = _user.Email, CanChangePassword = _user.CanUserChangePassword, Group = string.Join(",", _user.Roles) });
        }
        else
        {
            _toastService.AddToast(eToastType.Success, Localizer["Not updated!"], Localizer["User was not updated."], 10);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _serialService = (ISerialService?)_serviceProvider.GetService(typeof(ISerialService));

        _model = new ManageUserModel();

        User _user = await _userManager.FindByNameAsync(_authenticationStateProvider.GetAuthenticationStateAsync().Result.User.Identity.Name);

        _model.Username = _user.UserName;
        _model.Group = _user.Group;
        _model.Email = _user.Email;
        _model.CanUserChangePassword = _user.CanUserChangePassword;
        _model.ExternalAuthId = _user.ExternalAuthId;

        if (_serialService != null)
        {
            _serialService.SerialError += OnSerialError;
            _serialService.DataReceived += OnSerialDataReceived;
        }
    }

    public void Dispose()
    {
        if (_serialService != null)
        {
            _serialService.DataReceived -= OnSerialDataReceived;
            _serialService.SerialError -= OnSerialError;
        }
    }

    private void OnSerialError()
    {
        _serialService.DataReceived -= OnSerialDataReceived;
        Console.WriteLine("Serial port error");
    }

    private void OnSerialDataReceived(byte[] data)
    {
        if (_model != null)
            _model.ExternalAuthId = Encoding.ASCII.GetString(System.Security.Cryptography.SHA512.HashData(Encoding.ASCII.GetBytes(Encoding.ASCII.GetString(data).Trim())));

        _toastService?.AddToast(eToastType.Success, Localizer["Updated!"], "The external token has been updated", 10);
        StateHasChanged();
    }

    private void ClearExternalAuthId()
    {
        _model.ExternalAuthId = null;
    }

    private string changeAuthorizationTokenTitle = "Are you sure you want to change your authorization token?";
    private string changeAuthorizationTokenButton = "Change your authorization token";
}
