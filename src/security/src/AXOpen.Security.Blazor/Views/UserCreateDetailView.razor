@page "/Identity/Account/Register/{ReturnUrl?}"

@namespace AxOpen.Security.Views
@using Microsoft.AspNetCore.Components.Authorization;

@inherits BaseSecurityView

<AuthorizeView Roles="Administrator">
    <Authorized Context="Auth">
        <div class="mt-2 mx-4">
            <h4>@Localizer["Create new user"]</h4>
            <hr />
            <div>
                <EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
                    <DataAnnotationsValidator />
                    <div class="input">
                        <label class="me-2">@Localizer["Username"]</label>
                        <InputText @bind-Value="_model.Username" />
                        <ValidationMessage For="@(() => _model.Username)" />
                    </div>
                    <div class="input">
                        <label class="me-2">@Localizer["Password"]</label>
                        <InputText @bind-Value="_model.Password" type="password" />
                        <ValidationMessage For="@(() => _model.Password)" />
                    </div>
                    <div class="input">
                        <label class="me-2">@Localizer["Confirm password"]</label>
                        <InputText @bind-Value="_model.ConfirmPassword" type="password" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                    </div>

                    <div class="input-checkbox">
                        <label for="checkBoxCanUserChangePassword">
                            <InputCheckbox @bind-Value="_model.CanUserChangePassword" class="peer" type="checkbox" id="checkBoxCanUserChangePassword" />
                            <span>
                                <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                            </span>
                        </label>
                        <label for="checkBoxCanUserChangePassword">@Localizer["Can change password"]</label>
                        <ValidationMessage For="@(() => _model.CanUserChangePassword)" />
                    </div>

                    <div class="input">
                        <label class="me-2">Email</label>
                        <InputText @bind-Value="_model.Email" type="email" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="input-checkbox">
                        <label for="checkBoxEnableAutoLogOut">
                            <InputCheckbox @bind-Value="_model.EnableAutoLogOut" class="peer" type="checkbox" id="checkBoxEnableAutoLogOut" />
                            <span>
                                <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                            </span>
                        </label>
                        <label for="checkBoxEnableAutoLogOut">@Localizer["Automatic Log Out"]</label>
                        <ValidationMessage For="@(() => _model.EnableAutoLogOut)" />
                    </div>

                    <!-- Timeout (Hidden if EnableAutoLogOut is false) -->
                    @if (_model.EnableAutoLogOut)
                    {
                        <div class="input">
                            <label class="me-2">[@Localizer["Minutes"]]</label>
                            <input type="number" @bind="_model.AutoLogOutTimeOutMinutes" id="checkAutoLogOutTimeOutMinutes" />
                            <ValidationMessage For="@(() => _model.AutoLogOutTimeOutMinutes)" />
                        </div>
                    }

                    <div class="mt-3">
                        <label class="me-2">@Localizer["Group"]</label>
                        <select class="select min-w-6" @bind="@_model.Group">
                            <option selected disabled>@Localizer["Choose group"]</option>
                            @foreach (var group in _repositoryService.RoleGroupManager.GetAllGroup())
                            {
                                <option value="@group.Name">@group.Name</option>
                            }
                        </select>
                        <ValidationMessage For="@(() => _model.Group)" />
                    </div>

                    <button type="submit" class="btn btn-primary">@Localizer["Create"]</button>
                </EditForm>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>@Localizer["Sorry, you are not authorized to create new users. Please log in as administrator."]</p>
    </NotAuthorized>
</AuthorizeView>
