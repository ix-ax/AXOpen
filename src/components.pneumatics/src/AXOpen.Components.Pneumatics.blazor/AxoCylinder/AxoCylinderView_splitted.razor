@namespace AXOpen.Components.Pneumatics
@using AXOpen.Core.Blazor
@inherits RenderableComplexComponentBase<AXOpen.Components.Pneumatics.AxoCylinder>

<CascadingValue Value="@Component" Name="ParentComponent">
    <CascadingValue Value="@Model" Name="ParentModel">        
        <AxoComponentHeaderBase>
            <ChildContent>
                   <div class="flex items-center gap-2" @onclick:stopPropagation="true">
                        @if (IsInInnerPosition)
                        {
                            <span class="badge badge-success">@Component.InLabel</span>
                        }
                        else if (IsInOuterPosition)
                        {
                            <span class="badge badge-info">@Component.OutLabel</span>
                        }
                        else if (IsMoving)
                        {
                            <span class="badge badge-warning">Moving</span>
                        }
                        else
                        {
                            <span class="badge badge-primary">---</span>
                        }
                    </div>
            </ChildContent>
        </AxoComponentHeaderBase>  
        <AxoComponentAlarmsBase>
            <ChildContent>
                <!-- Alarms will be rendered here -->
            </ChildContent>
        </AxoComponentAlarmsBase>
        <AxoComponentCommandBase>
            <ChildContentCommands>                                    
                 <AxoTaskCommandView class="flex-[2]" Text="@Component.InLabel" Component="Component._MoveInTask" HideRestoreButton="false"></AxoTaskCommandView>
                 <AxoTaskCommandView class="flex-1" Text="STOP" Component="Component._StopTask" HideRestoreButton="false"></AxoTaskCommandView>
                 <AxoTaskCommandView class="flex-[2]" Text="@Component.OutLabel" Component="Component._MoveOutTask" HideRestoreButton="false"></AxoTaskCommandView>
            </ChildContentCommands>

            <ChildContentStatus>
                <AxoTaskStatusView class="flex-[2]" Text="@Component.InLabel" Component="Component._MoveInTask" HideRestoreButton="false"></AxoTaskStatusView>
                <AxoTaskStatusView class="flex-1" Text="STOP" Component="Component._StopTask" HideRestoreButton="false"></AxoTaskStatusView>
                <AxoTaskStatusView class="flex-[2]" Text="@Component.OutLabel" Component="Component._MoveOutTask" HideRestoreButton="false"></AxoTaskStatusView>
            </ChildContentStatus>
        </AxoComponentCommandBase>
        <AxoComponentStateBase>
            <ChildContent>
                <div data-axo-cylinder-view class="flex flex-col gap-2 p-0 @Model.AlarmBackgroundClass rounded-lg @Model.AlarmBorderClass">
                    <div class="self-center">
                        <button>
                            <div class="flex flex-col gap-4 p-4 rounded-lg w-full">
                                <!-- Cylinder Visual -->
                                <div class="flex items-center gap-4 w-full">
                                    <!-- Inner Position with Label on Left -->
                                    <div class="flex items-center gap-2 flex-shrink-0">
                                        <span class="text-xs font-medium text-text/70">@Component.InLabel</span>
                                        <div class="sensor-indicator @(IsInInnerPosition ? "active bg-success text-success" : "bg-border/30 text-border")"></div>
                                    </div>

                                    <!-- Pneumatic Cylinder Assembly -->
                                    <div class="pneumatic-cylinder @(IsMoving ? "cylinder-moving" : "") flex-1">
                                        <!-- Movement Direction Indicator -->
                                        @if (Component.MoveInSignal.Cyclic)
                                        {
                                            <div class="direction-indicator text-warning">◄</div>
                                        }
                                        @if (Component.MoveOutSignal.Cyclic)
                                        {
                                            <div class="direction-indicator text-warning">►</div>
                                        }

                                        <!-- Left End Cap -->
                                        <div class="cylinder-cap rounded-l-md flex-shrink-0" style="width: 0.75rem; height: 3rem;"></div>

                                        <!-- Cylinder Barrel -->
                                        <div class="cylinder-barrel flex-1" style="min-width: 8rem; height: 2.5rem; position: relative;">
                                            <!-- Piston Rod -->
                                            <div class="piston-rod" style="height: 0.5rem; width: @(IsInOuterPosition ? "100%" : IsInInnerPosition ? "10%" : "50%");"></div>

                                            <!-- Piston -->
                                            <div class="piston" style="width: 2rem; height: 2rem; left: @(IsInOuterPosition ? "calc(100% - 2rem)" : IsInInnerPosition ? "0" : "calc(50% - 1rem)");">
                                            </div>
                                        </div>

                                        <!-- Right End Cap -->
                                        <div class="cylinder-cap rounded-r-md flex-shrink-0" style="width: 0.75rem; height: 3rem;"></div>
                                    </div>

                                    <!-- Outer Position with Label on Right -->
                                    <div class="flex items-center gap-2 flex-shrink-0">
                                        <div class="sensor-indicator @(IsInOuterPosition ? "active bg-info text-info" : "bg-border/30 text-border")"></div>
                                        <span class="text-xs font-medium text-text/70">@Component.OutLabel</span>
                                    </div>
                                </div>
                            </div>
                        </button>
                    </div>
                </div>
            </ChildContent>
        </AxoComponentStateBase>
    </CascadingValue>
</CascadingValue>

@code
{
    private AxoComponentViewModel? Model;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Model = new AxoComponentViewModel(Component, this);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // Recreate model if Component changes
        if (Model?.Component != Component)
        {
            Model = new AxoComponentViewModel(Component, this);
        }
    }

    protected bool IsInInnerPosition => Component.InSensor.Cyclic && !Component.OutSensor.Cyclic;
    protected bool IsInOuterPosition => Component.OutSensor.Cyclic && !Component.InSensor.Cyclic;
    protected bool IsMoving => Component.MoveInSignal.Cyclic || Component.MoveOutSignal.Cyclic;

    public override async void ConfigurePolling()
    {
        // Poll sensor states
        this.StartPolling(Component.InSensor);
        this.StartPolling(Component.OutSensor);

        // Poll signal states
        this.StartPolling(Component.MoveInSignal);
        this.StartPolling(Component.MoveOutSignal);

        // Poll task statuses
        this.StartPolling(Component._MoveOutTask.Status);
        this.StartPolling(Component._MoveInTask.Status);
        this.StartPolling(Component._StopTask.Status);        
        this.StartPolling(Component._isManuallyControllable, 500);              

        Model.MessageProvider?.InitializeUpdate(this.StartPolling);
    }

}