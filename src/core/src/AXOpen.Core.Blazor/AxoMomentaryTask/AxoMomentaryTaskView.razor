@namespace AXOpen.Core
@using AXSharp.Connector;
@inherits RenderableComplexComponentBase<AxoMomentaryTask>
@implements IDisposable;

<div class="flex flex-wrap">
    <button type="button" class="btn btn-primary" disabled="@IsDisabled" @onmousedown="@SwitchOnTask" @onmouseup="@SwitchOffTask" @onfocusout="@SwitchOffTask">
       @Description: @StateDescription
    </button>
</div>