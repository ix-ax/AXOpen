@namespace AXOpen.Core
@using AXSharp.Connector;
@inherits RenderableComplexComponentBase<AxoMomentaryTask>
@implements IDisposable;

<div data-axo-momentary-task-view class="flex flex-wrap">
    <button type="button" class="btn @ButtonClass uppercase line-clamp-2 text-balance wrap-anywhere leading-tight text-center" disabled="@IsDisabled" @onmousedown="@SwitchOnTask" @onmouseup="@SwitchOffTask" @onfocusout="@SwitchOffTask">
       @Description: @StateDescription
    </button>
</div>