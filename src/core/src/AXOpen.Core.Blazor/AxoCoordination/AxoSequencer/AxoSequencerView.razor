@using Operon.Components.Accordion
@inherits RenderableComplexComponentBase<AxoSequencer>
@namespace AXOpen.Core

<div class="flux-sequencer @SequencerStateClass @(!this.IsControllable ? "flux-sequencer--disabled" : "")">
    
    <!-- Sequencer Header -->
    <div class="flux-sequencer__header">
        <div class="flux-sequencer__title-group">
            <h5 class="flux-sequencer__title">@Component.AttributeName</h5>
            @if (CurrentStatus != eSequenceStatus.Inactive)
            {
                <span class="flux-badge @StatusBadgeClass">
                    @StatusText
                </span>
            }
        </div>
        
        <div class="flux-sequencer__meta">
            <div class="flux-sequencer__duration">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flux-sequencer__icon">
                    <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 4V8L10.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span class="@SequenceTimeClass">@Duration</span>
            </div>
            
            @if (!string.IsNullOrEmpty(Component.ErrorDetails.LastValue))
            {
                <div class="flux-sequencer__error-badge" title="@Component.ErrorDetails.LastValue">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M8 1L1 14h14L8 1z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                        <path d="M8 6v3M8 11v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </div>
            }
        </div>
    </div>

    <!-- Current Step Display -->
    <AxoStepView Class="flux-sequencer__current-step" Component="Component.CurrentStep" />

    <!-- Controls -->
    <div class="flux-sequencer__controls">
        <button type="button" 
                class="flux-toggle-pill @(CurrentSteppingMode == eAxoSteppingMode.StepByStep ? "flux-toggle-pill--active" : "")"
                @onclick="ToggleStepMode"
                title="@(CurrentSteppingMode == eAxoSteppingMode.StepByStep ? "Exit step mode" : "Enter step mode")">
            <span class="flux-toggle-pill__indicator"></span>
            <span class="flux-toggle-pill__label">
                @if (CurrentSteppingMode == eAxoSteppingMode.StepByStep)
                {
                    <text>EXIT STEP MODE</text>
                }
                else
                {
                    <text>ENTER STEP MODE</text>
                }
            </span>
        </button>

        @if (CurrentSteppingMode == eAxoSteppingMode.StepByStep)
        {
            <div class="flux-sequencer__step-controls">
                <AxoTaskCommandView ShowText="false" HideRestoreButton="true" ShowAbortButton="false" Component="this.Component.StepBackwardCommand" />
                <AxoTaskCommandView ShowText="true" HideRestoreButton="false" ShowAbortButton="false" Component="this.Component.StepIn" />
                <AxoTaskCommandView ShowText="false" HideRestoreButton="true" ShowAbortButton="false" Component="this.Component.StepForwardCommand" />
            </div>
        }
    </div>

    <!-- Error Details (if present) -->
    @if (!string.IsNullOrEmpty(Component.ErrorDetails.LastValue))
    {
        <div class="flux-sequencer__error-details">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" style="flex-shrink: 0;">
                <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                <path d="M9 5v4M9 11v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span>@Component.ErrorDetails.LastValue</span>
        </div>
    }
</div>

@code {
    public enum eSequenceStatus
    {
        Inactive,
        Active,
        SequencerError,
        SequenceTimeOutError,
        ExternalComponentError,
    }


    private IEnumerable<AxoObject> AssociatedComponents => this.Component.Associates.Where(p => p is AxoObject).Cast<AxoObject>();

    private eSequenceStatus CurrentStatus
    {
        get
        {
            var taskState = (eAxoTaskState)this.Component.Status.LastValue;

            if (taskState == eAxoTaskState.Error)
            {
                return eSequenceStatus.SequencerError;
            }
            
            if (AssociatedComponents.Any(p => p.MsgCnt.LastValue > 0 ) 
                && this.Component.Duration.LastValue > TimeSpan.FromSeconds(this.Component.MaxSequenceDuration.LastValue.TotalSeconds))
            {
                return eSequenceStatus.ExternalComponentError;
            }

            if (this.Component.Duration.LastValue > 
            TimeSpan.FromSeconds(this.Component.MaxSequenceDuration.LastValue.TotalSeconds) 
            && this.Component.Duration.LastValue > TimeSpan.FromSeconds(10))
            {
                return eSequenceStatus.SequenceTimeOutError;
            }

            if (taskState == eAxoTaskState.Busy)
            {
                return eSequenceStatus.Active;
            }

            return eSequenceStatus.Inactive;
        }
    }

    private string SequencerStateClass
    {
        get
        {
            return CurrentStatus switch
            {
                eSequenceStatus.Inactive => "flux-sequencer--inactive",
                eSequenceStatus.Active => "flux-sequencer--active",
                eSequenceStatus.SequencerError => "flux-sequencer--error",
                eSequenceStatus.SequenceTimeOutError => "flux-sequencer--timeout",
                eSequenceStatus.ExternalComponentError => "flux-sequencer--error",
                _ => "flux-sequencer--inactive"
            };
        }
    }

    private string StatusBadgeClass
    {
        get
        {
            return CurrentStatus switch
            {
                eSequenceStatus.Active => "flux-badge--primary",
                eSequenceStatus.SequencerError => "flux-badge--danger",
                eSequenceStatus.SequenceTimeOutError => "flux-badge--warning",
                eSequenceStatus.ExternalComponentError => "flux-badge--danger",
                _ => "flux-badge"
            };
        }
    }

    private string StatusText
    {
        get
        {
            return CurrentStatus switch
            {
                eSequenceStatus.Active => "Running",
                eSequenceStatus.SequenceTimeOutError => "Timeout",
                eSequenceStatus.SequencerError => "Error",                
                eSequenceStatus.ExternalComponentError => "Error",
                _ => "Idle"
            };
        }
    }

    private string SequenceTimeClass
    {
        get
        {
            if (this.Component.Duration.LastValue > TimeSpan.FromSeconds(Component.MaxSequenceDuration.LastValue.TotalSeconds) && this.Component.Duration.LastValue > TimeSpan.FromSeconds(10))
            {
                var delay = (this.Component.Duration.LastValue.TotalSeconds - Component.MaxSequenceDuration.LastValue.TotalSeconds);
                return $"text-danger-500";
            }

            return "text-success-500";
        }
    }

    private eAxoSteppingMode CurrentSteppingMode => (eAxoSteppingMode)this.Component.SteppingMode.LastValue;

    private async Task ToggleStepMode()
    {
        var currentSteppingMode = (eAxoSteppingMode)this.Component.SteppingMode.LastValue;

        if (currentSteppingMode == eAxoSteppingMode.Continous)
        {
            await this.Component.SteppingMode.SetAsync((short)eAxoSteppingMode.StepByStep);
        }
        else
        {
            await this.Component.SteppingMode.SetAsync((short)eAxoSteppingMode.Continous);
        }

    }

    private string Description => string.IsNullOrEmpty(this.Component.CurrentStep.Descr.GetCyclic()) ? ":(" : this.Component.CurrentStep.Descr.GetCyclic();

    private string Duration => this.Component.Duration.GetCyclic().ToString(@"hh\:mm\:ss\.fff");

    public override void ConfigurePolling()
    {
        this.StartPolling(this.Component.CurrentStep.Descr, 500);
        this.StartPolling(this.Component.SteppingMode, 500);
        this.StartPolling(this.Component.Duration, 1000);
        this.StartPolling(this.Component.MsgCnt, 2500);
        foreach (var a in AssociatedComponents)
        {
                this.StartPolling(a.MsgCnt, 2500);
        }
        this.StartPolling(Component.MaxSequenceDuration, 1000);
    }
}

