@using Operon.Components.Accordion
@inherits RenderableComplexComponentBase<AxoSequencer>
@namespace AXOpen.Core

<div data-axo-sequencer-view class="card @(!this.IsControllable ? "opacity-60 cursor-default" : null)">
    <!-- Sequencer Header -->
    <div class="flex flex-wrap justify-between gap-2 mx-4 my-2">
        <div class="flex flex-wrap items-center gap-2">
            <h5 class="text-xl text-text font-semibold">@Component.AttributeName</h5>
            @if (_currentStatus != eSequenceStatus.Inactive)
            {
                <span class="badge @StatusBadgeClass">
                    @StatusText
                </span>
            }
        </div>
        <div class="flex flex-wrap">
            <button type="button" class="btn gap-2 @(_currentSteppingMode == eAxoSteppingMode.StepByStep ? "btn-primary" : "btn-outline-primary")"
                @onclick="ToggleStepMode"
                title="@(_currentSteppingMode == eAxoSteppingMode.StepByStep ? "Exit step mode" : "Enter step mode")">
                <span class="inline-flex w-5 h-5 rounded-full @(_currentSteppingMode == eAxoSteppingMode.StepByStep ? "bg-primary/40" : "border border-primary/40") shadow-glow-primary"></span>
                @if(!HasExternalStepModeControl)
                {
                    if (_currentSteppingMode == eAxoSteppingMode.StepByStep)
                    {
                        <text>STEP MODE</text>
                    }   
                    else
                    {
                       <text>STEP MODE</text>
                    }
                }
                else
                {
                    if (_currentSteppingMode == eAxoSteppingMode.StepByStep)
                    {
                        <text>STEP MODE ACTIVE - CONTROLLED BY MASTER SEQUENCE</text>
                    }   
                    else
                    {
                       <text>STEP MODE CONTROLLED BY MASTER SEQUENCE</text>
                    }
                
                }
            </button>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <div class="flex flex-wrap items-center gap-2">
                <Operon.Icons.HeroIcon Icon="clock" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                <span class="text-sm @SequenceTimeClass">@_duration</span>
            </div>
            
            @if (!string.IsNullOrEmpty(Component.ErrorDetails.LastValue))
            {
                <div class="badge badge-danger" title="@Component.ErrorDetails.LastValue">
                    <Operon.Icons.HeroIcon Icon="exclamation-triangle" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                </div>
            }
        </div>
    </div>

    <!-- Current Step Display -->
    <div class="flex flex-wrap m-2 @(_currentSteppingMode == eAxoSteppingMode.StepByStep ? "justify-between" : "justify-center") items-center p-2 gap-2">
        @if(_currentSteppingMode == eAxoSteppingMode.StepByStep)
        {
            <AxoTaskCommandView ShowText="false" HideRestoreButton="true" ShowAbortButton="false" Component="this.Component.StepBackwardCommand" Class="btn-lg" />
        }
        @if (Component.CurrentStep != null)
        {
            if(_currentSteppingMode == eAxoSteppingMode.StepByStep)
            {
                <AxoTaskCommandView Text="@_runStepButtonText" ShowText="true" HideRestoreButton="false" ShowAbortButton="false" Component="this.Component.StepIn" Class="btn-lg" />
            }
            else
            {
                <AxoTaskStatusView Text="@_runStepButtonText" ShowText="true" HideRestoreButton="false" ShowAbortButton="false" Component="this.Component.StepIn" Class="btn-lg" />
            }
        }
        @if(_currentSteppingMode == eAxoSteppingMode.StepByStep)
        {
            <AxoTaskCommandView ShowText="false" HideRestoreButton="true" ShowAbortButton="false" Component="this.Component.StepForwardCommand" Class="btn-lg" />
        }
    </div>
      
    <!-- Error Details (if present) -->
    @if (!string.IsNullOrEmpty(Component.ErrorDetails.LastValue))
    {
        <div class="alert alert-danger gap-2">
            <Operon.Icons.HeroIcon Icon="exclamation-circle" Type="Operon.Icons.IconType.Outline" Class="size-5" />
            <h6>@Component.ErrorDetails.LastValue</h6>
        </div>
    }
</div>

@code {
    private string StatusBadgeClass
    {
        get
        {
            return _currentStatus switch
            {
                eSequenceStatus.Active => "badge-primary",
                eSequenceStatus.SequencerError => "badge-danger",
                eSequenceStatus.SequenceTimeOutError => "badge-warning",
                eSequenceStatus.ExternalComponentError => "badge-danger",
                _ => "badge-info"
            };
        }
    }

    private string StatusText
    {
        get
        {
            return _currentStatus switch
            {
                eSequenceStatus.Active => "Running",
                eSequenceStatus.SequenceTimeOutError => "Timeout",
                eSequenceStatus.SequencerError => "Error",                
                eSequenceStatus.ExternalComponentError => "Error",
                _ => "Idle"
            };
        }
    }

    private string SequenceTimeClass
    {
        get
        {
            if (this.Component.Duration.LastValue > TimeSpan.FromSeconds(Component.MaxSequenceDuration.LastValue.TotalSeconds) && this.Component.Duration.LastValue > TimeSpan.FromSeconds(10))
            {
                var delay = (this.Component.Duration.LastValue.TotalSeconds - Component.MaxSequenceDuration.LastValue.TotalSeconds);
                return $"text-danger";
            }

            return "text-success";
        }
    }
}
