@namespace AXOpen.Core
@using AXSharp.Connector;
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Operon.Icons
@inherits RenderableComplexComponentBase<AxoTask>
@implements IDisposable;

<button data-axo-task-view type="button"
        class="btn btn-primary text-sm! font-semibold! uppercase gap-4 @Class flex items-center"
        style="@Style"
        @onclick="this.InvokeTask"
        disabled="@IsDisabled">
    <span class="flex items-center justify-center w-5 h-5 shrink-0" aria-hidden="true">
        @if (State == eAxoTaskState.Ready)
        {
            <span class="inline-flex items-center justify-center w-full h-full rounded-full border-2 border-border"></span>
        }
        else if (State == eAxoTaskState.Kicking)
        {
            <span class="inline-flex items-center justify-center w-full h-full rounded-full border-2 border-border border-dashed animate-pulse"></span>
        }
        else if (State == eAxoTaskState.Busy)
        {
            <span class="inline-flex items-center justify-center w-full h-full rounded-full border-t-2 border-text animate-spin"></span>
        }
        else if (State == eAxoTaskState.Done)
        {
            <HeroIcon Icon="check" Type="IconType.Outline" Class="size-5" />
        }
        else if (State == eAxoTaskState.Error)
        {
            <HeroIcon Icon="x-mark" Type="IconType.Outline" Class="size-5" />
        }
    </span>
    <span class="flex-1 text-center px-2">@Description</span>
    
    @if (!HideRestoreButton)
    {
        <span role="button"
              tabindex="0"
              class="flex items-center justify-center w-5 h-5 shrink-0 text-text/60 hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              title="Reset task"
              @onclick="@OnRestoreClick"
              @onclick:stopPropagation="true"
              @onkeydown="OnRestoreKeyDown">
            <span class="sr-only">Restore</span>
            <HeroIcon Icon="arrow-path" Type="IconType.Solid" Class="size-5" />
        </span>
    }
</button>

@code {

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public bool ShowReset { get; set; }
    [Parameter] public bool ShowAbortButton { get; set; } = false;
    [Parameter] public bool ShowRestoreButton { get; set; } = true;
    [Parameter] public bool ShowIcon { get; set; } = false;
    [Parameter] public bool ShowText { get; set; } = true;
    [Parameter] public string IconClass { get; set; } = "star"; // Default icon class
    [Parameter] public string? Text { get; set; }

    private void OnRestoreClick(MouseEventArgs e)
    {
        // Stop propagation is handled in the markup with @onclick:stopPropagation
        this.RestoreTask();
    }

    private void OnRestoreKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            RestoreTask();
        }
    }
}
