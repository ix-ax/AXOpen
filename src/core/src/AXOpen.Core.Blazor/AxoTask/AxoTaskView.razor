@namespace AXOpen.Core
@using AXSharp.Connector;
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.AspNetCore.Components.Web;
@using Operon.Icons;
@inherits RenderableComplexComponentBase<AxoTask>
@implements IDisposable;

<button data-axo-task-view type="button"
        aria-disabled="@IsDisabled"
        aria-label="@($"{Description} — {StateLabel}")"
        title="@ErrorTitle"
        class="btn @ButtonClass gap-2 flex items-center justify-between @Class"
        style="@Style"
        @onclick="this.InvokeTask"
        disabled="@IsDisabled">
    <span class="flex items-center gap-2 text-inherit">
        @if (IsDisabled)
        {
            <HeroIcon Icon="lock-closed" Type="IconType.Outline" Class="@StatusHeroIconClass" />
        }
        else if (State == eAxoTaskState.Ready)
        {
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border-2 border-current text-inherit border-solid"></span>
        }
        else if (State == eAxoTaskState.Kicking)
        {
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border-2 border-current border-dashed text-inherit animate-pulse"></span>
        }
        else if (State == eAxoTaskState.Busy)
        {
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border-t-2 border-current text-inherit animate-spin"></span>
        }
        else if (State == eAxoTaskState.Done)
        {
            <HeroIcon Icon="check" Type="IconType.Outline" Class="@StatusHeroIconClass" />
        }
        else if (State == eAxoTaskState.Aborted)
        {
            <HeroIcon Icon="stop" Type="IconType.Outline" Class="@StatusHeroIconClass" />
        }
        else if (State == eAxoTaskState.Error)
        {
            <HeroIcon Icon="x-mark" Type="IconType.Outline" Class="@StatusHeroIconClass" />
        }
    </span>

    <span class="flex-1 min-w-0 text-center text-inherit line-clamp-2 text-balance wrap-anywhere leading-tight">
        @Description.ToUpper()
    </span>

    @if (State == eAxoTaskState.Aborted && !HideRestoreButton)
    {
        <button type="button" class="btn btn-no-bg-primary p-0! text-inherit!" title="@Localizer["ResumeTask"]" disabled="@IsDisabled" @onclick="@OnResumeClick" @onclick:stopPropagation="true" @onkeydown="OnResumeKeyDown">
            <HeroIcon Icon="play" Type="IconType.Solid" Class="size-5" />
        </button>
    }

    @if (!HideRestoreButton)
    {
        <button type="button" class="btn btn-no-bg-primary p-0! text-inherit!" title="@Localizer["ResetTask"]" disabled="@IsDisabled" @onclick="@OnRestoreClick" @onclick:stopPropagation="true" @onkeydown="OnRestoreKeyDown">
            <HeroIcon Icon="arrow-path" Type="IconType.Solid" Class="size-5" />
        </button>
    }
</button>

@code {

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Text { get; set; }

    private void OnRestoreClick(MouseEventArgs e)
    {
        // Stop propagation is handled in the markup with @onclick:stopPropagation
        this.RestoreTask();
    }

    private void OnRestoreKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            RestoreTask();
        }
    }

    private string StatusHeroIconClass => $"size-5 text-inherit {(IsDisabled ? "opacity-60" : string.Empty)}";
}
