@namespace AXOpen.Core
@using AXSharp.Connector;
@using Microsoft.AspNetCore.Components.Authorization
@inherits RenderableComplexComponentBase<AxoTask>
@implements IDisposable;

<div class="btn-group @AnimationClass">
    <button type="button" class="btn @ButtonClass" disabled="@IsDisabled" @onclick="@InvokeTask">
        @if (ShowIcon && !string.IsNullOrEmpty(IconClass))
        {
            <Operon.Icons.HeroIcon Icon="@IconClass" Type="Operon.Icons.IconType.Outline" Class="size-5" />
        }
        @if (ShowText)
        {
            <span>@Description</span>
        }
    </button>
    @if (!HideRestoreButton)
    {
        <button type="button" class="btn @ButtonClass" disabled="@IsDisabled" @onclick="@RestoreTask">
            <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-5" />
        </button>
    }
</div>




