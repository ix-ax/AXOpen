@namespace AXOpen.Core
@using AXSharp.Connector.ValueTypes
@using AXSharp.Connector;
@*@using AXSharp.Presentation.Blazor.Controls.Layouts.TabControlComponents;*@
@using Operon.Components
@using Operon.Components.Accordion
@using Operon.Components.Dropdown
@using Operon.Icons
@using System.Globalization
@using AXSharp.Connector.Localizations
@inherits RenderableComplexComponentBase<AxoByteArray>;

<div data-axo-byte-array-view class="flex flex-wrap w-full">
    <Accordion>
        <AccordionItem Title="Data">
            <div class="flex flex-wrap justify-between">
                <p class="align-middle">@Component.Translate(Component.AttributeName, CultureInfo.CurrentUICulture)</p>

                <div class="flex flex-wrap items-center gap-1">
                    <div class="">
                        <select @bind="@DisplayFormat" class="select bg-background-light in-w-6">
                            @foreach (var displayedFormat in DisplayedFormatList)
                            {
                                <option value="@displayedFormat.DisplayFormat"> @displayedFormat.Description </option>
                            }
                        </select>
                    </div>

                    @if (IsControllable & !IsReadOnly)
                    {
                        <button type="button" class="btn btn-primary" @onclick="() => UploadAndFormatData(null, null)">
                            <HeroIcon Icon="arrow-up-tray" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="() => Download()">
                            <HeroIcon Icon="arrow-down-tray" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="() => UploadAndFormatData(null, null)">
                            <HeroIcon Icon="arrow-path" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                        </button>
                    }
                </div>
            </div>

            @if (this.Data != null)
            {
                <div class="flex flex-nowrap flex-row overflow-x-auto mt-2">
                    @foreach (IndexedData<string> item in this.Data)
                    {
                        if (item != null && @item.Data != null)
                        {
                            <div class="input-group">
                                <label>@item.Index</label>
                                <input type="text" @bind="item.Data" maxlength="@MaxLen" style="width: calc(var(--spacing) * 9 + var(--spacing) * 2 * @MaxLen) !important;" />
                            </div>
                        }
                    }
                </div>
            }
        </AccordionItem>
    </Accordion>
</div>

@code {
    private Dropdown _dropdownFormat { get; set; }

    private List<DisplayedFormat> DisplayedFormatList = new List<DisplayedFormat>()
        {new DisplayedFormat(eDisplayFormat.Array_of_decimals, "array of decimals"),
         new DisplayedFormat(eDisplayFormat.Array_of_hexdecimals, "array of hexadecimals"),
         new DisplayedFormat(eDisplayFormat.String, "string") };

    private async Task Upload()
    {
        UploadAndFormatData(null, null);
        await InvokeAsync(StateHasChanged);
    }

    private async Task Download()
    {
        Download(null, null);
    }

    private class DisplayedFormat
    {
        public DisplayedFormat(eDisplayFormat displayFormat, string description)
        {
            DisplayFormat = displayFormat;
            Description = description;
        }

        public eDisplayFormat DisplayFormat { get; set; }
        public string Description { get; set; }
    }
}
