@namespace AXOpen.Core
@using AXSharp.Connector.ValueTypes
@using AXSharp.Connector;
@using Operon.Components.Accordion
@using Operon.Icons
@* @using AXSharp.Presentation.Blazor.Controls.Layouts.TabControlComponents; *@
@inherits RenderableComplexComponentBase<AxoBoolArray>;

<Accordion>
    <AccordionItem Title="Data">
        <div class="flex flex-wrap justify-between">
            <p class="align-middle">@Component.AttributeName</p>

            <button type="button" class="btn btn-primary" @onclick="() => UpdateData(null, null)">
                <HeroIcon Icon="arrow-path" Type="Operon.Icons.IconType.Outline" Class="size-5" />
            </button>
        </div>

        @if (this.Data != null)
        {
            <div class="flex flex-wrap mt-4">
                @foreach (IndexedData<bool> item in this.Data)
                {
                    if (item != null)
                    {
                        <div class="checkbox-group">
                            <input type="checkbox" @bind="item.Data" disabled="@IsDisabled" />
                            <label>@item.Index</label>
                        </div>
                    }
                }
            </div>
        }
    </AccordionItem>
</Accordion>
