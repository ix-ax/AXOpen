@namespace AXOpen.Core.Blazor.AxoAlertDialog
@using AXOpen.Base.Dialogs;

@*TODO: @Brano5 this should be aligned with operon.*@

@if (DialogService.GetAlertDialogs() != null && DialogService.GetAlertDialogs().Count > 0)
{
    <div class="fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        @foreach (AlertToast toast in DialogService.GetAlertDialogs().ToList())
        {
            var bgColor = "";
            switch (toast.Type)
            {
                case eAlertType.Info:
                    bgColor = "bg-blue-100 dark:bg-blue-900";
                    break;
                case eAlertType.Success:
                    bgColor = "bg-green-100 dark:bg-green-900";
                    break;
                case eAlertType.Danger:
                    bgColor = "bg-red-100 dark:bg-red-900";
                    break;
                case eAlertType.Warning:
                    bgColor = "bg-orange-100 dark:bg-orange-900";
                    break;
                default:
                    bgColor = "bg-gray-100 dark:bg-gray-900";
                    break;
            }

            <div class="toast @bgColor">
                <div class="flex items-center">
                    @switch (toast.Type)
                    {
                        case eAlertType.Info:
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-blue-400">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                            </svg>
                            break;
                        case eAlertType.Success:
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-green-400">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            break;
                        case eAlertType.Danger:
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-red-400">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            break;
                        case eAlertType.Warning:
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-orange-400">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                            </svg>
                            break;
                        default:
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-primary-400">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                            </svg>
                            break;
                    }
                    <p class="me-auto ms-2 font-bold truncate">@toast.Title</p>
                    <p class="ms-auto text-xs me-1">@GetTime(toast.Posted)</p>
                    <a class="inline-block" @onclick="() => DialogService.RemoveAlertDialog(toast)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-gray-400 hover:text-gray-600">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                        </svg>
                    </a>
                </div>
                <hr class="toast-divider" />
                <div class="flex ms-1 truncate">
                    @toast.Message
                </div>
            </div>
        }
    </div>
}
