@namespace AXOpen.Core.Blazor.AxoDialogs
@using Operon.Components
@inherits AXOpen.Core.Blazor.Dialogs.AxoLocator;

<Modal @ref="ModalDialogContainer" Static="true">
    <div class="modal-header">
        <a href="Identity/Account/Login">@Localizer["Log in"]</a>
    </div>
    <div class="modal-body">
        @foreach (var dialogInstance in _dialogProxyService?.DisplayedDialogs)
        {
            <RenderableContentControl Context="@dialogInstance" Presentation="Dialog" />
        }
    </div>
</Modal>

@code
{
    protected Modal ModalDialogContainer;
}

