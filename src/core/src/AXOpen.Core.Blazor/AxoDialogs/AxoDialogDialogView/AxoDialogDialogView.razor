@namespace AXOpen.Core
@using AXOpen.Core.Blazor.AxoDialogs;
@using Operon.Icons
@inject NavigationManager _navigationManager
@inherits AxoDialogBaseView<AxoDialog>
@inject AuthenticationStateProvider _asp

<div class="@BackgroundColor">
    <div class="flex flex-wrap justify-center" title="@Component.Symbol">
        <h4 class="text-center">@Component._caption.GetCyclic()</h4>
    </div>

    <div class="flex flex-wrap justify-center">
        <h5 class="text-center">@Component._text.GetCyclic()</h5>
    </div>

    <div class="flex flex-wrap justify-center gap-1">
        @if (IsOkDialogType())
        {
            <button type="button" class="btn btn-primary" disabled=@ButtonDisabled() @onclick="DialogAnswerOk">@Localizer["Ok"]</button>
        }
        @if (IsYesNoDialogType() || IsYesNoCancelDialogType())
        {
            <button type="button" class="btn btn-primary" @onclick="DialogAnswerYes" disabled=@ButtonDisabled()>@Localizer["Yes"]</button>
            <button type="button" class="btn btn-primary" @onclick="DialogAnswerNo" disabled=@ButtonDisabled()>@Localizer["No"]</button>
        }
        @if (IsYesNoCancelDialogType())
        {
            <button type="button" class="btn btn-primary" @onclick="DialogAnswerCancel" disabled=@ButtonDisabled()>@Localizer["Cancel"]</button>
        }
    </div>
</div>

@functions {
    private bool ButtonDisabled()
    {
        return _asp.GetAuthenticationStateAsync().Result.User.Identity.IsAuthenticated ? false : true;
    }

    private RenderFragment RenderDialogIcon() => __builder =>
    {
        var parsedEnum = (eDialogType)Enum.Parse(typeof(eDialogType), Component._dialogType.Cyclic.ToString());
        @switch (parsedEnum)
        {
            case eDialogType.Undefined:
                <HeroIcon Icon="question-mark-circle" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                break;
            case eDialogType.Info:
                <HeroIcon Icon="information-circle" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                break;
            case eDialogType.Success:
                <HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                break;
            case eDialogType.Warning:
                <HeroIcon Icon="exclamation-circle" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                break;
            case eDialogType.Danger:
                <HeroIcon Icon="exclamation-triangle" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                break;
            default:
                <HeroIcon Icon="question-mark-circle" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                break;
        }
    };
}