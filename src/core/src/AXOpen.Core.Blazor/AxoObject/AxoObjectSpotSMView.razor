@namespace AXOpen.Core
@inherits RenderableComplexComponentBase<AxoObject>
@using System.Timers
@using AXOpen.Messaging.Static
@using AXOpen.VisualComposer
@using AXOpen.VisualComposer.Components.VisualComposerItem
@using AXSharp.Connector
@using Microsoft.JSInterop
@using Operon.Icons
@inject IJSRuntime JSRuntime

<button data-axo-object-spot-sm-view type="button" class="action-btn gap-2 @(observer?.ActiveMessagesCount > 0 ? "shadow-glow-danger" : null)" @onclick="() => SetCurrentObject()">
    <div class="action-btn-icon-primary">
        <HeroIcon Icon="@(observer?.ActiveMessagesCount > 0 ? "exclamation-circle" : "cube")" Type="IconType.Solid" Class="size-4" />
    </div>
    <span class="">@Component.AttributeName</span>
    @if (observer?.ActiveMessagesCount > 0)
    {
        <div class="badge badge-danger">
            @observer.ActiveMessagesCount
        </div>
    }
</button>

@code
{
    private AxoMessageProvider? observer;

    public override void ConfigurePolling()
    {
        if (this.Component is AxoObject o)
        {
            this.StartPolling(o.MsgCnt,2500);
        }
    }

    /// <summary>
    /// This method is called when a component is changed.
    /// It creates a new instance of AxoMessageObserver using the changed component and assigns it to the observer variable.
    /// </summary>
    public override void OnComponentChanged()
    {
        observer = AxoMessageProvider.Create(new[] { this.Component });
        
        updateTimer.Interval = this.PollingInterval;
        updateTimer.Enabled = true;
        updateTimer.Elapsed += (sender, args) =>
        {
            InvokeAsync(this.StateHasChanged);

        };
        updateTimer.Start();
        
    }

    private readonly Timer updateTimer = new Timer();

    protected virtual void SetCurrentObject(string presentationType = "Status-Display")
    {
        if (RccContainer is RenderableContentControl rccContainer)
        {
            if (rccContainer.ParentContainer is VisualComposerItem composerItem)
            {
                composerItem.Parent.OpenDetails(this.Component, presentationType); // Updated to use presentationType
            }
        }
    }

    ///<inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        if (observer != null) await observer.InitializeLightUpdate(this.StartPolling);
        await base.OnInitializedAsync();
    }
}
