@namespace AXOpen.Core
@inherits RenderableComplexComponentBase<AxoObject>
@using AXOpen.Core
@using AXOpen.Messaging.Static
@using System.Runtime.CompilerServices
@using AXSharp.Connector
@using Microsoft.JSInterop
@implements IAsyncDisposable;
@inject IJSRuntime JSRuntime
@using AXOpen.Messaging.Static
@using AXSharp.Connector
@inject AuthenticationStateProvider AuthenticationStateProvider;

   @*  @if (MessageProvider.ActiveMessagesCount > 0)
    { *@
        <div class="flex flex-col w-full h-full p-3">


@if (MessageProvider.ActiveMessagesCount > 0)
{
    <div class="flex flex-wrap flex-col">
        @foreach (var message in MessageProvider.Messengers)
        {
            if (message.State != eAxoMessengerState.Idle)
            {
                <AxoMessengerView Component="message"></AxoMessengerView>
            }
        }
    </div>
}

@code
{
    private AxoMessenger noMessageMessenger => new(null, string.Empty, string.Empty)
    {

    };

    private IJSObjectReference? module;
    private IEnumerable<ITwinObject> observedObjects = new List<ITwinObject>();
    private AxoMessageProvider provider;

    [Parameter]
    public int DisplayMimeCount { get; set; } = 10;

    [Parameter]
    public AxoMessageProvider MessageProvider
    {
        get => provider;
        set
        {
            provider = value;
        }
    }

    [Parameter]
    public IEnumerable<ITwinObject> ObservedObjects
    {
        get => observedObjects;
        set
        {
            observedObjects = value;
            this.OnComponentChanged();
        }
    }

    public override async void OnComponentChanged()
    {
        // if (observedObjects.Count() == 0
        //     && !observedObjects.First().Equals(this.Component))
        // {
        //     observedObjects = new[] { this.Component };
        // }

        MessageProvider = AxoMessageProvider.Create(observedObjects);
        await LoadMessages();
        base.OnComponentChanged();
        this.StateHasChanged();
    }

    ///<inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        if (module != null) await module.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    ///<inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = MessageProvider.InitializeLightUpdate(this.StartPolling);

        await LoadMessages();

        // Notify Blazor to refresh the UI
        StateHasChanged();
    }

    private async Task AcknowledgeAll()
    {
        var ast = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (MessageProvider is { Messengers: not null })
        {
            foreach (var messenger in
                     MessageProvider.Messengers
                         .Where(p => p.State == eAxoMessengerState.ActiveAcknowledgeRequired ||
                                                p.State == eAxoMessengerState.InactiveWaitingForAcknowledge))
            {
                messenger.Acknowledge(ast.User.Identity);
            }
        }

        await LoadMessages();
    }
}
