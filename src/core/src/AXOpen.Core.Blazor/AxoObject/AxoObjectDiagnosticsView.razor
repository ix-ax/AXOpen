@namespace AXOpen.Core
@inherits RenderableComplexComponentBase<AxoObject>
@using AXOpen.Core
@using AXOpen.Messaging.Static
@using System.Runtime.CompilerServices
@using System.Security.Principal
@using AXSharp.Connector
@using Microsoft.JSInterop
@implements IAsyncDisposable;
@inject IJSRuntime JSRuntime
@using AXOpen.Messaging
@using AXSharp.Connector
@inject AuthenticationStateProvider AuthenticationStateProvider;

@if (EnableFiltering)
{
    <div data-axo-object-diagnostics-view class="card p-2">
        <div class="input-group">
            <input type="text" id="inputTailwindString" @bind="SearchTerm" @bind:event="oninput" title="Search alarms" placeholder="Search title or equipment" />
        </div>

        <div class="flex flex-wrap flex-row items-center justify-center gap-4 py-1">
            <div class="inline-flex flex-wrap items-center gap-2">
                <span class="text-sm font-semibold uppercase">Severity</span>
                @foreach (var severity in SeverityOptions)
                {
                    <label class="btn btn-sm @(IsSeveritySelected(severity) ? "btn-primary" : "btn-outline-primary")">
                        <input type="checkbox" checked="@IsSeveritySelected(severity)" @onchange="() => ToggleSeverity(severity)" class="checkbox me-1" />
                        <span>@SeverityLabel(severity)</span>
                    </label>
                }
            </div>

            <div class="w-[1px] h-6 bg-text-light/60"></div>

            <div class="inline-flex flex-wrap items-center gap-2">
                <span class="text-sm font-semibold uppercase">State</span>
                <label class="btn btn-sm @(IncludeActive ? "btn-primary" : "btn-outline-primary")">
                    <input type="checkbox" @bind="IncludeActive" class="checkbox me-1" />
                    <span>Active</span>
                </label>
                <label class="btn btn-sm @(IncludeCleared ? "btn-primary" : "btn-outline-primary")">
                    <input type="checkbox" @bind="IncludeCleared" class="checkbox me-1" />
                    <span>Cleared</span>
                </label>
            </div>

            <div class="w-[1px] h-6 bg-text-light/60"></div>

            <button type="button" class="btn btn-sm btn-primary gap-1 @(_shouldBounce ? "animate-bounce" : null)" @onclick="RefreshMessages" title="Refresh messages">
                <Operon.Icons.HeroIcon Icon="arrow-path" Type="Operon.Icons.IconType.Solid" Class="size-3" />
                Refresh
            </button>
        </div>
    </div>
}

<div class="overflow-x-auto">
    <table class="table table-striped table-hover @Class" style="@Style">
        <thead>
            <tr>
                <th>Severity</th>
                <th>Title</th>
                <th>Equipment</th>
                <th>State</th>
                <th>Raised</th>
                <th>Acknowledged</th>
                <th>Duration</th>
                @if (HasActionsColumn)
                {
                    <th class="text-right">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Rows.Count == 0)
            {
                <tr>
                    <td colspan="@(HasActionsColumn ? 8 : 7)" class="p-2">No alarms to display.</td>
                </tr>
            }
            else
            {
                @foreach (var alarm in Rows)
                {
                    var isExpanded = _expandedAlarmIds.Contains(alarm.GetHashCode());
                    <tr class="@ConvertToInternalBgSeverityName((eAxoMessageCategory)alarm.Category.LastValue)"
                        @onclick="() => HandleRowClick(alarm)"
                        @onkeypress="args => HandleRowKeyPress(args, alarm)"
                        role="@RowRole"
                        tabindex="@RowTabIndex">
                        <td class="flex flex-nowrap gap-2 items-center">
                            <button type="button" class="flex cursor-pointer" @onclick:stopPropagation="true" @onclick="() => ToggleAlarmDetails(alarm)" title="@(isExpanded ? "Hide details" : "Show details")" aria-expanded="@isExpanded">
                                <Operon.Icons.HeroIcon Icon="chevron-right" Type="Operon.Icons.IconType.Solid" Class="@(isExpanded ? "size-5 icon-button-rotate-90 rotated" : "size-5 icon-button-rotate-90")" />
                            </button>
                            <span class="badge @ConvertToInternalBadgeSeverityName((eAxoMessageCategory)alarm.Category.LastValue)" aria-label="@alarm.Category">
                                @SeverityLabel((eAxoMessageCategory)alarm.Category.LastValue)
                            </span>
                        </td>
                        <td>@DisplayOrDash(@alarm.GetMessageText())</td>
                        <td>@alarm.GetParent()?.AttributeName</td>
                        <td class="font-semibold uppercase">@StateLabel(alarm)</td>
                        <td>@FormatTimestamp(alarm.Risen.LastValue)</td>
                        <td>@FormatAcknowledged(alarm)</td>
                        <td>@FormatDuration(alarm)</td>
                        @if (HasActionsColumn)
                        {
                            <td class="text-right">
                                @if (Actions is not null)
                                {
                                    @Actions(alarm)
                                }

                                @if (alarm.State == (eAxoMessengerState.ActiveAcknowledgeRequired))
                                {
                                    <button type="button" class="btn btn-sm btn-primary gap-1" disabled="@CanAcknowledge(alarm)" @onclick:stopPropagation="true" @onclick="(() => HandleAcknowledge(alarm))" title="Acknowledge alarm">
                                        <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Solid" Class="size-5" />
                                        ACKN
                                    </button>
                                }
                            </td>
                        }
                        @if (alarm.IsAcknowledged)
                        {
                            <td class="text-right">
                                <div class="badge badge-primary uppercase">
                                    <p>Ack</p>
                                </div>
                            </td>
                        }
                    </tr>
                    @if (isExpanded)
                    {
                        <tr>
                            <td colspan="@(HasActionsColumn ? 8 : 7)">
                                <div class="flex flex-wrap flex-row justify-between w-full">
                                    <div class="flex flex-wrap flex-col">
                                        <span class="text-xs text-text/60 font-semibold uppercase">Suggestion:</span>
                                        <span class="text-xs text-text/80">@DisplayOrDash(alarm.GetHelpText())</span>
                                    </div>
                                    <div class="flex flex-wrap flex-col">
                                        <span class="text-xs text-text/60 font-semibold uppercase">Symbol:</span>
                                        <span class="text-xs text-text/80">@DisplayOrDash(alarm.Component.Symbol)</span>
                                    </div>
                                    <div class="flex flex-wrap flex-col">
                                        <span class="text-xs text-text/60 font-semibold uppercase">Human Readable:</span>
                                        <span class="text-xs text-text/80">@DisplayOrDash(alarm.Component.HumanReadable)</span>
                                    </div>
                                    <div class="flex flex-wrap flex-col">
                                        <span class="text-xs text-text/60 font-semibold uppercase">Alarm ID:</span>
                                        <span class="text-xs text-text/80">@DisplayOrDash(alarm.Identity.LastValue.ToString())</span>
                                    </div>
                                    <AuthorizeView Roles="Administrator">
                                        <Authorized>
                                            <div class="flex flex-wrap flex-col">
                                                <span class="text-xs text-text/60 font-semibold uppercase">Restore:</span>
                                                <button class="btn btn-sm btn-primary" @onclick="() => RestoreParentTask(alarm)">Restore</button>
                                            </div>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

@code
{
    private async Task RestoreParentTask(AxoMessenger? task)
    {
        task?.RestoreParentTask(await this.GetCurrentUserIdentity());
    }

    private static string DisplayOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string SeverityLabel(eAxoMessageCategory category) => ConvertToSeverityName(category);
    private static string StateLabel(AxoMessenger alarm)
    {
        if (!alarm.IsActive)
        {
            return "Cleared";
        }

        return alarm.IsAcknowledged ? "Active · Ack" : "Active";
    }
    private static string FormatTimestamp(DateTime? timestamp)
        => timestamp?.ToLocalTime().ToString("g") ?? "—";
    private static string FormatAcknowledged(AxoMessenger Component)
    {
        if (!Component.IsAcknowledged)
        {
            return Component.IsActive ? "Pending" : "—";
        }

        return FormatTimestamp(Component.Acknowledged.LastValue);
    }
    private static string FormatDuration(AxoMessenger Component)
    {
        try
        {
            if (Component.Risen.LastValue.Equals(new DateTime()))
            {
                return "—";
            }

            var end = Component.IsActive ? DateTime.UtcNow : Component.Acknowledged.LastValue;
            if (end < Component.Risen.LastValue)
            {
                return "—";
            }

            var duration = end - Component.Risen.LastValue;
            return duration switch
            {
                { TotalMinutes: < 1 } => "< 1 min",
                { TotalHours: < 1 } => $"{(int)duration.TotalMinutes} min",
                { TotalDays: < 1 } => $"{duration.TotalHours:F1} h",
                _ => $"{duration.TotalDays:F1} d"
            };
        }
        catch (Exception e)
        {
            //swallow;
        }

        return "—";

    }
    private bool CanAcknowledge(AxoMessenger Component) => Component.IsActive && !Component.IsAcknowledged;
    private string? RowRole => RowSelected.HasDelegate ? "button" : null;
    private int? RowTabIndex => RowSelected.HasDelegate ? 0 : (int?)null;

    private bool HasActionsColumn => Actions is not null || AcknowledgeRequested.HasDelegate;


    protected async Task<IIdentity?> GetCurrentUserIdentity()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authenticationState?.User?.Identity;
    }

    private async Task HandleAcknowledge(AxoMessenger alarm)
    {
        alarm.Acknowledge(await this.GetCurrentUserIdentity());
        await alarm.ReadDetailsAsync();
    }

    private async Task HandleRowClick(AxoMessenger alarm)
    {
        if (RowSelected.HasDelegate)
        {
            await RowSelected.InvokeAsync(alarm);
        }
    }

    private async Task HandleRowKeyPress(KeyboardEventArgs args, AxoMessenger alarm)
    {
        if (args.Key is "Enter" or " ")
        {
            await HandleRowClick(alarm);
        }
    }

    private static string ConvertToSeverityName(eAxoMessageCategory category)
    {
        switch (category)
        {
            case eAxoMessageCategory.Info:
                return "info";
            case eAxoMessageCategory.Warning:
                return "warning";
            case eAxoMessageCategory.Error:
                return "error";
            case eAxoMessageCategory.ProgrammingError:
                return "system";
            case eAxoMessageCategory.Critical:
                return "fatal";
         
        }

        return string.Empty;
    }

    private static string ConvertToInternalBadgeSeverityName(eAxoMessageCategory category)
    {
        switch (category)
        {
            case eAxoMessageCategory.Info:
                return "badge-info";
            case eAxoMessageCategory.Warning:
                return "badge-warning";
            case eAxoMessageCategory.Error:
                return "badge-danger";
            case eAxoMessageCategory.ProgrammingError:
                return "badge-danger";
            case eAxoMessageCategory.Critical:
                return "badge-danger";

        }

        return string.Empty;
    }

    private static string ConvertToInternalBgSeverityName(eAxoMessageCategory category)
    {
        switch (category)
        {
            case eAxoMessageCategory.Info:
                return "bg-info/10!";
            case eAxoMessageCategory.Warning:
                return "bg-warning/10!";
            case eAxoMessageCategory.Error:
                return "bg-danger/10!";
            case eAxoMessageCategory.ProgrammingError:
                return "bg-danger/10!";
            case eAxoMessageCategory.Critical:
                return "bg-danger/10!";
        }
        return string.Empty;
    }

    private IReadOnlyList<AxoMessenger> BuildRows()
    {
        var source = this.MessageProvider.Messengers ?? Enumerable.Empty<AxoMessenger>();

        if (!EnableFiltering)
        {
            return source
                .OrderByDescending(a => a.IsActive)
                .ThenByDescending(a => a.Category.LastValue)
                .ThenByDescending(a => a.Risen.LastValue)
                .ToList();
        }

        var filtered = source.Where(alarm => _selectedSeverities.Contains((eAxoMessageCategory)alarm.Category.LastValue))
            .Where(alarm => alarm.IsActive ? IncludeActive : IncludeCleared);

        var hasSearch = !string.IsNullOrWhiteSpace(SearchTerm);
        if (hasSearch)
        {
            var term = SearchTerm.Trim();
            filtered = filtered.Where(alarm => MatchesSearch(alarm, term));
        }

        return filtered
            .OrderByDescending(a => a.IsActive)
            .ThenByDescending(a => a.Category.LastValue)
            .ThenByDescending(a => a.Risen.LastValue)
            .ToList();
    }

    private static bool MatchesSearch(AxoMessenger alarm, string term)
    {
        return (alarm.Message.LastValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
               || (alarm.Component.Symbol?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
               || (alarm.Component.AttributeName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
               || (alarm.Message.LastValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private IReadOnlyList<AxoMessenger> Rows => _rows ??= BuildRows();

    private void ToggleSeverity(eAxoMessageCategory severity)
    {
        if (_selectedSeverities.Contains(severity))
            _selectedSeverities.Remove(severity);
        else
            _selectedSeverities.Add(severity);

        InvalidateFilters();
    }

    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            var sanitized = value ?? string.Empty;
            if (!string.Equals(_searchTerm, sanitized, StringComparison.Ordinal))
            {
                _searchTerm = sanitized;
                InvalidateFilters();
            }
        }
    }

    private bool _includeCleared;

    private bool IncludeCleared
    {
        get => _includeCleared;
        set
        {
            if (_includeCleared != value)
            {
                _includeCleared = value;
                InvalidateFilters();
            }
        }
    }

    private bool _includeActive = true;
    private bool IncludeActive
    {
        get => _includeActive;
        set
        {
            if (_includeActive != value)
            {
                _includeActive = value;
                InvalidateFilters();
            }
        }
    }

    private IReadOnlyList<AxoMessenger>? _rows;

    private void InvalidateFilters()
    {
        _rows = null;
    }


    private IJSObjectReference? module;
    private IEnumerable<ITwinObject> observedObjects = new List<ITwinObject>();
    private AxoMessageProvider provider;
    private static readonly eAxoMessageCategory[] SeverityOptions = Enum.GetValues<eAxoMessageCategory>().ToArray();
    private readonly HashSet<eAxoMessageCategory> _selectedSeverities = new(SeverityOptions);
    private bool _shouldBounce = false;
    private System.Threading.Timer? _bounceTimer;
    private DateTime _componentOpenedAt = DateTime.UtcNow;
    private readonly HashSet<int> _expandedAlarmIds = new();

    [Parameter] public EventCallback<AxoMessenger> RowSelected { get; set; }
    [Parameter] public RenderFragment<AxoMessenger>? Actions { get; set; }
    [Parameter] public EventCallback<AxoMessenger> AcknowledgeRequested { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public bool EnableFiltering { get; set; } = true;
    [Parameter] public AxoMessageProvider MessageProvider
    {
        get => provider;
        set
        {
            provider = value;
        }
    }

    [Parameter]
    public IEnumerable<ITwinObject> ObservedObjects
    {
        get => observedObjects;
        set
        {
            observedObjects = value;
            this.OnComponentChanged();
        }
    }

    private bool IsSeveritySelected(eAxoMessageCategory severity) => _selectedSeverities.Contains(severity);

    public override async void OnComponentChanged()
    {
        MessageProvider = AxoMessageProvider.Create(observedObjects);
        await LoadMessages();
        base.OnComponentChanged();
        this.StateHasChanged();
    }

    ///<inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        if (module != null) await module.DisposeAsync();
        _bounceTimer?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        
        if (firstRender)
        {
            CheckBounceCondition();
            StartBounceTimer();
        }
    }

    ///<inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = MessageProvider.InitializeLightUpdate(this.StartPolling);

        await LoadMessages();

        // Notify Blazor to refresh the UI
        StateHasChanged();
    }

    private void StartBounceTimer()
    {
        _bounceTimer = new System.Threading.Timer(_ =>
        {
            CheckBounceCondition();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void CheckBounceCondition()
    {
        var hasNoAlarms = Rows.Count == 0 || MessageProvider.ActiveMessagesCount == 0;
        var openForMoreThan7Seconds = (DateTime.UtcNow - _componentOpenedAt).TotalSeconds >= 7;
        
        _shouldBounce = hasNoAlarms || openForMoreThan7Seconds;
    }

    private async Task AcknowledgeAll()
    {
        var ast = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (MessageProvider is { Messengers: not null })
        {
            foreach (var messenger in
                     MessageProvider.Messengers
                         .Where(p => p.State == eAxoMessengerState.ActiveAcknowledgeRequired ||
                                                p.State == eAxoMessengerState.InactiveWaitingForAcknowledge))
            {
                messenger.Acknowledge(ast.User.Identity);
            }
        }

        await LoadMessages();
    }

    private async Task RefreshMessages()
    {
        _shouldBounce = false;
        _componentOpenedAt = DateTime.UtcNow; // Reset the timer when user refreshes
        InvalidateFilters();
        await LoadMessages();
        CheckBounceCondition();
        StateHasChanged();
    }

    private void ToggleAlarmDetails(AxoMessenger alarm)
    {
        var alarmId = alarm.GetHashCode();
        if (_expandedAlarmIds.Contains(alarmId))
        {
            _expandedAlarmIds.Remove(alarmId);
        }
        else
        {
            _expandedAlarmIds.Add(alarmId);
        }
        StateHasChanged();
    }
}
