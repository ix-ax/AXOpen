@namespace AXOpen.Core
@using AXOpen.Messaging
@using AXOpen.Messaging.Static
@using AXSharp.Connector.ValueTypes
@using AXSharp.Connector;
@using Operon.Components.Accordion
@using Operon.Components.Tab
@using System.Threading.Tasks
@inherits RenderableComplexComponentBase<AxoComponent>;

<div class="flux-card flux-card--elevated @AlarmBorderClass" style="margin: 0.75rem 0; width: 100%;">
    
    <!-- Header Section -->
    <div class="flux-flex flux-flex--between" style="align-items: center; margin-bottom: 0.75rem;">
        <h5 style="margin: 0; color: var(--text-primary); font-weight: 600; font-size: 1.125rem;">
            @Component.AttributeName
        </h5>
        
        @if (HasActiveAlarms)
        {
            <button class="flux-btn flux-btn--icon flux-btn--ghost @AlarmButtonClass" 
                    @onclick="ToggleAlarms"
                    title="@AlarmCount alarm(s) active">
                <span class="flux-badge @AlarmBadgeClass" style="position: relative;">
                    @AlarmCount
                    @if (HasCriticalAlarms)
                    {
                        <span style="position: absolute; top: -2px; right: -2px; width: 6px; height: 6px; background: #ef4444; border-radius: 50%; border: 1px solid var(--bg-tertiary);"></span>
                    }
                </span>
            </button>
        }
    </div>

    <!-- Alarms Panel (Collapsible) -->
    @if (_showAlarms && HasActiveAlarms && messageProvider?.Messengers != null)
    {
        <div class="flux-card" style="margin-bottom: 0.75rem; background: var(--bg-secondary); padding: 0.5rem;">
            @foreach (var alarm in messageProvider.Messengers)
            {            
                if (alarm.State != eAxoMessengerState.Idle)
                {
                    <div style="margin: 0.25rem 0; width: 100%;">
                        <AxoMessengerView Component="alarm" Class="w-full" />
                    </div>
                }
            }        
        </div>
    }

    <!-- Description -->
    @if (!string.IsNullOrEmpty(Component.Description_raw))
    {
        <div class="flux-text--muted" style="font-size: 0.875rem; margin-bottom: 0.75rem;">
            @Component.Description_raw
        </div>
    }

    <!-- Main Header Content (Centered) -->
    @if (@Component._isManuallyControllable.Cyclic)
    {
        currentPresentation = "Command-Control";
    }
    else
    {
        currentPresentation = "Status-Display";
    }
    
    <div style="width: 100%; display: flex; justify-content: center; align-items: center; margin: 1rem 0;">
        <RenderableContentControl Presentation="@currentPresentation" Context="@Header"/>
    </div>

    <!-- Details Section (Full Width) -->
    @if (DetailsTabs.Any())
    {
        <div style="width: 100%; margin-top: 1rem;">
            <Accordion>
                <AccordionItem Title="View Details">
                    <Tab>
                        @foreach (var detailsTab in DetailsTabs)
                        {
                            <TabPage Title="@detailsTab.HumanReadable">
                                <div style="width: 100%; padding: 0.75rem; background: transparent;">
                                    <RenderableContentControl Context=@detailsTab
                                                              Presentation="@currentPresentation"/>
                                </div>
                            </TabPage>
                        }
                    </Tab>
                    <p class="flux-text--muted" style="font-size: 0.75rem; margin-top: 0.5rem;">@Component.Symbol</p>
                </AccordionItem>
            </Accordion>
        </div>
    }
</div>

@code
{
    private AxoMessageProvider? messageProvider;
    private AxoObjectDiagnosticsView? diagnosticsViewRef;
    private bool _showAlarms = false;
    private int _previousAlarmCount = 0;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        
        // Auto-collapse alarm panel when all alarms are cleared
        if (_previousAlarmCount > 0 && AlarmCount == 0 && _showAlarms)
        {
            _showAlarms = false;
            StateHasChanged();
        }
        
        _previousAlarmCount = AlarmCount;
    }

    private void ToggleAlarms()
    {
        _showAlarms = !_showAlarms;
    }

    private bool HasActiveAlarms => AlarmCount > 0;

    private bool HasCriticalAlarms => this.AlarmLevel == eAlarmLevel.ActiveErrors;

    private int AlarmCount
    {
        get
        {
            if (messageProvider?.Messengers == null) return 0;
            return messageProvider.Messengers.Count(a => a.State != eAxoMessengerState.Idle);
        }
    }

    private string AlarmBorderClass
    {
        get
        {
            return this.AlarmLevel switch
            {
                eAlarmLevel.NoAlarms => "",
                eAlarmLevel.Unacknowledged => "flux-border--warning",
                eAlarmLevel.ActiveInfo => "flux-border--info",
                eAlarmLevel.ActiveWarnings => "flux-border--warning flux-shadow--glow-warning",
                eAlarmLevel.ActiveErrors => "flux-border--danger flux-shadow--glow-danger",
                _ => ""
            };
        }
    }

    private string AlarmButtonClass
    {
        get
        {
            return this.AlarmLevel switch
            {
                eAlarmLevel.ActiveErrors => "flux-pulse",
                eAlarmLevel.ActiveWarnings => "",
                _ => ""
            };
        }
    }

    private string AlarmBadgeClass
    {
        get
        {
            return this.AlarmLevel switch
            {
                eAlarmLevel.ActiveErrors => "flux-badge--danger",
                eAlarmLevel.ActiveWarnings => "flux-badge--warning",
                eAlarmLevel.ActiveInfo => "flux-badge--primary",
                eAlarmLevel.Unacknowledged => "flux-badge--warning",
                _ => "flux-badge"
            };
        }
    }
}