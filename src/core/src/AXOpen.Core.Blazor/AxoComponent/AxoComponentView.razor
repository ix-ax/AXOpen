@namespace AXOpen.Core
@using AXSharp.Connector.ValueTypes
@using AXSharp.Connector;
@using AXSharp.Presentation.Blazor.Controls.Layouts.TabControlComponents;
@using Operon.Components.Accordion
@inherits RenderableComplexComponentBase<AxoComponent>;




<div class="card flex-auto @BorderColorStatusClass">
    <div class="flex w-full">
        <Accordion>
            <AccordionItem Title="@Component.AttributeName">
                <AxoObjectDiagnosticsView ObservedObjects="new ITwinObject[] { this.Component }"></AxoObjectDiagnosticsView>
            </AccordionItem>
        </Accordion>
    </div>    
    <!--Header/Main/Basic controls-->
    <div>
        @if (@Component._isManuallyControllable.Cyclic)
        {
            currentPresentation = "Command-Control";
        }
        else
        {
            currentPresentation = "Status-Display";
        }
        <RenderableContentControl Presentation="@currentPresentation" Context="@Header"
                                  Class="w-full"
                                  LayoutClass="justify-center" /> 
    </div>
    <Accordion>
        <AccordionItem  Title="@this.Component.Symbol">
            <div class="">
                <TabControl>
                    @foreach (var detailsTab in DetailsTabs)
                    {
                        <TabPage Text="@detailsTab.HumanReadable">
                            <RenderableContentControl
                                Context=@detailsTab
                                Presentation="@currentPresentation"
                                Class="w-full"
                                LayoutClass="justify-center"
                                LayoutChildrenClass="ms-0"/>
                        </TabPage>
                    }
                </TabControl>
            </div>
        </AccordionItem>
    </Accordion>
</div>

@code
{
    private string BorderColorStatusClass
    {
        get
        {
            switch (this.AlarmLevel)
            {
                case eAlarmLevel.NoAlarms:
                    return "border-0 border-inactive-100 ";
                case eAlarmLevel.Unacknowledged:
                    return "border-1 border-attention-200";
                case eAlarmLevel.ActiveInfo:
                    return "border-1 border-attention-100 shadow-xl shadow-attention-500/50";
                case eAlarmLevel.ActiveWarnings:
                    return "border-1 border-warning-500 shadow-xl shadow-warning-500/50";
                case eAlarmLevel.ActiveErrors:
                    return "border-2 border-danger-500 shadow-xl shadow-danger-500/50";
                default:
                    return "border-0 border-inactive-100";
            }
        }
    }
}

