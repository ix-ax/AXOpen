@namespace AXOpen.Core
@using AXOpen.Messaging
@using AXOpen.Messaging.Static
@using AXSharp.Connector.ValueTypes
@using AXSharp.Connector;
@using Operon.Components.Accordion
@using Operon.Components.Tab
@using System.Threading.Tasks
@inherits RenderableComplexComponentBase<AxoComponent>;

<div class="card m-2 @AlarmBorderClass">
    
    <!-- Header Section -->
    <div class="card-title w-full flex flex-row justify-between">
        <h5>@Component.AttributeName</h5>
        
        @if (_alarmCount > 0)
        {
            <button class="badge @AlarmBadgeClass" @onclick="() => { _showAlarms = !_showAlarms; }" title="@_alarmCount @(_alarmCount != 1 ? "s" : "") active">
                @(_alarmCount > 0 ? $"{_alarmCount} Active Alarm{(_alarmCount != 1 ? "s" : "")}" : "No Alarms")
            </button>
        }
    </div>

    <!-- Alarms Panel (Collapsible) -->
    @if (_showAlarms && _alarmCount > 0 && messageProvider?.Messengers != null)
    {
        <div class="card m-2 p-2">
            @foreach (var alarm in messageProvider.Messengers)
            {
                if (alarm.State != eAxoMessengerState.Idle)
                {
                    <div class="w-full m-1">
                        <AxoMessengerView Component="alarm" Class="w-full" />
                    </div>
                }
            }        
        </div>
    }

    <!-- Description -->
    @if (!string.IsNullOrEmpty(Component.Description_raw))
    {
        <div class="text-sm text-text/60 m-2">
            @Component.Description_raw
        </div>
    }

    <!-- Main Header Content (Centered) -->
    @if (@Component._isManuallyControllable.Cyclic)
    {
        currentPresentation = "Command-Control";
    }
    else
    {
        currentPresentation = "Status-Display";
    }
    
    <div class="flex flex-wrap justify-center items-center w-full m-4">
        <RenderableContentControl Presentation="@currentPresentation" Context="@Header"/>
    </div>

    <!-- Details Section (Full Width) -->
    @if (DetailsTabs.Any())
    {
        <div class="w-full mt-4">
            <Accordion>
                <AccordionItem Title="View Details">
                    <Tab>
                        @foreach (var detailsTab in DetailsTabs)
                        {
                            <TabPage Title="@detailsTab.HumanReadable">
                                <div class="w-full p-2">
                                    <RenderableContentControl Context=@detailsTab
                                                              Presentation="@currentPresentation"/>
                                </div>
                            </TabPage>
                        }
                    </Tab>
                    <p class="text-sm text-text/60 m-2">@Component.Symbol</p>
                </AccordionItem>
            </Accordion>
        </div>
    }
</div>

@code
{
    private AxoMessageProvider? messageProvider;
    private bool _showAlarms = false;
    private int _previousAlarmCount = 0;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        // Auto-collapse alarm panel when all alarms are cleared
        if (_previousAlarmCount > 0 && _alarmCount == 0 && _showAlarms)
        {
            _showAlarms = false;
            StateHasChanged();
        }

        _previousAlarmCount = _alarmCount;
    }

    private int _alarmCount { get => messageProvider?.Messengers.Count(a => a.State != eAxoMessengerState.Idle) ?? 0; }

    private bool HasCriticalAlarms => this.AlarmLevel == eAlarmLevel.ActiveErrors;


    private string AlarmBorderClass
    {
        get
        {
            return this.AlarmLevel switch
            {
                eAlarmLevel.NoAlarms => "",
                eAlarmLevel.Unacknowledged => "border border-warning",
                eAlarmLevel.ActiveInfo => "border border-info",
                eAlarmLevel.ActiveWarnings => "border border-warning/20! shadow-glow-warning",
                eAlarmLevel.ActiveErrors => "border border-danger/20! shadow-glow-danger",
                _ => ""
            };
        }
    }

    private string AlarmBadgeClass
    {
        get
        {
            return this.AlarmLevel switch
            {
                eAlarmLevel.ActiveErrors => "animate-pulse-danger badge-danger",
                eAlarmLevel.ActiveWarnings => "badge-warning",
                eAlarmLevel.ActiveInfo => "badge-primary",
                eAlarmLevel.Unacknowledged => "badge-warning",
                _ => "badge-primary"
            };
        }
    }
}