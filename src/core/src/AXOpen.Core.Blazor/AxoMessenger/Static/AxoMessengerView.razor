@namespace AXOpen.Messaging.Static
@inherits RenderableComplexComponentBase<AxoMessenger>
@using System.Security.Principal
@implements IDisposable;

<div class="alarm-card @SeverityCss @StateCss @AcknowledgedCss @Class" style="@Style">
    <header class="alarm-card__header">
        <div class="alarm-card__legend">
            <span class="alarm-card__severity" aria-label="Severity">@SeverityLabel</span>
            @if (!string.IsNullOrWhiteSpace(Component.GetMessageText()))
            {
                <span class="alarm-card__code" aria-label="Alarm code">@Component.GetMessageText()</span>
            }
        </div>
        <div class="alarm-card__state" role="status">@StateLabel</div>
    </header>

    <section class="alarm-card__body">
        <h3 class="alarm-card__title">@Component.Message.LastValue</h3>
        @if (!string.IsNullOrWhiteSpace(Component.Message.LastValue))
        {
            <p class="alarm-card__message">@Component.Message.LastValue</p>
        }

        <dl class="alarm-card__facts">
            <div>
                <dt>Equipment</dt>
                <dd>@DisplayOrDash(Component.Component.AttributeName)</dd>
            </div>
            <div>
                <dt>Raised</dt>
                <dd>@FormatTimestamp(Component.Risen.LastValue)</dd>
            </div>
            <div>
                <dt>Acknowledged</dt>
                <dd>@FormatAcknowledged()</dd>
            </div>
            <div>
                <dt>Duration</dt>
                <dd>@FormatDuration()</dd>
            </div>
        </dl>
    </section>

    <footer class="alarm-card__footer">
        <button class="alarm-card__details-toggle" @onclick="ToggleDetails" title="@(IsDetailsExpanded ? "Hide details" : "Show details")" aria-expanded="@IsDetailsExpanded">
            <span class="alarm-card__expand-icon @(IsDetailsExpanded ? "expanded" : "")">▶</span> @(IsDetailsExpanded ? "HIDE DETAILS" : "SHOW DETAILS")
        </button>
        @if (Actions is not null)
        {
            <div class="alarm-card__actions">
                @Actions
            </div>
        }
        <button class="alarm-card__ack" @onclick="HandleAcknowledge" disabled="@(!CanAcknowledge)">@AcknowledgeLabelOrDefault</button>
    </footer>

    @if (IsDetailsExpanded)
    {
        <section class="alarm-card__details">
            <div class="alarm-card__details-grid">
                <div class="alarm-card__detail-item">
                    <dt>Suggestion</dt>
                    <dd>@DisplayOrDash(Component.GetHelpText())</dd>
                </div>
                <div class="alarm-card__detail-item">
                    <dt>Symbol</dt>
                    <dd>@DisplayOrDash(Component.Symbol)</dd>
                </div>
                <div class="alarm-card__detail-item">
                    <dt>Human Readable</dt>
                    <dd>@DisplayOrDash(Component.HumanReadable)</dd>
                </div>
                <div class="alarm-card__detail-item">
                    <dt>Alarm ID</dt>
                    <dd>@DisplayOrDash(Component.Identity.LastValue.ToString())</dd>
                </div>
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <div class="alarm-card__detail-item">
                            <dt>RESTORE</dt>
                            <button class="alarm-card__restore-btn" @onclick="RestoreParentTask">Restore</button>
                        </div>
                    </Authorized>
                </AuthorizeView>
                @if (AdditionalDetails is not null)
                {
                    @AdditionalDetails
                }
            </div>
        </section>
    }
</div>

@code {

    private async Task RestoreParentTask()
    {
        Component.RestoreParentTask(await this.GetCurrentUserIdentity());
    }

    [Parameter] public AxoMessenger? Alarm { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public string? Equipment { get; set; }
    [Parameter] public eAxoMessageCategory Severity { get; set; } = eAxoMessageCategory.Warning;
    [Parameter] public bool IsAcknowledged { get; set; }
    [Parameter] public DateTimeOffset? RaisedAt { get; set; }
    [Parameter] public DateTimeOffset? AcknowledgedAt { get; set; }
    [Parameter] public DateTimeOffset? ClearedAt { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback AcknowledgeRequested { get; set; }
    [Parameter] public string? AcknowledgeLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public RenderFragment? AdditionalDetails { get; set; }

    private bool IsDetailsExpanded { get; set; } = false;
   
    


    private static string ConvertToInternalSeverityName(eAxoMessageCategory category)
    {
        switch (category)
        {
            case eAxoMessageCategory.Info:
                return "info";
            case eAxoMessageCategory.Warning:
                return "warning";
            case eAxoMessageCategory.Error:
                return "minor";
            case eAxoMessageCategory.ProgrammingError:
                return "major";
            case eAxoMessageCategory.Critical:
                return "critical";

        }

        return string.Empty;
    }
    private string SeverityCss => $"severity-{ConvertToInternalSeverityName((eAxoMessageCategory)Component.Category.LastValue)}";
    private string StateCss => Component.IsActive ? "state-active" : "state-cleared";
    private string AcknowledgedCss => Component.IsAcknowledged ? "state-acknowledged" : string.Empty;
    private string SeverityLabel => (eAxoMessageCategory)Component.Category.LastValue switch
    {
        eAxoMessageCategory.Info => "Info",
        eAxoMessageCategory.Warning => "Warning",
        eAxoMessageCategory.Error => "Minor Fault",
        eAxoMessageCategory.ProgrammingError => "Major Fault",
        eAxoMessageCategory.Critical => "Critical",
        _ => "Unknown"
    };

    private string StateLabel => Component.IsActive
        ? (Component.IsAcknowledged ? "Active · Acknowledged" : "Active · Unacknowledged")
        : "Cleared";

    private bool CanAcknowledge => Component.IsActive || !Component.IsAcknowledged;
    private string AcknowledgeLabelOrDefault => string.IsNullOrWhiteSpace(AcknowledgeLabel) ? "Acknowledge" : AcknowledgeLabel;

    private async Task HandleAcknowledge()
    {
        if (AcknowledgeRequested.HasDelegate)
        {
            await AcknowledgeRequested.InvokeAsync();
        }
        Component.Acknowledge(await GetCurrentUserIdentity());
    }

    private static string DisplayOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatTimestamp(DateTime? timestamp)
    {
        return timestamp?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) ?? "—";
    }

    private string FormatAcknowledged()
    {
        if (!Component.IsAcknowledged)
        {
            return (eAxoMessengerState)Component.MessengerState.LastValue == eAxoMessengerState.ActiveAcknowledgeRequired ? "Pending" : "Not Required";
        }

        return Component.Risen.LastValue.Equals(DateTime.MinValue)
            ? "Acknowledged"
            : FormatTimestamp(Component.Risen.LastValue);
    }

    private string FormatDuration()
    {
        if (Component.Risen.LastValue.Equals(DateTime.MinValue))
        {
            return "—";
        }

        var start = Component.Risen.LastValue;
        var end = Component.IsActive
            ? DateTime.UtcNow
            : Component.Acknowledged.LastValue;

        if (end < start)
        {
            return "—";
        }

        var duration = end - start;
        return duration switch
        {
            { TotalMinutes: < 1 } => "< 1 min",
            { TotalHours: < 1 } => $"{(int)duration.TotalMinutes} min",
            { TotalDays: < 1 } => $"{duration.TotalHours:F1} h",
            _ => $"{duration.TotalDays:F1} d"
        };
    }

    private void ToggleDetails()
    {
        IsDetailsExpanded = !IsDetailsExpanded;
        StateHasChanged();
    }
}