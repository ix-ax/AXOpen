@namespace AXOpen.Components.Keyence.Vision
@using AXOpen.Core
@using AXOpen.Core.Blazor
@using System.Net.Http
@using System.Text.RegularExpressions
@inject IHttpClientFactory HttpClientFactory
@inherits AxoComponentViewBase<Axo_IV3>

<div class="flex flex-col gap-4 p-4 border rounded-lg bg-background/70" style="width: 100%;">
    @if (!string.IsNullOrEmpty(@GetLiveViewUrl))
    {
        <div style="width: 100%; aspect-ratio: 4/3; overflow: hidden; pointer-events: none;">
            <iframe src="@GetLiveViewUrl"
                    style="width:100%; height:100%; border:none; pointer-events: none;"
                    scrolling="no"
                    loading="lazy"
                    title="External site">
            </iframe>
        </div>     
    }
    else if (_isLoading)
    {
        <div style="width: 100%; aspect-ratio: 4/3; display:flex; align-items:center; justify-content:center;">
            <p>Loading...</p>
        </div>
    }
    else
    {
        <div style="width: 100%; aspect-ratio: 4/3; display:flex; align-items:center; justify-content:center;">
            <p>Failed to load content</p>
        </div>
    }
</div>

@code
{
    private bool _isLoading = true;
    private string GetLiveViewUrl => $"/{Component.Proxy}/iv3-wm-i.html";

    public override void ConfigurePolling()
    {
        
    }
}