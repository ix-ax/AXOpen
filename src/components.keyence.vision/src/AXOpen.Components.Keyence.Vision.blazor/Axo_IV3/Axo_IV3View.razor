@namespace AXOpen.Components.Keyence.Vision
@using AXOpen.Components.Keyence.Vision
@using AXOpen.Core
@using AXOpen.Messaging
@using AXOpen.Messaging.Static
@using AXSharp.Presentation.Blazor.Controls
@using AXSharp.Presentation.Blazor.Controls.RenderableContent
@inherits RenderableComplexComponentBase<AXOpen.Components.Keyence.Vision.Axo_IV3>
<div data-axo-component-view
     class="relative"
     @onmouseenter="BringToForeGround"
     @onmouseleave="BringToZIndexBack">
@if (DisplayMode >= eDisplayMode.Spot)
{
    <div class="flex flex-col gap-2 p-0 @AlarmBackgroundClass rounded-lg @AlarmBorderClass"
         @onclick="async () => await OpenDetails()">
        <div class="self-center w-full">
            <button type="button" @onclick="ToggleSpotMode" class="w-full text-left">
                <div class="flex flex-col gap-4 p-4 rounded-lg w-full">
                    <div class="flex items-center justify-between gap-2 text-xs uppercase tracking-wide text-text/70">
                       @*  <span>@Component.AttributeName</span> *@
                        @* <span>Program @CurrentProgramNumber</span> *@
                    </div>
                        <div class="iv3-hero-block self-center">
                            <div class="iv3-hero"
                                data-busy="@(IsBusy ? "true" : "false")"
                                data-warning="@(HasWarning ? "true" : "false")"
                                data-error="@(HasError ? "true" : "false")">
                            <div class="iv3-hero__camera">
                                <div class="iv3-hero__body">
                                    <div class="iv3-hero__lens">
                                        <div class="iv3-hero__scan @(IsScanning ? "active" : string.Empty)"></div>
                                        <div class="iv3-hero__pulse @(IsScanning ? "active" : string.Empty)"></div>
                                        <div class="iv3-hero__result @(LastResultOk ? "ok" : LastResultNg ? "ng" : string.Empty)">
                                            @(LastResultOk ? "OK" : LastResultNg ? "NG" : "—")
                                        </div>
                                    </div>
                                </div>                              
                            </div>                           
                        </div>
                    </div>
                </div>
            </button>
        </div>
    </div>
}

@if (DisplayMode != eDisplayMode.Spot)
{
    <div class="flex flex-col gap-4 p-4 border rounded-lg bg-background/70 @AlarmBorderClass">
        @if (DisplayMode >= eDisplayMode.Basic)
        {
            <div @onclick="ToggleAdvancedMode"
                 class="flex items-center justify-between border-b border-border pb-2 cursor-pointer hover:bg-background/20 transition-colors rounded px-2 -mx-2 select-none">
                <div class="flex items-center gap-2">
                    <span class="text-xs">@(ShowAnimationPanel ? "▼" : "▶")</span>
                    <h4 class="text-lg font-semibold text-text">@Component.AttributeName</h4>
                </div>
                <div class="flex items-center gap-2" @onclick:stopPropagation="true">
                    <span class="badge @(HasResult ? "badge-success" : "badge-primary")">
                        @(HasResult ? "New result" : "Waiting")
                    </span>
                    <span class="badge @(LastResultOk ? "badge-success" : LastResultNg ? "badge-danger" : "badge-outline")">
                        @(LastResultOk ? "OK" : LastResultNg ? "NG" : "---")
                    </span>
                    @if (HasActiveMessages)
                    {
                        <button type="button"
                                @onclick="ToggleMessages"
                                class="badge @AlarmBadgeClass"
                                title="@ActiveAlarmCount @(ActiveAlarmCount != 1 ? "alarms" : "alarm") active">
                            @ActiveAlarmCount Active Alarm@(ActiveAlarmCount != 1 ? "s" : string.Empty)
                        </button>
                    }
                    <button type="button"
                            @onclick="ToggleServiceView"
                            class="badge badge-primary"
                            title="Toggle service view">
                        @(DisplayMode >= eDisplayMode.Raw ? "Normal" : "Service")
                    </button>
                </div>
            </div>

            @if (ShowMessages && _alarmCount > 0 && _messageProvider?.Messengers != null)
            {
                <div class="flex flex-col gap-2 border-t border-border pt-2">
                    @foreach (var alarm in _messageProvider.Messengers)
                    {
                        if (alarm.State != eAxoMessengerState.Idle)
                        {
                            <AxoMessengerView Component="alarm" />
                        }
                    }
                </div>
            }
        }       

        @if (DisplayMode == eDisplayMode.Advanced)
        {
            <div class="grid gap-4 md:grid-rows-2">
                <div class="space-y-2 self-center">
                    <div class="flex items-center justify-between text-sm text-text/80">
                        <span>Cycle progress</span>
                        <span>@ProgressPercentage%</span>
                    </div>
                    <div class="h-2 bg-border/40 rounded-full overflow-hidden">
                        <div class="h-full bg-primary transition-all duration-500" style="width:@($"{ProgressPercentage}%")"></div>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2 text-xs">
                    <span class="@GetStatusChipClass(IsReady, "success")">Ready</span>
                    <span class="@GetStatusChipClass(IsBusy, "busy")">Busy</span>
                    <span class="@GetStatusChipClass(IsImaging, "info")">Imaging</span>
                    <span class="@GetStatusChipClass(TriggerReady, "primary")">Trigger ready</span>
                    <span class="@GetStatusChipClass(HasWarning, "warning")">Warning</span>
                    <span class="@GetStatusChipClass(HasError, "error")">Error</span>
                    <span class="@GetStatusChipClass(HasResult, "success")">Result available</span>
                </div>
            </div>

            <div class="grid gap-3 md:grid-cols-2">
                <AxoTaskView class="w-full"
                                    Text="Trigger"
                                    Component="Component.TriggerTask"
                                    HideRestoreButton="false"
                                 Enabled="@(Component._isManuallyControllable.Cyclic)" />
                        <AxoTaskView class="w-full"
                                  Text="Restore"
                                  Component="Component.RestoreTask"
                                  HideRestoreButton="false"
                                   Enabled="@(Component._isManuallyControllable.Cyclic)" />
            </div>

            <div class="grid gap-4 md:grid-cols-1">
                <div class="p-4 rounded-lg border border-border flex flex-col gap-3">
                    <div class="flex items-center justify-between">
                        <h5 class="text-base font-semibold text-text">Program control</h5>
                        <span class="text-xs text-text/60">Current @CurrentProgramNumber</span>
                    </div>
                    <RenderableContentControl Context="Component.RequiredProgramNumber"
                                              Presentation="Control" />
                        <AxoTaskView class="w-full"
                                     Text="Change Program"
                                     Component="Component.ChangeProgramTask"
                                     HideRestoreButton="false"
                                     Enabled="@(Component._isManuallyControllable.Cyclic)" />
                    <div class="grid grid-cols-2 gap-2 text-sm">
                        <div>
                            <span class="text-text/60">Result No.</span>
                            <div class="font-semibold text-text">@Component.Inputs.DeviceStatusWords.ResultNo.Cyclic</div>
                        </div>
                        <div>
                            <span class="text-text/60">Program during shot</span>
                            <div class="font-semibold text-text">@Component.Inputs.DeviceStatusWords.ProgramNoDuringJudgment.Cyclic</div>
                        </div>
                    </div>
                </div>               
            </div>                     
        }

        @if (DisplayMode == eDisplayMode.Raw)
        {
            <AxoComponentView Component="Component"
                              HideHeader="true"
                              IsControllable="true" />
        }
    </div>
}
</div>
