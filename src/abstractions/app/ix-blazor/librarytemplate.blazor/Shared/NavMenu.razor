@using Operon.Icons
@inject NavigationManager NavigationManager
@implements IDisposable

<button class="btn btn-no-bg-primary w-full md:hidden!" @onclick="ToggleNavMenu">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mx-auto">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
    </svg>
</button>

@if (!_navCollapsed)
{
    <nav class="nav w-full md:w-64">
        <NavLink href="" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            Home
        </NavLink>
        <NavLink href="Testing" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            Testing
        </NavLink>
        <NavLink href="Documentation" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            Documentation
        </NavLink>
        <NavLink href="Security" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            Security
        </NavLink>
    </nav>
}

<div class="fixed bottom-0 right-0 hidden md:block w-64">
    <button class="btn btn-no-bg-primary w-full" @onclick="ToggleNavMenu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mx-auto">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
        </svg>
    </button>

    <a href="">
        <img src="logo-header.svg" width="100%" />
    </a>
</div>

@code {
    private bool _navCollapsed = false;

    public void ToggleNavMenu() => _navCollapsed = !_navCollapsed;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navCollapsed = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
