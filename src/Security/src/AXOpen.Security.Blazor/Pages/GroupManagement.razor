@using AxOpen.Security
@using AxOpen.Security.Entities
@using AxOpen.Security.Services
@using Operon.Components
@using Operon.Components.Toast
@using System.Security.Principal
@inject AuthenticationStateProvider _authenticationStateProvider
@inject IRepositoryService _repositoryService
@inject IToastService _toastService

<div class="flex flex-wrap">
    <Operon.Components.BaseInput @bind-Value="newGroupName" Placeholder="@Localizer["Group name"]" />
    <button type="button" class="btn btn-primary" @onclick="CreateGroup">@Localizer["Create"]</button>
</div>

<div class="overflow-x-auto">
    <table class="table table-hover table-striped w-full">
        <thead>
            <tr>
                <th>@Localizer["Group name"]</th>
                <th>@Localizer["Created"]</th>
                <th>@Localizer["Modified"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in _roleGroupManager.GetAllGroup())
            {
                <tr @onclick="@(() => GroupClicked(group))" class="cursor-pointer @((SelectedGroup != null) ? ((SelectedGroup.Name == group.Name) ? "active" : "") : "")">
                    <th>@group.Name</th>
                    <th>@group.Created</th>
                    <th>@group.Modified</th>
                </tr>
            }
        </tbody>
    </table>
</div>

<Modal @ref="_modalEdit">
    <div class="modal-header">
        <h4>@Localizer["Group"]: @SelectedGroup?.Name</h4>
        <button type="button" class="cursor-pointer ms-auto my-auto" @onclick="() => _modalEdit?.CloseModal()">
            <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
        </button>
    </div>
    <div class="modal-body flex flex-wrap flex-row justify-center">
        <div class="grow-1 min-vh-40 me-4">
            <h5>@Localizer["Available roles:"]</h5>
            <BaseInput @bind-Value="SelectAllAvailable" Label="@Localizer["Select all"]" />

            <div class="">
                @if (AvailableRoles != null)
                {
                    <div class="p-2">
                        @foreach (var role in AvailableRoles)
                        {
                            <BaseInput @bind-Value="role.IsSelected" Label="@role.Role.Name" />
                        }
                    </div>
                }
            </div>
        </div>
        <div class="flex flex-col w-16">
            <button class="btn btn-primary m-1" @onclick="@(() => AssignRoles())">
                <Operon.Icons.HeroIcon Icon="arrow-right" Type="Operon.Icons.IconType.Outline" Class="size-4" />
            </button>
            <button class="btn btn-primary m-1" @onclick="@(() => ReturnRoles())">
                <Operon.Icons.HeroIcon Icon="arrow-left" Type="Operon.Icons.IconType.Outline" Class="size-4" />
            </button>
        </div>
        <div class="grow-1 min-vh-40 ms-4">
            <h5>@Localizer["Assigned roles:"]</h5>
            <BaseInput @bind-Value="SelectAllAssigned" Label="@Localizer["Select all"]" />

            <div class="">
                @if (AssignedRoles != null)
                {
                    <div class="p-2">
                        @foreach (var role in AssignedRoles)
                        {
                            <BaseInput @bind-Value="role.IsSelected" Label="@role.Role.Name" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="modal-footer flex justify-end gap-1">
        <button type="button" class="btn btn-danger" @onclick="() => _modalDelete?.Toggle()">@Localizer["Delete"]</button>
        <button type="button" class="btn btn-secondary" @onclick="() => _modalEdit?.CloseModal()">@Localizer["Close"]</button>
    </div>
</Modal>

<Modal @ref="_modalDelete">
    <div class="modal-header">
        <h4>@Localizer["Delete group"]</h4>
        <button type="button" class="cursor-pointer ms-auto my-auto" @onclick="() => _modalDelete?.CloseModal()">
            <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
        </button>
    </div>
    <div class="modal-body">
        <h6>@Localizer["Do you want to delete group"] @SelectedGroup?.Name</h6>
    </div>
    <div class="modal-footer flex justify-end gap-1">
        <button type="button" class="btn btn-secondary" @onclick="() => _modalDelete?.CloseModal()">@Localizer["Close"]</button>
        <button type="button" class="btn btn-danger" @onclick="@(async () => { _modalDelete?.CloseModal(); _modalEdit?.CloseModal(); await DeleteGroupAsync(SelectedGroup); })">@Localizer["Delete"]</button>
    </div>
</Modal>

@code{
    private Modal? _modalEdit { get; set; }

    private Modal? _modalDelete { get; set; }

    private string newGroupName { get; set; } = string.Empty;

    public Group? SelectedGroup { get; set; }

    private IList<RoleData> AssignedRoles { get; set; }
    private IList<RoleData> AvailableRoles { get; set; }

    private bool selectAllAvailable;

    public bool SelectAllAvailable
    {
        get { return selectAllAvailable; }
        set
        {
            selectAllAvailable = value;
            foreach (RoleData role in AvailableRoles)
            {
                role.IsSelected = selectAllAvailable;
            }
        }
    }

    private bool selectAllAssigned;

    public bool SelectAllAssigned
    {
        get { return selectAllAssigned; }
        set
        {
            selectAllAssigned = value;
            foreach (RoleData role in AssignedRoles)
            {
                role.IsSelected = selectAllAssigned;
            }
        }
    }

    private RoleGroupManager _roleGroupManager
    {
        get
        {
            return _repositoryService.RoleGroupManager;
        }
    }

    public async void CreateGroup()
    {
        if (newGroupName == null || newGroupName == "")
        {
            _toastService?.AddToast(eToastType.Warning, Localizer["Wrong name!"], Localizer["Wrong group name"], 10);

            return;
        }
        var result = _roleGroupManager.CreateGroup(newGroupName);
        if (result.Succeeded)
        {
            string msg = Localizer["Group \"{0}\" successfully created!", newGroupName];

            _toastService?.AddToast(eToastType.Success, Localizer["Created!"], msg, 10);
            AxoApplication.Current.Logger.Information(msg, await GetCurrentIdentity());
        }
        else
        {
            string msg = Localizer["Group \"{0}\" was not created!", newGroupName] + $" {result.ToString()}";

            _toastService?.AddToast(eToastType.Warning, Localizer["Not created!"], msg, 10);
            AxoApplication.Current.Logger.Warning(msg, await GetCurrentIdentity());
        }
        StateHasChanged();
    }

    public void GroupClicked(Group group)
    {
        SelectedGroup = group;
        AssignedRoles = _roleGroupManager.GetRolesFromGroup(group.Name).Select(x => new RoleData(_roleGroupManager.inAppRoleCollection.Where(x1 => x1.Name == x).FirstOrDefault())).ToList();
        AvailableRoles = _roleGroupManager.inAppRoleCollection.Where(x => !AssignedRoles.Select(x => x.Role.Name).Contains(x.Name)).Select(x => new RoleData(x)).ToList();

        _modalEdit?.Toggle();

        StateHasChanged();
    }

    public async void AssignRoles()
    {
        var result = _roleGroupManager.AddRolesToGroup(SelectedGroup.Name, AvailableRoles.Where(x => x.IsSelected == true).Select(x => x.Role.Name));
        if (result.Succeeded)
        {
            string msg = Localizer["Group \"{0}\" successfully updated.", SelectedGroup.Name];

            _toastService?.AddToast(eToastType.Success, Localizer["Updated!"], msg, 10);
            AxoApplication.Current.Logger.Information(msg, await GetCurrentIdentity());
        }
        else
        {
            string msg = Localizer["Group \"{0}\" was not updated!", SelectedGroup.Name] + $" {result.ToString()}";

            _toastService?.AddToast(eToastType.Warning, Localizer["Not updated!"], msg, 10);
            AxoApplication.Current.Logger.Warning(msg, await GetCurrentIdentity());
        }

        for (int i = 0; i < AvailableRoles.Count(); i++)
        {
            if(AvailableRoles[i].IsSelected)
            {
                AssignedRoles.Add(AvailableRoles[i]);
                AvailableRoles.RemoveAt(i);
                i--;
            }
        }
        SelectAllAvailable = false;
    }

    public async void ReturnRoles()
    {
        var result = _roleGroupManager.RemoveRolesFromGroup(SelectedGroup.Name, AssignedRoles.Where(x => x.IsSelected == true).Select(x => x.Role.Name));
        if (result.Succeeded)
        {
            string msg = Localizer["Group \"{0}\" successfully updated.", SelectedGroup.Name];

            _toastService?.AddToast(eToastType.Success, Localizer["Updated!"], msg, 10);
            AxoApplication.Current.Logger.Information(msg, await GetCurrentIdentity());
        }
        else
        {
            string msg = Localizer["Group \"{0}\" was not updated!", SelectedGroup.Name] + $" {result.ToString()}";
            _toastService?.AddToast(eToastType.Warning, Localizer["Not updated!"], msg, 10);
            AxoApplication.Current.Logger.Warning(msg, await GetCurrentIdentity());
        }

        for (int i = 0; i < AssignedRoles.Count(); i++)
        {
            if (AssignedRoles[i].IsSelected)
            {
                AvailableRoles.Add(AssignedRoles[i]);
                AssignedRoles.RemoveAt(i);
                i--;
            }
        }
        SelectAllAssigned = false;
    }

    public async Task DeleteGroupAsync(Group group)
    {
        SelectedGroup = null;
        var result = _roleGroupManager.DeleteGroup(group.Name);

        if (result.Succeeded)
        {
            string msg = Localizer["Group \"{0}\" successfully deleted!", group.Name];

            _toastService?.AddToast(eToastType.Success, Localizer["Deleted!"], Localizer["Group successfully deleted"], 10);
            AxoApplication.Current.Logger.Information(msg, await GetCurrentIdentity());
        }
        else
        {
            string msg = Localizer["Group \"{0}\" was not deleted!", group.Name] + $" {result.ToString()}";

            _toastService?.AddToast(eToastType.Warning, Localizer["Not deleted!"], msg, 10);
            AxoApplication.Current.Logger.Information(msg, await GetCurrentIdentity());
        }
        StateHasChanged();
    }

    protected async Task<IIdentity> GetCurrentIdentity()
    {
        if (_authenticationStateProvider == null)
        {
            return new GenericIdentity("Unknown");
        }
        else
        {
            var context = await _authenticationStateProvider.GetAuthenticationStateAsync();

            if (context != null)
            {
                return context.User.Identity;
            }
            else return new GenericIdentity("Unknown");
        }
    }

    private class RoleData
    {
        public RoleData(Role role)
        {
            Role = role;
        }

        public Role Role { get; set; }
        public bool IsSelected { get; set; }
    }
}