@page
@using AXOpen.Security.Services
@using AxOpen.Security.Services
@using Microsoft.AspNetCore.Identity
@using AxOpen.Security.Entities
@using System.Text
@using Operon.Components.Toast

@attribute [IgnoreAntiforgeryToken]
@inject ExternalLoginService _externalLoginService
@inject IToastService _toastService

@functions {
    public async Task<IActionResult> OnPost([FromForm] string? externalAuthId)
    {
        string? result = await _externalLoginService.LoginAsync(externalAuthId);
        if(result == null)
            _toastService?.AddToast(eToastType.Danger, "Login", "User was successfully logged in!", 10);
        else
            _toastService?.AddToast(eToastType.Danger, "Login failed!", result, 10);

        return Redirect("~/");
    }
}
