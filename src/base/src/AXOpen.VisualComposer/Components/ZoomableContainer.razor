@if (Parent!.CurrentView.AllowZoomingAndPanning)
{
    <div onwheel="event.preventDefault()" class="m-0 p-0 w-full">
        <div @onpointermove="MoveAsync"
             @onpointerdown="Down"
             @onpointerup="Up"
             @onpointerleave="Leave"
             @onwheel="WheelAsync"
             style="overflow: hidden; background-color: @(Parent.CurrentView.BackgroundColor);">
            <div style="position: relative; transform: scale(@(Parent!.CurrentView.Scale.ToString().Replace(',', '.'))) translate(@(Parent!.CurrentView.TranslateX.ToString().Replace(',', '.'))%, @(Parent!.CurrentView.TranslateY.ToString().Replace(',', '.'))%);">
                @ChildContent
            </div>
        </div>
    </div>
}
else
{
    <div class="m-0 p-0">
        <div @onpointermove="MoveAsync"
             @onpointerdown="Down"
             @onpointerup="Up"
             @onpointerleave="Leave"
             @onwheel="WheelAsync"
             style="overflow: hidden; background-color: @(Parent.CurrentView.BackgroundColor);">
            <div style="position: relative; transform: scale(@(Parent!.CurrentView.Scale.ToString().Replace(',', '.'))) translate(@(Parent!.CurrentView.TranslateX.ToString().Replace(',', '.'))%, @(Parent!.CurrentView.TranslateY.ToString().Replace(',', '.'))%);">
                @ChildContent
            </div>
        </div>
    </div>
}
