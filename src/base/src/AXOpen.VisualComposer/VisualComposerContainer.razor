@using AXSharp.Connector;
@using Microsoft.AspNetCore.Components.Forms;
@using KristofferStrube.Blazor.SVGEditor
@using Operon.Components
@using Operon.Components.Accordion

<link href="_content/BlazorColorPicker/colorpicker.css" rel="stylesheet" />
<link href="_content/Blazor.ContextMenu/blazorContextMenu.min.css" rel="stylesheet" />
<link href="_content/AXOpen.KristofferStrube.Blazor.SVGEditor/kristofferStrubeBlazorSVGEditor.css" rel="stylesheet" />

<div class="container">
    <div class="row">
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <a class="cursor-pointer" @onclick="ToggleInDesignMode">
                    <Operon.Icons.HeroIcon Icon="adjustments-horizontal" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </a>
                @if (InDesignMode)
                {
                    <div class="flex justify-end my-2">
                        <div class="z-100">
                            <select class="select min-w-6" @onchange="(ChangeEventArgs args) => LoadAsync(args.Value.ToString())">
                                @foreach (var item in GetAllFiles())
                                {
                                    <option value="@item" selected="@(CurrentView is null || CurrentView == "" ? item == DefaultView ? "selected" : null : item == CurrentView ? "selected" : null)">@item</option>
                                }
                            </select>
                        </div>

                        <div class="dropdown z-100">
                            @code {
                                private bool _optionDropdownCollapsed = true;
                                private bool _modalControllerObjectsOpen = false;
                                private bool _modalUsedObjectOpen = false;
                                private bool _modalCreateNewOpen = false;
                                private bool _modalCreateCopyOpen = false;
                                private bool _modalViewsOpen = false;
                                private bool _modalBackgroundOpen = false;
                                private bool _modalBackgroundSVGInputOpen = false;
                            }
                            <button class="btn btn-primary" @onclick="() => _optionDropdownCollapsed = !_optionDropdownCollapsed">
                                Options
                                <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 collapse-button-icon " + (_optionDropdownCollapsed ? "open" : null))" />
                            </button>
                            @if (!_optionDropdownCollapsed)
                            {
                                <div class="dropdown-body-end card">
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => _modalControllerObjectsOpen = !_modalControllerObjectsOpen">Controller objects</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => _modalUsedObjectOpen = !_modalUsedObjectOpen">Used objects</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => _modalCreateNewOpen = !_modalCreateNewOpen">Create new</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => _modalCreateCopyOpen = !_modalCreateCopyOpen">Create copy</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => _modalViewsOpen = !_modalViewsOpen">Views</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => _modalBackgroundOpen = !_modalBackgroundOpen">Background</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => EditSVG = !EditSVG">Toggle Edit SVG</a>
                                    @if (EditSVG)
                                    {
                                        <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => _modalBackgroundSVGInputOpen = !_modalBackgroundSVGInputOpen">Background SVG Input</a>
                                    }
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick="() => ChangeThemeAsync()">Change theme</a>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <nav class="flex flex-wrap flex-col sm:flex-row">
                        @foreach (var item in Views)
                        {
                            <button class="tab @(CurrentView is null || CurrentView == "" ? item == DefaultView ? "tab-active" : null : item == CurrentView ? "tab-active" : null)" @onclick="() => LoadAsync(item)">@item</button>
                        }
                    </nav>
                }

                @if (InDesignMode && EditSVG)
                {
                    <div class="relative overflow-hidden m-0 p-0">
                        <div id="@_backgroundId" style="width: 100%; height: @((BackgroundHeight / BackgroundWidth) * ElementSize.Width)px;">
                            <SVGEditor BackgroundTransparent="true" ViewBox="@("0 0 " + BackgroundWidth + " " + BackgroundHeight)" Input=@BackgroundSVGInput InputUpdated="(string s) => { BackgroundSVGInput = s; SaveAsync(); }" DisableZoom="true" DisablePanning="true" DisableScaleLabel="true" BackgroundWidth="BackgroundWidth" BackgroundHeight="BackgroundHeight" ElementWidth="ElementSize.Width" ElementHeight="(BackgroundHeight / BackgroundWidth) * ElementSize.Width" />
                        </div>

                        <CascadingValue Value="@this" Name="Parent" IsFixed="true">
                            @foreach (VisualComposerItemData child in _children)
                            {
                                <VisualComposerItem InDesign="false" Origin="@child" />
                            }
                            @if (ImgSrc != null && ImgSrc != "")
                            {
                                <div style="position: absolute; left: 0; top: 0; width: 100%; z-index: -1;">
                                    <img src="@ImgSrc" style="width: 100%; height: 100%;" />
                                </div>
                            }
                        </CascadingValue>
                    </div>
                }
                else
                {
                    <div onpointermove="event.preventDefault()"
                         onpointerleave="event.preventDefault()">
                        <div @onpointermove="Move"
                             @onpointerleave="Leave">
                            <ZoomableContainer Parent="this" Disable="!AllowZoomingAndPanning">
                                <div id="@_backgroundId" style="width: 100%; height: @((BackgroundHeight / BackgroundWidth) * ElementSize.Width)px;">
                                    <svg width="100%" height="100%" viewBox="0 0 @(BackgroundWidth) @(BackgroundHeight)">@(new MarkupString(BackgroundSVGInput))</svg>
                                </div>

                                <CascadingValue Value="@this" Name="Parent" IsFixed="true">
                                    @foreach (VisualComposerItemData child in _children)
                                    {
                                        <VisualComposerItem InDesign="@InDesignMode" Origin="@child" />
                                    }
                                    @if (ImgSrc != null && ImgSrc != "")
                                    {
                                        <div style="position: absolute; left: 0; top: 0; width: 100%; z-index: -1;">
                                            <img src="@ImgSrc" style="width: 100%; height: 100%;" />
                                        </div>
                                    }
                                </CascadingValue>
                            </ZoomableContainer>
                        </div>
                    </div>
                }

                <CascadingValue Value="@this" Name="Parent" IsFixed="true">
                    @foreach (VisualComposerItemData child in _children)
                    {
                        <VisualComposerItemModal Origin="@child" />
                    }
                </CascadingValue>

                @if (InDesignMode)
                {
                    <Modal @bind-Value="_modalControllerObjectsOpen">
                        <div class="card w-120">
                            <div class="flex mb-4">
                                <h2 class="text-xl font-bold">Controller objects</h2>
                                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalControllerObjectsOpen = false">
                                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                                </button>
                            </div>
                            <div class="flex">
                                <div class="input">
                                    <input type="text" placeholder="Search" @bind="SearchValue" />
                                </div>
                                <button type="button" class="btn btn-primary" @onclick="() => Search()">Search</button>
                            </div>
                            @if (SearchValue is null || SearchResult is null)
                            {
                                <div class="accordion" id="accordionExample">
                                    @foreach (var item in Objects)
                                    {
                                        <AccordionComponent SourceTwinElement="@item" Parent="@this" />
                                    }
                                </div>
                            }
                            else
                            {
                                <ul class="list-group">
                                    @foreach (var item in SearchResult)
                                    {
                                        <li class="list-group-item d-flex">
                                            @switch (item)
                                            {
                                                case ITwinObject obj:
                                                    <Operon.Icons.HeroIcon Icon="cube" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                                    break;
                                                case ITwinPrimitive prim:
                                                    <Operon.Icons.HeroIcon Icon="credit-card" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                                    break;
                                            }

                                            <p class="mb-0 truncate">@item.Symbol</p>
                                            <a class="ms-auto cursor-pointer" @onclick="() => AddChildrenAsync(item)">
                                                <Operon.Icons.HeroIcon Icon="plus" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </Modal>

                    <Modal @bind-Value="_modalUsedObjectOpen">
                        <div class="card w-120">
                            <div class="flex mb-4">
                                <h2 class="text-xl font-bold">Used components</h2>
                                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalUsedObjectOpen = false">
                                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                                </button>
                            </div>
                            <ul class="list-group">
                                @foreach (VisualComposerItemData child in _children)
                                {
                                    <li class="list-group-item flex">
                                        <p>@child.IdPlain</p>
                                        <a class="ms-auto cursor-pointer" @onclick="() => RemoveChildrenAsync(child)">
                                            <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                        </a>
                                        <a class="mx-2 cursor-pointer" data-bs-target="#settings-@child.Id.Replace('.', '_')-@child.UniqueGuid">
                                            <Operon.Icons.HeroIcon Icon="pencil-square" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </Modal>

                    <Modal @bind-Value="_modalCreateNewOpen">
                        <div class="card w-120">
                            <div class="flex mb-4">
                                <h2 class="text-xl font-bold">Create new</h2>
                                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalCreateNewOpen = false">
                                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                                </button>
                            </div>
                            <BaseInput @bind-Value="FileName" Label="Name" />
                            <div class="ms-auto">
                                <button type="button" class="btn btn-primary" @onclick="async () => { _modalCreateNewOpen = false; await CreateNewAsync(FileName); }">Create</button>
                                <button class="btn btn-outline-red" @onclick="() => _modalCreateNewOpen = false">Close</button>
                            </div>
                        </div>
                    </Modal>

                    <Modal @bind-Value="_modalCreateCopyOpen">
                        <div class="card w-120">
                            <div class="flex mb-4">
                                <h2 class="text-xl font-bold">Create copy</h2>
                                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalCreateCopyOpen = false">
                                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                                </button>
                            </div>
                            <BaseInput @bind-Value="FileName" Label="Name" />
                            <div class="ms-auto">
                                <button type="button" class="btn btn-primary" @onclick="async () => { _modalCreateCopyOpen = false; await CreateCopyAsync(FileName); }">Create</button>
                                <button class="btn btn-outline-red" @onclick="() => _modalCreateCopyOpen = false">Close</button>
                            </div>
                        </div>
                    </Modal>

                    <Modal @bind-Value="_modalViewsOpen">
                        <div class="card w-120">
                            <div class="flex mb-4">
                                <h2 class="text-xl font-bold">Views</h2>
                                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalViewsOpen = false">
                                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                                </button>
                            </div>
                            <ul class="list-group">
                                @foreach (var item in GetAllVisualComposerContainer())
                                {
                                    <li class="list-group-item flex">
                                        <p>@item.file</p>
                                        <a class="ms-auto cursor-pointer" @onclick="() => ClearScaleAndTranslateAsync(item.file)">
                                            <Operon.Icons.HeroIcon Icon="arrow-uturn-left" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                        </a>
                                        <a class="ms-2 cursor-pointer" @onclick="() => RemoveAsync(item.file)">
                                            <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                        </a>
                                        <a class="ms-2 cursor-pointer" @onclick="() => ChangeBaseViewsAsync(item.file)" title="@(Views.Contains(item.file) ? "Remove from base views" : "Add to base views")">
                                            <Operon.Icons.HeroIcon Icon="@(Views.Contains(item.file) ? "minus" : "plus")" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                        </a>

                                        <div class="input-checkbox">
                                            <label for="changeAllowZoomingAndPanningcheckbox" title="Zooming and panning">
                                                <input type="checkbox" class="peer" id="changeAllowZoomingAndPanningcheckbox" checked="@(item.allowZoomingAndPanning ? "checked" : null)" @onclick="() => ChangeAllowZoomingAndPanningAsync(item.file)" />
                                                <span>
                                                    <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                                                </span>
                                            </label>
                                        </div>

                                        <div class="input-checkbox">
                                            <label for="changeDefaultViewcheckbox" title="Default view">
                                                <input type="checkbox" class="peer" id="changeDefaultViewcheckbox" checked="@(item.file == DefaultView ? "checked" : null)" @onclick="() => ChangeDefaultViewAsync(item.file)" />
                                                <span>
                                                    <Operon.Icons.HeroIcon Icon="check" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                                                </span>
                                            </label>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </Modal>

                    <Modal @bind-Value="_modalBackgroundOpen">
                        <div class="card w-120">
                            <div class="flex mb-4">
                                <h2 class="text-xl font-bold">Background</h2>
                                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalBackgroundOpen = false">
                                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                                </button>
                            </div>
                            <Accordion>
                                <AccordionItem Title="Upload image">
                                    <InputFile class="input-file" accept=".png, .jpg, .jpeg, .svg" OnChange="@UploadFile" />
                                    @if (!isFileImported && isFileImporting)
                                    {
                                        <p>Loading</p>
                                    }
                                </AccordionItem>
                                <AccordionItem Title="Set empty background">
                                    <input type="color" class="form-control form-control-color" @bind="BackgroundColor" title="Choose color">
                                    <button type="button" class="btn btn-secondary" disabled="@(ImgSrc == null || ImgSrc == "" ? "disabled" : null)" @onclick="() => { ImgSrc = null; SaveAsync(); }">Clear image (only background color)</button>
                                </AccordionItem>
                            </Accordion>
                            <div class="mt-2">
                                <BaseInput @bind-Value="BackgroundWidth" Label="Width" />
                                <BaseInput @bind-Value="BackgroundHeight" Label="Height" />
                            </div>
                            <div class="ms-auto">
                                <button class="btn btn-outline-red" @onclick="() => _modalBackgroundOpen = false">Close</button>
                            </div>
                        </div>
                    </Modal>

                    <Modal @bind-Value="_modalBackgroundSVGInputOpen">
                        <div class="card w-120">
                            <div class="flex mb-4">
                                <h2 class="text-xl font-bold">Background SVG Input</h2>
                                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalBackgroundSVGInputOpen = false">
                                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                                </button>
                            </div>
                            <textarea @bind="BackgroundSVGInput" @bind:event="oninput" style="width:100%;height:15vh;" />
                            <div class="ms-auto">
                                <button class="btn btn-outline-red" @onclick="() => _modalBackgroundSVGInputOpen = false">Close</button>
                            </div>
                        </div>
                    </Modal>
                }
            </Authorized>
            <NotAuthorized>
                <nav class="flex flex-wrap flex-col sm:flex-row">
                    @foreach (var item in Views)
                    {
                        <button class="tab @(CurrentView is null || CurrentView == "" ? item == DefaultView ? "tab-active" : null : item == CurrentView ? "tab-active" : null)" @onclick="() => LoadAsync(item)">@item</button>
                    }
                </nav>

                <ZoomableContainer Parent="this" Disable="!AllowZoomingAndPanning">
                    <div id="@_backgroundId" style="width: 100%; height: @((BackgroundHeight / BackgroundWidth) * ElementSize.Width)px;">
                        <svg width="100%" height="100%" viewBox="0 0 @(BackgroundWidth) @(BackgroundHeight)">@(new MarkupString(BackgroundSVGInput))</svg>
                    </div>

                    <CascadingValue Value="@this" Name="Parent" IsFixed="true">
                        @foreach (VisualComposerItemData child in _children)
                        {
                            <VisualComposerItem InDesign="@InDesignMode" Origin="@child" />
                        }
                        @if (ImgSrc != null && ImgSrc != "")
                        {
                            <div style="position: absolute; left: 0; top: 0; width: 100%; z-index: -1;">
                                <img src="@ImgSrc" style="width: 100%; height: 100%;" />
                            </div>
                        }
                    </CascadingValue>
                </ZoomableContainer>
            </NotAuthorized>
        </AuthorizeView>
    </div>
    @if (!ModalDetailView)
    {
        <span class="@(DetailsVisibility ? null : "d-none") m-4">
            <div class="card overflow-auto">
                <button class="cursor-pointer ms-auto my-auto" @onclick="ToggleDetailsVisibility">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <div class="dropdown">
                            @code {
        private bool _dropdownCollapsedPresentation = true;
                        }
                        <button class="btn btn-primary" @onclick="() => _dropdownCollapsedPresentation = !_dropdownCollapsedPresentation">
                            Presentation
                            <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 collapse-button-icon " + (_dropdownCollapsedPresentation ? "open" : null))" />
                        </button>
                        @if (!_dropdownCollapsedPresentation)
                            {
                                <div class="dropdown-body-end card">
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick='() => DetailsPresentationType = "Command"'>Command</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick='() => DetailsPresentationType = "Status"'>Status</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick='() => DetailsPresentationType = "Control"'>Control</a>
                                    <a class="block px-4 py-2 text-sm text-gray-700" @onclick='() => DetailsPresentationType = "Display"'>Display</a>
                                </div>
                            }
                        </div>
                        <div class="input">
                            <input type="text" id="input" @bind="DetailsPresentationType" />
                        </div>
                    </Authorized>
                </AuthorizeView>
                <RenderableContentControl @ref="detailsRcc" Presentation="Command-Control"></RenderableContentControl>
            </div>
        </span>
    }
    else
    {
        <Modal @bind-Value="DetailsVisibility">
            <div class="card w-120">
                <div class="flex mb-4">
                    <AuthorizeView Roles="Administrator">
                        <Authorized>
                            <div class="dropdown">
                                @code {
        private bool _dropdownCollapsedPresentationModal = true;
                            }
                            <button class="btn btn-primary" @onclick="() => _dropdownCollapsedPresentationModal = !_dropdownCollapsedPresentationModal">
                                Presentation
                                <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 collapse-button-icon " + (_dropdownCollapsedPresentationModal ? "open" : null))" />
                            </button>
                            @if (!_dropdownCollapsedPresentationModal)
                                {
                                    <div class="dropdown-body-end card">
                                        <a class="block px-4 py-2 text-sm text-gray-700" @onclick='() => DetailsPresentationType = "Command"'>Command</a>
                                        <a class="block px-4 py-2 text-sm text-gray-700" @onclick='() => DetailsPresentationType = "Status"'>Status</a>
                                        <a class="block px-4 py-2 text-sm text-gray-700" @onclick='() => DetailsPresentationType = "Control"'>Control</a>
                                        <a class="block px-4 py-2 text-sm text-gray-700" @onclick='() => DetailsPresentationType = "Display"'>Display</a>
                                    </div>
                                }
                            </div>
                            <div class="input">
                                <input type="text" id="input" @bind="DetailsPresentationType" />
                            </div>
                        </Authorized>
                    </AuthorizeView>
                    <RenderableContentControl @ref="detailsRcc" Presentation="Command-Control"></RenderableContentControl>
                </div>
            </div>
        </Modal>
    }
</div>