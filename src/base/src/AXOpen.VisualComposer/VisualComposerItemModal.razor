@using AXSharp.Presentation.Blazor.Services
@if (Origin.IdPlain != null)
{
    <AuthorizeView Roles="Administrator">
        <Authorized>
            <div class="modal fade" id="settings-@Origin.Id.Replace('.', '_')-@Origin.UniqueGuid" tabindex="-1" aria-hidden="true" data-bs-backdrop="true" style="transform: none;">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="alarmsviewTitle" style="width: 90%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">@Origin.IdPlain</h1>
                            <a class="text-decoration-none text-black ms-auto" style="cursor: pointer;" data-bs-dismiss="modal" @onclick="RemoveAsync"><span class="bi bi-trash fs-5" aria-hidden="true" /></a>
                            <button type="button" class="btn-close ms-3" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body justify-content-center">
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Top</label>
                                <div class="col-sm-10">
                                    <input type="text" class="form-control" placeholder="Top" @bind="Origin.Top">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Left</label>
                                <div class="col-sm-10">
                                    <input type="text" class="form-control" placeholder="Left" @bind="Origin.Left">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Presentation</label>
                                <div class="col-sm-6">
                                    @if (_customPresentation)
                                    {
                                        <input type="text" class="form-control" placeholder="Presentation" @bind="Origin.Presentation">
                                    }
                                    else
                                    {
                                        <select class="form-select" value="@Origin.Presentation" @onchange="@((args) => @Origin.Presentation = (string)args.Value)">
                                            @foreach (var presentation in PresentationType.AllTypes)
                                            {
                                                <option data value="@presentation.ToString()">@presentation.ToString()</option>
                                            }
                                        </select>
                                    }
                                </div>
                                <div class="col-sm-4 d-flex align-items-center">
                                    <label class="col-form-label ms-auto">Custom</label>
                                    <input class="form-check-input ms-2 mt-0" type="checkbox" checked="@((_customPresentation) ? "checked" : null)" @onclick="() => _customPresentation = !_customPresentation">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Transform</label>
                                <div class="col-sm-10">
                                    <select class="form-select" value="@Origin.Transform.ToString()" @onchange="@((args) => @Origin.Transform = TransformType.FromString((string)args.Value))">
                                        @foreach (var transform in TransformType.AllTypes)
                                        {
                                            <option data value="@transform.ToString()">@transform.ToString()</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Width</label>
                                <div class="col-sm-10">
                                    <input type="text" class="form-control" placeholder="Width" @bind="Origin.Width">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Height</label>
                                <div class="col-sm-10">
                                    <input type="text" class="form-control" placeholder="Height" @bind="Origin.Height">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">ZIndex</label>
                                <div class="col-sm-10">
                                    <input type="number" class="form-control" placeholder="ZIndex" @bind="Origin.ZIndex">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Scale</label>
                                <div class="col-sm-10">
                                    <input type="number" class="form-control" placeholder="Scale" @bind="Origin.Scale" step="0.1">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Roles</label>
                                <div class="col-sm-10">
                                    <input type="text" class="form-control" placeholder="Roles" @bind="Origin.Roles">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Template</label>
                                <div class="col-sm-6">
                                    @if (_customPresentationTemplate)
                                    {
                                        <input type="text" class="form-control" placeholder="Template" @bind="Origin.PresentationTemplate">
                                    }
                                    else
                                    {
                                        <select class="form-select" @bind="Origin.PresentationTemplate">
                                            <option data value="">None</option>
                                            @foreach (var component in Components.Where(x => x.type != null && x.type.Equals(Origin.TwinElement.GetType().FullName)))
                                            {
                                                <option data value="@component.key">@component.key</option>
                                            }
                                        </select>
                                    }
                                </div>
                                <div class="col-sm-4 d-flex align-items-center">
                                    <label class="col-form-label ms-auto">Custom</label>
                                    <input class="form-check-input ms-2 mt-0" type="checkbox" checked="@((_customPresentationTemplate) ? "checked" : null)" @onclick="() => _customPresentationTemplate = !_customPresentationTemplate">
                                </div>
                            </div>
                            <div class="mb-1 row">
                                <label class="col-sm-2 col-form-label">Background</label>
                                <div class="col-sm-10 d-flex align-items-center">
                                    <input class="form-check-input ms-2 mt-0" type="checkbox" checked="@(Origin.Background ? "checked" : null)" @onclick="() => Origin.Background = !Origin.Background">
                                    <input type="color" class="form-control form-control-color ms-4" @bind="Origin.BackgroundColor" title="Choose color">
                                </div>
                            </div>

                            @* <p>@Origin.TwinElement.GetType().FullName</p>

                            <select class="form-select" @bind="Origin.PresentationTemplate">
                                <option data value=""></option>
                                @foreach (var component in Components)
                                {
                                    <option value="@component.key">@component.key | @component.type</option>
                                }
                            </select> *@
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
}