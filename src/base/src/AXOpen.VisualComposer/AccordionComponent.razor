@using AXSharp.Connector;

<div class="accordion-item">
    <div class="accordion-button @(IsExpanded ? "accordion-button-active" : null) flex">
        <button class="flex" @onclick="() => IsExpanded = !IsExpanded">
            <Operon.Icons.HeroIcon Icon="cube" Type="Operon.Icons.IconType.Outline" Class="size-5" />
            @SourceTwinElement.Symbol
            <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 accordion-button-icon " + (IsExpanded ? "open" : null))" />
        </button>
        <a class="p-2 cursor-pointer" @onclick="() => Parent.AddChildrenAsync(SourceTwinElement)">
            <Operon.Icons.HeroIcon Icon="plus" Type="Operon.Icons.IconType.Outline" Class="size-5" />
        </a>
    </div>
    @if (IsExpanded)
    {
        <div class="accordion-body">
            <ul class="list-group">
                @if (SourceTwinElement is ITwinObject primary)
                {
                    @foreach (var kid in primary.GetKids())
                    {
                        if (kid is ITwinObject tobj)
                        {
                            <AccordionComponent SourceTwinElement="tobj" Parent="@Parent" />
                        }

                        if (kid is ITwinPrimitive prim)
                        {
                            <li class="list-group-item flex">
                                <Operon.Icons.HeroIcon Icon="credit-card" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                <p>@prim.Symbol</p>
                                <a class="ms-auto cursor-pointer" @onclick="() => Parent.AddChildrenAsync(prim)">
                                    <Operon.Icons.HeroIcon Icon="plus" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                </a>
                            </li>
                        }
                    }
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter]
    public ITwinElement SourceTwinElement { get; set; }

    [Parameter]
    public VisualComposerContainer Parent { get; set; }

    private bool IsExpanded { get; set; } = false;
}