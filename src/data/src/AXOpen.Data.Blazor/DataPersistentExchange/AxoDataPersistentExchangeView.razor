@namespace AXOpen.Data
@using AXOpen.Base
@using AXOpen.Data;
@using AXSharp.Connector;
@using CommunityToolkit.Mvvm.ComponentModel;
@using CommunityToolkit.Mvvm.Messaging;
@using Microsoft.AspNetCore.Components.Forms;
@using AXOpen.Data.Interfaces;
@using AXOpen.Core;
@using AXOpen.Data;

@if (Vm == null)
{
    <h5>Loading...</h5>
}
else
{
    @* global buttons and filtering*@
    <div class="flex flex-wrap">

        <button type="button" class="btn btn-primary ms-2"
                @onclick='async () => {await Vm.ReadAllFromPlc();}'>
            @Localizer["Read from PLC"]
        </button>

        <button type="button" class="btn btn-primary ms-2"
                @onclick="async () => {await Vm.SendAllToPlc(); }">
            @Localizer["Write to PLC"]
        </button>

        <div class="btn-group ms-auto" role="group">

            <div class="btn-group" role="group">
                <div class="dropdown">
    <button class="btn btn-primary" @onclick="() => _dropdownSearchCollapsed = !_dropdownSearchCollapsed">
        Options
    <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 collapse-button-icon " + (_dropdownSearchCollapsed ? "open" : null))" />
</button>
@if (!_dropdownSearchCollapsed)
{
    <div class="dropdown-body card">
        <a class="block px-4 py-2 text-sm text-gray-700 @(Vm.SearchMode == AXOpen.Base.Data.eSearchMode.Exact ? "active" : "")" @onclick="() => setSearchModeAsync(AXOpen.Base.Data.eSearchMode.Exact)">@Localizer["Exact"]</a>
                    <a class="block px-4 py-2 text-sm text-gray-700 @(Vm.SearchMode == AXOpen.Base.Data.eSearchMode.Contains ? "active" : "")" @onclick="() => setSearchModeAsync(AXOpen.Base.Data.eSearchMode.Contains)">@Localizer["Contains"]</a>
                    <a class="block px-4 py-2 text-sm text-gray-700 @(Vm.SearchMode == AXOpen.Base.Data.eSearchMode.StartsWith ? "active" : "")" @onclick="() => setSearchModeAsync(AXOpen.Base.Data.eSearchMode.StartsWith)">@Localizer["StartsWith"]</a>
    </div>
}
</div>
            </div>
            <form @onsubmit="() => Vm.Filter()" class="btn-group">
                <input type="search" class="form-control" placeholder="Search" aria-label="Search" @bind="Vm.FilterById">
                <button class="btn btn-secondary" type="submit" name="searchbutton">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                    </svg>
                </button>
            </form>
            <button class="btn btn-secondary" type="button" name="refresh" aria-label="Refresh" title="Refresh" @onclick="() => Vm.FillObservableRecordsAsync()">
                <Operon.Icons.HeroIcon Icon="arrow-path" Type="Operon.Icons.IconType.Outline" Class="size-5" />
            </button>
        </div>
    </div>


    <!-- Main Table: PersistentRecord -->
    <table class="table table-striped">
        <thead>
            <tr>
                <th>DataEntityId</th>
                <th>Created</th>
                <th>Modified</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Vm.IsBusy)
            {

                <tr>
                    <td>
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </td>
                </tr>

            }
            else if (!Vm.Records.Any())
            {
                <tr>
                    <td>
                        <h3>@Localizer["Collection is empty"]</h3>
                    </td>
                </tr>

            }
            else
            {

                @foreach (var record in Vm.Records)
                {
                    <tr class="cursor-pointer" @onclick="() => Vm.SelectedRecord = record">
                        <td>@record.DataEntityId</td>
                        <td>@record._Created.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                        <td>@record._Modified.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>

                        <td>
                            <button title="Send To PLC"
                                    @onclick='async () => {
                                    await Vm.DataExchange.WritePersistentGroupFromRepository(record.DataEntityId);
                                     await Vm.FillObservableRecordsAsync();
                                    AlertDialogService?.AddAlertDialog(eAlertType.Success, $"Persistent Data", $"Persistent group {record.DataEntityId} was successfully loaded to PLC!", 10);
                                }'
                                    type="button" class="btn btn-primary px-3 py-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download" viewBox="0 0 16 16">
                                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5" />
                                    <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z" />
                                </svg>

                            </button>

                            <button title="Read from PLC to repository"
                                    @onclick='async () => { await Vm.DataExchange.UpdatePersistentGroupFromPlcToRepository(record.DataEntityId);
                                     await Vm.FillObservableRecordsAsync();
                                    AlertDialogService?.AddAlertDialog(eAlertType.Success, $"Persistent Data", $"Persistent group {record.DataEntityId} was successfully readed from PLC!", 10);
                                }'
                                    type="button" class="btn btn-primary px-3 py-0">

                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cloud-upload" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M4.406 1.342A5.53 5.53 0 0 1 8 0c2.69 0 4.923 2 5.166 4.579C14.758 4.804 16 6.137 16 7.773 16 9.569 14.502 11 12.687 11H10a.5.5 0 0 1 0-1h2.688C13.979 10 15 8.988 15 7.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 2.825 10.328 1 8 1a4.53 4.53 0 0 0-2.941 1.1c-.757.652-1.153 1.438-1.153 2.055v.448l-.445.049C2.064 4.805 1 5.952 1 7.318 1 8.785 2.23 10 3.781 10H6a.5.5 0 0 1 0 1H3.781C1.708 11 0 9.366 0 7.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383" />
                                    <path fill-rule="evenodd" d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708z" />
                                </svg>

                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <Operon.Components.Pagination Count="(int)Vm.FilteredCount" @bind-PageSize="Limit" @bind-Selected="Page" PageSizeAndSelectedChangedAsync="PageSizeAndSelectedChangedAsync" />

    @if (Vm.SelectedRecord != null)
    {
        <!-- Table for Tags -->
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Symbol</th>
                    <th>ValueType</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tag in Vm.SelectedRecord.Tags)
                {
                    <tr>
                        <td>@tag.Symbol</td>
                        <td>@tag.ValueType</td>
                        <td>@tag.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Select a record to see its tags.</p>
    }

}

                    @code{
                        private bool _dropdownSearchCollapsed = true;
                    }