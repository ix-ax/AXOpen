@namespace AXOpen.Data
@using System.Reflection
@using Microsoft.AspNetCore.Components.Authorization

@*  
  icons : https://icon-sets.iconify.design/oi/ 
  icons : https://icons.getbootstrap.com/ 
*@   
@if (IsNoActiveOperation())
{

    <div class="d-flex flex-row align-items-center gap-2 bg-info bg-opacity-10 border rounded p-1 mb-1">

        <h5>@Localizer["Global Actions:"]</h5>


        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_filter_advanced">
            <Authorized>

                <button class="btn @(AdvanceFilterConfig ? "btn-warning" : "btn-primary") btn-secondary px-1 py-1" name="advanceConfig" @onclick="()=>{AdvanceFilterConfig = !AdvanceFilterConfig;}">
                    @if (AdvanceFilterConfig)
                    {
                        <span>
                            <i class="bi bi-funnel-fill"></i>
                            <span>@Localizer["Hide filter"]</span>
                        </span>
                    }
                    else
                    {
                        <span>
                            <i class="bi bi-funnel"></i>
                            <span>@Localizer["Filter"]</span>
                        </span>
                    }
                </button>
            </Authorized>
        </AuthorizeView>

        <button type="button" class="btn @(DistributedVM.EnableInjectLocalIds ? "btn-warning" : "btn-primary") px-1 py-1"
                @onclick="DistributedVM.TogleLocalEntityIdsInjection">
            @if (DistributedVM.EnableInjectLocalIds)
            {

                <i class="bi bi-inboxes"></i>
                <span>@Localizer["Do not concat query"]</span>
                <span class="ms-2">@DistributedVM.TransmitedEntities.Count</span>

            }
            else
            {
                <i class="bi bi-inbox"></i>
                <span>@Localizer["Concat query"]</span>
            }
        </button>

        @if (DistributedVM.InjectedEntities != null && DistributedVM.InjectedEntities.Count > 0)
        {
            <button type="button" class="btn btn-secondary px-1 py-1"
                    @onclick="() => DistributedVM.TogleExternalEntityIdsInjection()">

                @if (DistributedVM.EnableInjectedExternalIds)
                {
                    <span> @Localizer["Disable Injected Ids"]</span>
                    <span>(@DistributedVM.InjectedEntities.Count)</span>
                }
                else
                {
                    <span>@Localizer["Enable injected Ids"]</span>
                }
            </button>
        }

        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_create">
            <Authorized>
                <button type="button" class="btn btn-primary"
                        @onclick='() => BtnOperation = "Create"'>
                    @Localizer["Create"]
                </button>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_copy">
            <Authorized>
                <button type="button" class="btn btn-primary"
                        @onclick='() => BtnOperation = "Copy"'>
                    @Localizer["Copy"]
                </button>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_load_from_plc">
            <Authorized>
                <button type="button" class="btn btn-primary ms-2"
                        @onclick='() => BtnOperation = "CreateNewFromPlc"'>
                    @Localizer["New from PLC"]
                </button>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_update_from_plc">
            <Authorized>
                <button type="button" class="btn btn-primary ms-2"
                        @onclick='() => BtnOperation = "UpdateFromPlc"'>
                    @Localizer["Update from PLC"]
                </button>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_delete">
            <Authorized>
                <button type="button" class="btn btn-primary"
                        @onclick='() => BtnOperation = "Delete"'>
                    @Localizer["Delete"]
                </button>
            </Authorized>
        </AuthorizeView>

        @*  @if (EnableExport)
        {
            <AuthorizeView Roles="@DataExchangeRoleNames.can_data_export">
                <Authorized>
                    <button type="button" class="btn btn-primary ms-2"
                            @onclick='() => BtnOperation = "Export"'>
                        @Localizer["Export"]
                    </button>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@DataExchangeRoleNames.can_data_import">
                <Authorized>
                    <button type="button" class="btn btn-primary ms-2"
                            @onclick='() => BtnOperation = "Import"'>
                        @Localizer["Import"]
                    </button>
                </Authorized>
            </AuthorizeView>
        } *@


    </div>

}


@if (IsAnyActiveOperation())
{
    <div class="card p-1 m-1">

        @if (this.BtnOperation == "Create")
        {
            <div class="row mb-3">
                <div class="col d-flex flex-column gap-3 align-items-start">

                    <!-- Label + Input -->
                    <div class="w-100">
                        <label for="newRecName" class="form-label fw-bold">
                            @Localizer["New record name:"]
                        </label>
                        <input id="newRecName"
                               class="form-control"
                               placeholder="New record name"
                               title="New record name"
                               data-bs-toggle="tooltip"
                               @bind="OperationRecordName"
                               @bind:event="oninput" />
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex flex-row gap-2 w-100">
                        @if (!string.IsNullOrEmpty(OperationRecordName))
                        {
                            <button type="button"
                                    class="btn btn-primary px-3 py-1 w-100"
                                    @onclick='() => BtnOperation = "Create-Ack"'>
                                <i class="bi bi-plus-circle me-2"></i>
                                <span>@Localizer["Create a blank record"] "@OperationRecordName"</span>
                            </button>
                        }

                        <button type="button"
                                class="btn btn-secondary px-3 py-1 w-100"
                                @onclick="EndBtnOperation">
                            <i class="bi bi-x-circle me-2"></i>
                            <span>@Localizer["Close"]</span>
                        </button>
                    </div>

                </div>
            </div>
        }

        @if (this.BtnOperation == "Create-Ack")
        {
            <div class="row">
                <div class="col">
                    <div class="d-flex gap-2 w-100">

                        <div class="flex-fill">
