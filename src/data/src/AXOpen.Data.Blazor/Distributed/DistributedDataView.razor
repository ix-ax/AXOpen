@namespace AXOpen.Data
@using System.Reflection
@using Microsoft.AspNetCore.Components.Authorization

@*  
  icons : https://icon-sets.iconify.design/oi/ 
  icons : https://icons.getbootstrap.com/ 
*@   
@if (IsNoActiveOperation())
{

    <div class="d-flex flex-row align-items-center gap-2 bg-info bg-opacity-10 border rounded p-1 mb-1">

        <h5>@Localizer["Global Actions:"]</h5>


        @if (EnableFiltering)
        {
            <AuthorizeView Roles="@DataExchangeRoleNames.can_data_filter_advanced">
                <Authorized>

                    <button class="btn @(AdvanceFilterConfig ? "btn-warning" : "btn-primary") btn-secondary" name="advanceConfig" @onclick="()=>{AdvanceFilterConfig = !AdvanceFilterConfig;}">
                        @if (AdvanceFilterConfig)
                        {
                            <span>
                                <i class="bi bi-funnel-fill"></i>
                                <span>@Localizer["Hide filter"]</span>
                            </span>
                        }
                        else
                        {
                            <span>
                                <i class="bi bi-funnel"></i>
                                <span>@Localizer["Filter"]</span>
                            </span>
                        }
                    </button>
                </Authorized>
            </AuthorizeView>
        }


        <button type="button" class="btn @(DistributedVM.EnableInjectLocalIds ? "btn-warning" : "btn-primary")"
                @onclick="DistributedVM.TogleLocalEntityIdsInjection">
            @if (DistributedVM.EnableInjectLocalIds)
            {

                <i class="bi bi-inboxes"></i>
                <span>@Localizer["Do not concat query"]</span>
                <span class="ms-2">@DistributedVM.TransmitedEntities.Count</span>

            }
            else
            {
                <i class="bi bi-inbox"></i>
                <span>@Localizer["Concat query"]</span>
            }
        </button>

        @if (DistributedVM.InjectedEntities != null && DistributedVM.InjectedEntities.Count > 0)
        {
            <button type="button" class="btn btn-secondary px-1 py-1"
                    @onclick="() => DistributedVM.TogleExternalEntityIdsInjection()">

                @if (DistributedVM.EnableInjectedExternalIds)
                {
                    <span> @Localizer["Disable Injected Ids"]</span>
                    <span>(@DistributedVM.InjectedEntities.Count)</span>
                }
                else
                {
                    <span>@Localizer["Enable injected Ids"]</span>
                }
            </button>
        }


        @*  @if (EnableExport)
        {
            <AuthorizeView Roles="@DataExchangeRoleNames.can_data_export">
                <Authorized>
                    <button type="button" class="btn btn-primary ms-2"
                            @onclick='() => BtnOperation = "Export"'>
                        @Localizer["Export"]
                    </button>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@DataExchangeRoleNames.can_data_import">
                <Authorized>
                    <button type="button" class="btn btn-primary ms-2"
                            @onclick='() => BtnOperation = "Import"'>
                        @Localizer["Import"]
                    </button>
                </Authorized>
            </AuthorizeView>
        } *@


    </div>

}


@if (IsAnyActiveOperation())
{

}
else
{
    @if (AdvanceFilterConfig)
    {
        <div class="d-flex flex-row align-items-center gap-2 bg-warning bg-opacity-25 border rounded mb-1">
            <AXOpen.Data.Query.DataExchangeQuery Exchange="@this.DistributedVM"></AXOpen.Data.Query.DataExchangeQuery>
        </div>
    }


    @if (DistributedVM == null)
    {
        <p>Initializing ...</p>
    }
    else
    {
        if (DistributedVM.DisplayedDataFragments != null)
        {
            <ul class="nav nav-tabs mb-3">
                @foreach (var exchange in DistributedVM.DisplayedDataFragments)
                {
                    <li class="nav-item">
                        <button type="button"
                                data-bs-toggle="tooltip" data-bs-placement="top"
                                data-bs-custom-class="custom-tooltip"
                                data-bs-title="@exchange.DataExchangeTwinObject.Symbol"
                                class="nav-link fw-bold @((DistributedVM?.SelectedManagerVm?.Model == exchange) ? "active" : "")"
                                @onclick="async () => {await DistributedVM.SelectManager(exchange);}">
                            @exchange.PresentableInstanceName
                        </button>
                    </li>
                }
            </ul>
        }
    }
    <div class="mt-1">
        <DataExchangeView @key="@DistributedVM.SelectedManagerVm.Model"
                          Vm="@DistributedVM.SelectedManagerVm"
                          Presentation="@this.Presentation"
                          EnableCreate="@this.EnableCreate"
                          EnableCopy="@this.EnableCopy"
                          EnableDelete="@this.EnableDelete"

                          EnableCreateNewFromPlc="@this.EnableCreateNewFromPlc"
                          EnableSendToPlc="@this.EnableSendToPlc"
                          EnableUpdateFromPlc="@this.EnableUpdateFromPlc"

                          EnableFiltering="@this.EnableFiltering"
                          EnableSorting="@this.EnableSorting"
                          EnableExport="@this.EnableExport"
>

            @foreach (var column in DistributedVM.ExchangeConfig.Collumns)
            {
                <ColumnData HeaderName="@column.ColumnName"
                            BindingValue="@column.BindingValuePath"
                            Clickable="@column.ClickEnabled"
                            PresentationTemplate="@column.TemplateType"></ColumnData>
            }

        </DataExchangeView>
    </div>
}

