                                <div class="d-flex flex-row justify-content-center align-items-center">
                                    <i class="bi bi-x-circle mx-2"></i>
                                    <span>@Localizer["Close"]</span>
                                </div>
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        }


        @if (this.BtnOperation == "Copy")
