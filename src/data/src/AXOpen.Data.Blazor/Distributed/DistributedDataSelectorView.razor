@namespace AXOpen.Data
@using System.Reflection
@using AXOpen.Base
@using AXOpen.Data.Query
@using Microsoft.AspNetCore.Components.Authorization

@*  
  icons : https://icon-sets.iconify.design/oi/ 
  icons : https://icons.getbootstrap.com/ 
*@   
@if (IsNoActiveOperation())
{
    <div class="d-flex gap-2 align-items-start">

        <!-- Selector -->
        <div class="position-relative flex-grow-1">
            <button class="btn btn-outline-primary w-100 text-start" @onclick="ToggleCurrentIdsDropdown">
                <div class="d-flex flex-row align-items-center gap-3 flex-wrap">

                    @if (!string.IsNullOrEmpty(GetCurrentDataEntityId(DistributedVM.MainExchange)))
                    {
                        <span>@Localizer["In Plc"]: <strong>@GetCurrentDataEntityId(DistributedVM.MainExchange)</strong></span>

                        if (!DistributedVM.AllExchangesHasTheSameId())
                        {
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Reload?</span>
                    }
                </div>
            </button>

            @if (IsCurrentIdsDropdownOpen)
            {
                <div class="shadow border bg-white p-2"
                style="position: absolute; z-index: 1000; width: 100%; min-width:600px; max-height: 600px; overflow-y: auto;">

                    <div class="d-flex flex-column align-items-center gap-2">
                        <button class="btn btn-primary w-100" @onclick="DistributedVM.ReadAllCurrentEntityIds">Reload All</button>


                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>DataEntityId</th>
                                    <th>@Localizer["In DataExchange"]</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var ex in DistributedVM.AllExchanges)
                                {
                                    var mainId = GetCurrentDataEntityId(DistributedVM.MainExchange);
                                    var currentId = GetCurrentDataEntityId(ex);
                                    var textClass = currentId != mainId ? "text-warning" : "text-body";

                                    <tr>
                                        <td>
                                            <span class="@textClass">
                                                <strong>@currentId</strong>
                                            </span>
                                        </td>
                                        <td>@ex.DataExchangeTwinObject.Symbol </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            }
        </div>


        <div class="position-relative flex-grow-1">
            <button class="btn btn-outline-primary w-100 text-start" @onclick="ToggleDropdown">
                <div class="d-flex flex-row align-items-center gap-3 flex-wrap">
                    @if (SelectedEntity != null)
                    {
                        <span><strong>@SelectedEntity.DataEntityId</strong></span>

                        @foreach (var col in ExchangeConfig.Collumns)
                        {
                            var val = PropertyHelper.GetPropertyValue(SelectedEntity, col.BindingValuePath);
                            <span class="text-muted">
                                <strong>@(string.IsNullOrWhiteSpace(col.ColumnName) ? col.BindingValuePath : col.ColumnName):</strong>
                                @if (col.TemplateType != null)
                                {
                                    @ColumnDataCellBaseExtension.GetRenderFragment(col.TemplateType)?.Invoke(val)
                                }
                                else
                                {
                                    @val
                                }
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Select an option</span>
                    }
                </div>
            </button>

            @if (IsDropdownOpen)
            {
                <div class="shadow border bg-white p-2"
                     style="position: absolute; z-index: 1000; width: 100%; min-width:600px;  max-height: 600px; overflow-y: auto;">

                    <div class="d-flex flex-row align-items-center gap-2">

                        <QuerySymbolConfigurationView SymbolConfiguration="@DistributedVM.DefaulQueryDataEntityId"
                                                      HideDescripion="true"
                                                      SymbolConfigurationChanged="
                                              ()=>
                    { DistributedVM.FilteredPage = 0 ;DistributedVM.FillObservableRecordsAsync();}" />

                        <button class="btn btn-secondary" @onclick="DistributedVM.FillObservableRecordsAsync">
                            <i class="bi bi-search"></i>
                        </button>

                    </div>

                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>DataEntityId</th>
                                @foreach (var col in ExchangeConfig.Collumns)
                                {
                                    <th>@(string.IsNullOrWhiteSpace(col.ColumnName) ? col.BindingValuePath : col.ColumnName)</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var rec in DistributedVM.Records)
                            {
                                <tr @onclick="() => SelectEntity(rec)" style="cursor: pointer;">
                                    <td>@rec.DataEntityId</td>
                                    @foreach (var col in ExchangeConfig.Collumns)
                                    {
                                        var val = PropertyHelper.GetPropertyValue(rec, col.BindingValuePath);
                                        <td>
                                            @if (col.TemplateType != null)
                                            {
                                                @ColumnDataCellBaseExtension.GetRenderFragment(col.TemplateType)?.Invoke(val)
                                            }
                                            else
                                            {
                                                @val
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (DistributedVM.FilteredCount > 5)
                    {
                        <div class="d-flex">

                            <div class="dropup">
                                Showing @(FilteredPage * FilteredPageLimit + 1) to @(((FilteredPage + 1) * FilteredPageLimit) > TotalCount ? TotalCount : ((FilteredPage + 1) * FilteredPageLimit)) of @TotalCount rows
                                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@FilteredPageLimit</button>
                                <ul class="dropdown-menu m-0">
                                    <li><a class="dropdown-item @(FilteredPageLimit == 5 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(5)">5</a></li>
                                    <li><a class="dropdown-item @(FilteredPageLimit == 10 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(10)">10</a></li>
                                    <li><a class="dropdown-item @(FilteredPageLimit == 25 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(25)">25</a></li>
                                    <li><a class="dropdown-item @(FilteredPageLimit == 50 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(50)">50</a></li>
                                </ul>
                                rows per page
                            </div>
                            <nav class="ms-auto">
                                <ul class="pagination m-0">
                                    <li class="page-item"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(Modulo(FilteredPage - 1, MaxPage + 1))" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a></li>

                                    @if (MaxPage < 7)
                                    {
                                        @for (var i = 0; i < MaxPage + 1; i++)
                                        {
                                            var j = i;
                                            <li class="page-item @(FilteredPage == i ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(j)">@(i + 1)</a></li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="page-item @(FilteredPage == 0 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(0)">1</a></li>

                                        @if (FilteredPage < 4)
                                        {
                                            <li class="page-item @(FilteredPage == 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(1)">2</a></li>
                                            <li class="page-item @(FilteredPage == 2 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(2)">3</a></li>
                                            <li class="page-item @(FilteredPage == 3 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(3)">4</a></li>
                                            <li class="page-item @(FilteredPage == 4 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(4)">5</a></li>
                                            <li class="page-item disabled"><a class="page-link">...</a></li>
                                        }
                                        else if (FilteredPage > MaxPage - 4)
                                        {
                                            <li class="page-item disabled"><a class="page-link">...</a></li>
                                            <li class="page-item @(FilteredPage == @MaxPage - 4 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 4)">@(MaxPage - 3)</a></li>
                                            <li class="page-item @(FilteredPage == @MaxPage - 3 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 3)">@(MaxPage - 2)</a></li>
                                            <li class="page-item @(FilteredPage == @MaxPage - 2 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 2)">@(MaxPage - 1)</a></li>
                                            <li class="page-item @(FilteredPage == @MaxPage - 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 1)">@(MaxPage)</a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item disabled"><a class="page-link">...</a></li>
                                            <li class="page-item @(FilteredPage == FilteredPageLimit - 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(FilteredPage - 1)">@(FilteredPage)</a></li>
                                            <li class="page-item @(FilteredPage == FilteredPageLimit ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(FilteredPage)">@(FilteredPage + 1)</a></li>
                                            <li class="page-item @(FilteredPage == FilteredPageLimit + 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(FilteredPage + 1)">@(FilteredPage + 2)</a></li>
                                            <li class="page-item disabled"><a class="page-link">...</a></li>
                                        }

                                        <li class="page-item @(FilteredPage == @MaxPage ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage)">@(MaxPage + 1)</a></li>
                                    }

                                    <li class="page-item"><a class="page-link" style="cursor: pointer" @onclick="async () => { if (MaxPage != -1) await SetPageAsync((FilteredPage + 1) % (MaxPage + 1)); }" aria-label="Next"><span aria-hidden="true">&raquo;</span></a></li>
                                </ul>
                            </nav>
                        </div>
                    }

                </div>
            }
        </div>


        <!-- Send to PLC button -->
        @if (!string.IsNullOrEmpty(SelectedEntity?.DataEntityId))
        {
            <div>
                <button class="btn btn-primary" @onclick='()=> this.BtnOperation ="SendToPlc-Ack"'>
                    @Localizer["Send To Plc"]
                </button>
            </div>
        }
    </div>
}
else
{

    @if (this.BtnOperation == "SendToPlc-Ack")
    {
        <div class="row">
            <div class="col">
                <div class="d-flex gap-2 w-100">

                    <div class="flex-fill">
                        <button type="button" class="btn btn-warning w-100 px-1 py-1"
                                @onclick="async () => {
                                        await DistributedVM.SendToPlc(SelectedEntity.DataEntityId);
                                        await DistributedVM.ReadAllCurrentEntityIds();
                                        EndBtnOperation();}">
                            <div class="d-flex flex-row justify-content-center align-items-center">
                                <i class="bi bi-cloud-upload me-2"></i>
                                <span>@Localizer["Send to the PLC"]: "@SelectedEntity.DataEntityId"</span>
                            </div>

                        </button>
                    </div>


                    <div class="flex-fill">
                        <button type="button" class="btn btn-secondary w-100"
                                @onclick='EndBtnOperation'>
                            <div class="d-flex flex-row justify-content-center align-items-center">
                                <i class="bi bi-x-circle mx-2"></i>
                                <span>@Localizer["Close"]</span>
                            </div>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }






}


