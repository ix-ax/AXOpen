@namespace AXOpen.Data

@* ICONS FROM https://icons.getbootstrap.com/ *@

<style>
    .custom-label {
        font-weight: bold; /* Make text bold */
        margin: 0; /* Remove margin */
        padding: 0; /* Remove padding */
        line-height: 0.5; /* Reduce height */
        display: block; /* Ensures it respects height settings */
    }
</style>

<style>
    .custom-icon {
        font-size: 1.3rem;
    }
</style>

<div class="p-0 m-1">

    <div class="col flex align-center gap-2 mb-1">

        <input id="filterText" @bind="Filter" @bind:event="oninput"
               placeholder="Type name ..."
               class="form-control"
               title="Enter a symbol name to filter the results"
               data-bs-toggle="tooltip" />
    </div>

    @if (FilteredElements.Count > 0)
    {
        <div class="card flex p-1 my-1">

            @foreach (var element in GetDisplaySymbols())
            {
                <div class="list-group">
                    <button type="button" class="list-group-item list-group-item-action @(SelectdValue==@element ? "active" : "")" @onclick="() => SelectElement(element)">@element</button>
                </div>
            }

            @if (FilteredElements.Count > 5)
            {
                <div class="d-flex">

                    <div class="dropup">
                        Showing @(FilteredPage * FilteredPageLimit + 1) to @(((FilteredPage + 1) * FilteredPageLimit) > TotalCount ? TotalCount : ((FilteredPage + 1) * FilteredPageLimit)) of @TotalCount rows
                        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@FilteredPageLimit</button>
                        <ul class="dropdown-menu m-0">
                            <li><a class="dropdown-item @(FilteredPageLimit == 5 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(5)">5</a></li>
                            <li><a class="dropdown-item @(FilteredPageLimit == 10 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(10)">10</a></li>
                            <li><a class="dropdown-item @(FilteredPageLimit == 25 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(25)">25</a></li>
                            <li><a class="dropdown-item @(FilteredPageLimit == 50 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(50)">50</a></li>
                        </ul>
                        rows per page
                    </div>
                    <nav class="ms-auto">
                        <ul class="pagination m-0">
                            <li class="page-item"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(Modulo(FilteredPage - 1, MaxPage + 1))" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a></li>

                            @if (MaxPage < 7)
                            {
                                @for (var i = 0; i < MaxPage + 1; i++)
                                {
                                    var j = i;
                                    <li class="page-item @(FilteredPage == i ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(j)">@(i + 1)</a></li>
                                }
                            }
                            else
                            {
                                <li class="page-item @(FilteredPage == 0 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(0)">1</a></li>

                                @if (FilteredPage < 4)
                                {
                                    <li class="page-item @(FilteredPage == 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(1)">2</a></li>
                                    <li class="page-item @(FilteredPage == 2 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(2)">3</a></li>
                                    <li class="page-item @(FilteredPage == 3 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(3)">4</a></li>
                                    <li class="page-item @(FilteredPage == 4 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(4)">5</a></li>
                                    <li class="page-item disabled"><a class="page-link">...</a></li>
                                }
                                else if (FilteredPage > MaxPage - 4)
                                {
                                    <li class="page-item disabled"><a class="page-link">...</a></li>
                                    <li class="page-item @(FilteredPage == @MaxPage - 4 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 4)">@(MaxPage - 3)</a></li>
                                    <li class="page-item @(FilteredPage == @MaxPage - 3 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 3)">@(MaxPage - 2)</a></li>
                                    <li class="page-item @(FilteredPage == @MaxPage - 2 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 2)">@(MaxPage - 1)</a></li>
                                    <li class="page-item @(FilteredPage == @MaxPage - 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 1)">@(MaxPage)</a></li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><a class="page-link">...</a></li>
                                    <li class="page-item @(FilteredPage == FilteredPageLimit - 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(FilteredPage - 1)">@(FilteredPage)</a></li>
                                    <li class="page-item @(FilteredPage == FilteredPageLimit ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(FilteredPage)">@(FilteredPage + 1)</a></li>
                                    <li class="page-item @(FilteredPage == FilteredPageLimit + 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(FilteredPage + 1)">@(FilteredPage + 2)</a></li>
                                    <li class="page-item disabled"><a class="page-link">...</a></li>
                                }

                                <li class="page-item @(FilteredPage == @MaxPage ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage)">@(MaxPage + 1)</a></li>
                            }

                            <li class="page-item"><a class="page-link" style="cursor: pointer" @onclick="async () => { if (MaxPage != -1) await SetPageAsync((FilteredPage + 1) % (MaxPage + 1)); }" aria-label="Next"><span aria-hidden="true">&raquo;</span></a></li>
                        </ul>
                    </nav>
                </div>
            }

        </div>
    }

</div>
