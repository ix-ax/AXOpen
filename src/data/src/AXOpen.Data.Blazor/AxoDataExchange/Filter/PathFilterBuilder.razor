<div class="btn-group">
    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @(!string.IsNullOrEmpty(SelectedProperty) ? SelectedProperty : "Select Path")
    </button>
    <ul class="dropdown-menu">
        @foreach (var property in builder.GetCurrentObjProperties())
        {
            <li>
                <a class="dropdown-item" href="#" @onclick="async () => await builder.SelectedPropertyChanged(property)">
                    @property
                </a>
            </li>
        }
    </ul>
</div>



<!-- Line 2: Display the current object path -->
<div class="mt-2">
    <strong>Current Path:</strong> @builder.GetCurrentPath()
</div>


