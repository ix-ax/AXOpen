<div class="btn-group">
    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @(!string.IsNullOrEmpty(SelectedBuilder?.Name) ? SelectedBuilder?.Name : "Select DataEntity")
    </button>
    <ul class="dropdown-menu">
        @foreach (var root in this.GetRootNames())
        {
            <li>
                <a class="dropdown-item" href="#" @onclick="async () => await AddFilterBuilderForType(root)">
                    @root
                </a>
            </li>
        }
    </ul>
</div>

@if (SelectedBuilder != null)
{
    <PathFilterBuilder @key=SelectedBuilder
                       builder="@SelectedBuilder"></PathFilterBuilder>

}



