@using AXSharp.Connector;
@namespace AXOpen.Data


<!-- Line 1: ComboBox for properties -->
<div>
    <label for="propertyDropdown">Select path:</label>
    <select id="propertyDropdown" class="form-control" @bind="this.SelectedRoot">
        @foreach (var root in this.GetRootNames())
        {
            <option value="@root">@root</option>
        }
    </select>
</div>

<button onclick="@await AddFilterBuilderForType(this.SelectedRoot)">AddFilter</button>


@if (SelectedBuilder != null)
{
    <PathFilterBuilder @key=SelectedBuilder
                       builder="@SelectedBuilder"></PathFilterBuilder>

}



