@using AXSharp.Connector;

<div data-data-exchange-accordion-component class="accordion-item">
    <div class="accordion-button @(IsExpanded ? "active" : null) flex flex-wrap items-center p-0!">
        <input type="checkbox" class="checkbox" @attributes="Vm.InDictionary(Vm.GetCustomExportDataValue(GetFragment().ToString(), String.Join('.', Parent, SourceTwinElement.GetSymbolTail())))" @onchange="@((ChangeEventArgs __e) => Vm.ChangeCustomExportDataValue(__e, GetFragment().ToString(), String.Join('.', Parent, SourceTwinElement.GetSymbolTail())))">
        <div class="flex-1 flex flex-wrap items-center" @onclick="() => IsExpanded = !IsExpanded">
            <p class="ms-1">@SourceTwinElement.GetSymbolTail()</p>
            <button class="ms-auto cursor-pointer">
                <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 icon-button-rotate " + (IsExpanded ? "rotated" : null))" />
            </button>
        </div>
    </div>
    @if (IsExpanded)
    {
        <div class="accordion-body @(Vm.GetCustomExportDataValue(GetFragment().ToString(), String.Join('.', Parent, SourceTwinElement.GetSymbolTail())) ? null : " opacity-25")">
            @foreach (var item in Vm.GetValueTags(SourceTwinElement.GetType()))
            {
                @if (item is ITwinObject)
                {
                    <DataExchangeAccordionComponent SourceTwinElement="item" Vm="Vm" Fragment="GetFragment()" Parent="@(String.Join('.', Parent, SourceTwinElement.GetSymbolTail()))" />
                }
                else if (item is ITwinPrimitive)
                {
                    <div class="flex flex-wrap items-center ms-4 me-6 checkbox-group">
                        <input type="checkbox" id="@(String.Concat(GetFragment().ToString(), SourceTwinElement.GetSymbolTail(), item.ToString()))" @attributes="Vm.InDictionary(Vm.GetCustomExportDataValue(GetFragment().ToString(), String.Join('.', Parent, SourceTwinElement.GetSymbolTail(), item.GetSymbolTail())))" @onchange="@((ChangeEventArgs __e) => Vm.ChangeCustomExportDataValue(__e, GetFragment().ToString(), String.Join('.', Parent, SourceTwinElement.GetSymbolTail(), item.GetSymbolTail())))">
                        <label for="@(String.Concat(GetFragment().ToString(), SourceTwinElement.GetSymbolTail(), item.ToString()))">@item.GetSymbolTail()</label>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public ITwinElement SourceTwinElement { get; set; }

    [Parameter]
    public ITwinElement? Fragment { get; set; } = null;

    [Parameter]
    public DataExchangeViewModel Vm { get; set; }

    [Parameter]
    public string? Parent { get; set; } = null;

    private bool IsExpanded { get; set; } = false;

    private ITwinElement GetFragment()
    {
        if(Fragment != null)
            return Fragment;

        return SourceTwinElement;
    }
}