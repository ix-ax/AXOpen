@namespace AXOpen.Data
@using AXOpen.Base
@using AXOpen.Data;
@using AXSharp.Connector;
@using CommunityToolkit.Mvvm.ComponentModel;
@using CommunityToolkit.Mvvm.Messaging;
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms;
@using AXOpen.Data.Interfaces;
@using AXOpen.Core;
@using AXOpen.Data;
@using AXOpen.Data.Query;
@using Operon.Components
@using Operon.Icons

@if (Vm == null)
{
    <h5>Loading...</h5>
}
else
{
    <div class="p-1">

        <div class="flex flex-wrap">
            @if (Presentation.Equals("Command"))
            {
                @if (EnableCreate)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_create">
                        <Authorized>
                            <button type="button" class="btn btn-primary" @onclick='() => { _modalCreateOpen = !_modalCreateOpen; ButtonOperationName = "Create"; }'>
                                <Operon.Icons.HeroIcon Icon="plus" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                <span>@Localizer["Create"]</span>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }

                @if (EnableCreateNewFromPlc)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_load_from_plc">
                        <Authorized>
                            <button type="button" class="btn btn-primary ms-2" @onclick='() => { _modalCreateOpen = !_modalCreateOpen; ButtonOperationName = "LoadFromPlc"; }'>
                                <Operon.Icons.HeroIcon Icon="cloud-arrow-down" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                <span>@Localizer["Create New from PLC"]</span>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }


                @if (EnableExport)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_export">
                        <Authorized>
                            <button type="button" class="btn btn-primary ms-2" @onclick='async () => { _modalExportOpen = !_modalExportOpen; await LoadCustomExportDataAsync();}'>@Localizer["Export"]</button>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_import">
                        <Authorized>
                            <button type="button" class="btn btn-primary ms-2" @onclick="async () => { _modalImportOpen = !_modalImportOpen; await LoadCustomExportDataAsync(); }">@Localizer["Import"]</button>
                        </Authorized>
                    </AuthorizeView>
                }
            }

            <div class="btn-group ms-auto" role="group">

                @if (!AdvanceFilterConfig)
                {

                    @if (EnableSorting)
                    {
                        <div class="btn-group" role="group">
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => _dropdownSortCollapsed = !_dropdownSortCollapsed">@Vm.DefaulSorting.MemberName.ToString()</button>
                            @if (!_dropdownSortCollapsed)
{
                            <div class="dropdown-body">
                                <a class="block px-4 py-2 text-sm text-gray-700 @(Vm.DefaulSorting.MemberName == "Default" ? "active" : "")" @onclick='() => setSortExpresionAsync("Default")'>Default</a>
                                @foreach (var element in SortElements)
                                {
                                    <a class="block px-4 py-2 text-sm text-gray-700 @(Vm.DefaulSorting.MemberName == element ? "active" : "")" @onclick='() => setSortExpresionAsync(element)'>@element</a>
                                }
                            </div>
                            }
                        </div>

                        <button class="btn btn-outline-secondary me-1" type="button" name="sort" aria-label="@(Vm.DefaulSorting.IsAscending ? "Sorting ascending" : "Sorting descending")" title="@(Vm.DefaulSorting.IsAscending ? "Sorting ascending" : "Sorting descending")" @onclick="() => setSortAscendingAsync()">
                            <Operon.Icons.HeroIcon Icon="filter" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                        </button>
                    }

                    <QuerySymbolConfigurationView SymbolConfiguration="@Vm.DefaulQueryDataEntityId" HideDescripion="false"></QuerySymbolConfigurationView>
                    <form @onsubmit="() => Vm.Filter()" class="btn-group">
                        <button class="btn btn-secondary" type="submit" name="searchbutton">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                        </button>
                    </form>

                }
                @if (EnableFiltering)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_filter_advanced">
                        <Authorized>

                            <button class="btn @(AdvanceFilterConfig ? "btn-warning" : "btn-primary") mx-2" name="advanceConfig" @onclick="()=>{AdvanceFilterConfig = !AdvanceFilterConfig;}">
                                @if (AdvanceFilterConfig)
                                {
                                    <span>
                                        <Operon.Icons.HeroIcon Icon="funnel" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                        <span>@Localizer["Hide filter"]</span>
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        <Operon.Icons.HeroIcon Icon="funnel" Type="Operon.Icons.IconType.Solid" Class="size-5" />
                                        <span>@Localizer["Filter"]</span>
                                    </span>
                                }
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }
            </div>
        </div>

        @if (AdvanceFilterConfig)
        {
            <div class="flex flex-wrap items-center gap-2 rounded m-1">
                <DataExchangeQuery Exchange="@Vm"></DataExchangeQuery>
            </div>
        }

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>DataEntityId</th>

                    <CascadingValue Value="this" IsFixed>
                        @ChildContent
                    </CascadingValue>
                    @foreach (ColumnData column in Columns)
                    {
                        if (column.HeaderName is null || column.HeaderName == "")
                        {
                            <th>@column.BindingValue</th>
                        }
                        else
                        {
                            <th>@column.HeaderName</th>
                        }
                    }

                    @if (Presentation.Equals("Command"))
                    {
                        <th>@Localizer["Actions"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Vm.IsBusy)
                {

                    <tr>
                        <td>
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </td>
                    </tr>

                }
                else if (!Vm.Records.Any())
                {
                    <tr>
                        <td>
                            <h3>@Localizer["Collection is empty"]</h3>
                        </td>
                    </tr>

                }
                else
                {
                    @foreach (var item in Vm.Records.ToList())
                    {
                        <tr class="@((!ModalDataView && Vm.SelectedRecord == item) ? "active" : null)">
                            @if (ModalDataView)
                            {
                                <td class="cursor-pointer" @onclick="() => { _modalViewOpen = !_modalViewOpen; Vm.SelectedRecord = item; }">@item.DataEntityId</td>

                                @foreach (ColumnData column in Columns.ToList())
                                {

                                    try
                                    {
                                        var propertyValue = PropertyHelper.GetPropertyValue(item, column.BindingValue);

                                        if (column.Clickable)
                                        {

                                            @if (column.PresentationTemplate != null)
                                            {
                                                // insert template
                                                <td class="cursor-pointer" @onclick="() => { _modalViewOpen = !_modalViewOpen; Vm.SelectedRecord = item; }">@column.RenderTemplateWithValue(propertyValue)</td>

                                            }
                                            else
                                            {
                                                <td class="cursor-pointer" @onclick="() => { _modalViewOpen = !_modalViewOpen; Vm.SelectedRecord = item; }">@(propertyValue)</td>
                                            }

                                        }
                                        else
                                        {
                                            @if (column.PresentationTemplate != null)
                                            {
                                                // insert template
                                                <td> @column.RenderTemplateWithValue(propertyValue)</td>
                                            }
                                            else
                                            {
                                                <td>@(propertyValue)</td>
                                            }

                                        }
                                    }
                                    catch (Exception ex)
                                    {
                                        <td>@ex.Message</td>
                                    }
                                }
                            }
                            else
                            {
                                <td class="cursor-pointer" @onclick="() => Vm.SelectedRecord = item">@item.DataEntityId</td>

                                @foreach (ColumnData column in Columns)
                                {
                                    try
                                    {
                                        var propertyValue = PropertyHelper.GetPropertyValue(item, column.BindingValue);
                                        if (column.Clickable)
                                        {
                                            @if (column.PresentationTemplate != null)
                                            {
                                                // insert template
                                                <td class="cursor-pointer" @onclick="() => Vm.SelectedRecord = item">@column.RenderTemplateWithValue(propertyValue)</td>
                                            }
                                            else
                                            {
                                                <td class="cursor-pointer" @onclick="() => Vm.SelectedRecord = item">@(propertyValue)</td>
                                            }
                                        }
                                        else
                                        {

                                            @if (column.PresentationTemplate != null)
                                            {
                                                // insert template
                                                <td> @column.RenderTemplateWithValue(propertyValue)</td>
                                            }
                                            else
                                            {
                                                <td>@(propertyValue)</td>
                                            }
                                        }
                                    }
                                    catch (Exception ex)
                                    {
                                        <td>@ex.Message</td>
                                    }

                                }
                            }

                            @if (Presentation.Equals("Command"))
                            {
                                <td>

                                    @if (EnableCopy)
                                    {
                                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_copy">
                                            <Authorized>
                                                <button type="button" class="btn btn-primary px-3 py-0" title="Copy" @onclick='() => { _modalCreateOpen = !_modalCreateOpen; Vm.SelectedRecord = item; ButtonOperationName = "Copy"; Vm.Locked(); }'>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-files" viewBox="0 0 16 16">
                                                        <path d="M13 0H6a2 2 0 0 0-2 2 2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2 2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm0 13V4a2 2 0 0 0-2-2H5a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1zM3 4a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4z" />
                                                    </svg>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_edit">
                                        <Authorized>
                                            <button type="button" class="btn btn-primary px-3 py-0" title="Edit" @onclick="() => { _modalEditOpen = !_modalEditOpen; Vm.SelectedRecord = item; Vm.Locked(); }">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                                    <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                                    <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z" />
                                                </svg>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
@* 
                                    @if (EnableUpdateFromPlc)
                                    {
                                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_update_from_plc">
                                            <Authorized>
                                                <button type="button" class="btn btn-warning px-3 py-0" title="Update" data-bs-toggle="modal" data-bs-target="#createModal-@ViewGuid"
                                                        @onclick='() => { Vm.SelectedRecord = item; ButtonOperationName = "UpdateFromPlc"; Vm.Locked(); }'>
                                                    <i class="bi bi-cloud-upload"></i>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    } *@

                                    @if (EnableSendToPlc)
                                    {
                                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_send_to_plc">
                                            <Authorized>
                                                <button type="button" class="btn btn-warning px-3 py-0" title="Send To Plc" @onclick='() => { _modalAckSendToPlcOpen = !_modalAckSendToPlcOpen; Vm.SelectedRecord = item;}'>
                                                    <HeroIcon Icon="computer-desktop" Type="Operon.Icons.IconType.Solid" Class="size-5" />
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }

                                    @if (EnableDelete)
                                    {
                                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_delete">
                                            <Authorized>
                                                <button type="button" class="btn btn-danger px-3 py-0" title="Delete" @onclick="() => { _modalDeleteOpen = !_modalDeleteOpen; Vm.SelectedRecord = item; Vm.Locked(); }">
                                                    <HeroIcon Icon="trash" Type="Operon.Icons.IconType.Solid" Class="size-5" />
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }

                                </td>
                            }
                        </tr>
                    }
                }

            </tbody>
        </table>

        <Operon.Components.Pagination Count="(int)Vm.FilteredCount" @bind-PageSize="Limit" @bind-Selected="Page" PageSizeAndSelectedChangedAsync="PageSizeAndSelectedChangedAsync" />
    </div>
    @if (!ModalDataView && Vm.SelectedRecord != null)
    {
        <div class="simple-border p-2">
            <RenderableContentControl Context="Vm.RefUIData" Presentation="ShadowDisplay"></RenderableContentControl>
            @if (Presentation.Equals("Command"))
            {
                <div class="flex justify-end mt-3">

                    @if (EnableCopy)
                    {
                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_copy">
                            <Authorized>
                                <button type="button" class="btn btn-primary mx-1" @onclick='() => { _modalCreateOpen = !_modalCreateOpen; ButtonOperationName = "Copy"; Vm.Locked();}'>@Localizer["Copy"]</button>
                            </Authorized>
                        </AuthorizeView>
                    }

                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_edit">
                        <Authorized>
                            <button type="button" class="btn btn-primary mx-1" @onclick="() => { _modalEditOpen = !_modalEditOpen; Vm.Locked(); }">@Localizer["Edit"]</button>
                        </Authorized>
                    </AuthorizeView>

                    @if (EnableSendToPlc)
                    {
                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_send_to_plc">
                            <Authorized>
                                <button type="button" class="btn btn-primary mx-1" @onclick="() => _modalAckSendToPlcOpen = !_modalAckSendToPlcOpen">@Localizer["Send to PLC"]</button>
                            </Authorized>
                        </AuthorizeView>
                    }

                    @if (EnableDelete)
                    {
                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_delete">
                            <Authorized>
                                <button type="button" class="btn btn-danger mx-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@ViewGuid" @onclick="() => { Vm.Locked(); }">@Localizer["Delete"]</button>
                            </Authorized>
                        </AuthorizeView>
                    }
                </div>
            }
        </div>
    }

    <Modal @bind-Value="_modalCreateOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                @if (ButtonOperationName.Equals("Create"))
                    {
                        <h2 class="text-xl font-bold">@Localizer["Create new item"]</h2>
                    }
                    else if (ButtonOperationName.Equals("Copy"))
                    {
                        <h2 class="text-xl font-bold">@Localizer["Copy item"]</h2>
                    }
                    else if (ButtonOperationName.Equals("LoadFromPlc"))
                    {
                        <h2 class="text-xl font-bold">@Localizer["Load item from PLC"]</h2>
                    }
                    else if (ButtonOperationName.Equals("UpdateFromPlc"))
                    {
                        <h2 class="text-xl font-bold">@Localizer["Update item from PLC"]</h2>
                    }
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => { _modalCreateOpen = false; Vm.UnLocked(); }">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            @if (ButtonOperationName.Equals("UpdateFromPlc"))
                    {
                        @Localizer["Update item \"{0}\" from PLC", Vm?.SelectedRecord?.DataEntityId]
                    }
                    else
                    {
                        <div class="input">
    <label class="me-2" for="id">Id</label>
<input type="text" id="id" @bind="Vm.CreateItemId" />
</div>
                    }
                    <div class="flex flex-wrap ms-auto">
                        @if (!Vm.IsLockedByMeOrNull())
                    {
                        <div class="alert alert-danger flex align-center m-0 p-2" role="alert">
                            <div>
                                This repository is locked for editing by another user!
                            </div>
                        </div>
                    }
                    @if (!Vm.IsHashCorrect && ButtonOperationName.Equals("Copy"))
                    {
                        <div class="alert alert-danger flex align-center m-0 p-2" role="alert">
                            <div>
                                This record has external modifications!
                            </div>
                        </div>
                    }

                    @if (Vm.GlobalActions != null)
                    {
                        @if (ButtonOperationName.Equals("Create"))
                        {
                            <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                                    @onclick="async () => {
                                         _modalCreateOpen = false;
                                await Vm.GlobalActions.Create(Vm.CreateItemId);
                                Vm.UpdateObservableRecords();
                                Vm.InvokeStateHasChanged();
                                Vm.UnLocked();
                            }">
                                <span> @Localizer["Create in ALL repositories"]</span>
                            </button>
                        }
                        else if (ButtonOperationName.Equals("Copy"))
                        {
                            <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                                    @onclick="async () => {
                                         _modalCreateOpen = false;
                                await Vm.GlobalActions.Copy(Vm.SelectedRecord.DataEntityId, Vm.CreateItemId);
                                Vm.UpdateObservableRecords();
                                Vm.InvokeStateHasChanged();
                                Vm.UnLocked();
                            }">
                                <span> @Localizer["Copy in ALL repositories"]</span>
                            </button>
                        }
                        else if (ButtonOperationName.Equals("LoadFromPlc"))
                        {
                            <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                                    @onclick="async () => {
                                         _modalCreateOpen = false;
                                await Vm.GlobalActions.CreateNewFromPlc(Vm.CreateItemId);
                                Vm.UpdateObservableRecords();
                                Vm.InvokeStateHasChanged();
                                Vm.UnLocked();
                            }">
                                <span> @Localizer["Load from ALL PLCs"]</span>
                            </button>
                        }
                        @* else if (ButtonOperationName.Equals("UpdateFromPlc"))
                        {
                            <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" data-bs-dismiss="modal"
                                    @onclick="async () => {
                                await Vm.GlobalActions.UpdateFromPlc(Vm.SelectedRecord.DataEntityId);
                                Vm.UpdateObservableRecords();
                                Vm.InvokeStateHasChanged();
                                Vm.UnLocked();
                            }">
                                <i class="bi bi-hdd-rack me-2"></i>
                                <span> @Localizer["Update from ALL PLCs"]</span>
                            </button>
                        } *@
                    }


                    @if (ButtonOperationName.Equals("Create"))
                    {
                        <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="() => {  _modalCreateOpen = false; Vm.CreateNew(); Vm.UnLocked(); }">
                            <span> @Localizer["Create in THIS repository"]</span>
                        </button>
                    }
                    else if (ButtonOperationName.Equals("Copy"))
                    {
                        <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="() => {  _modalCreateOpen = false;Vm.Copy(); Vm.UnLocked(); }">
                            <span> @Localizer["Copy in THIS repository"]</span>
                        </button>
                    }
                    else if (ButtonOperationName.Equals("LoadFromPlc"))
                    {
                        <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="() => {  _modalCreateOpen = false;Vm.LoadFromPlc(); Vm.UnLocked(); }">
                            <span> @Localizer["Load from PLC into THIS repository"]</span>
                        </button>
                    }
                   @*  else if (ButtonOperationName.Equals("UpdateFromPlc"))
                    {
                        <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" data-bs-dismiss="modal" @onclick="() => { Vm.UpdateFromPlc(); Vm.UnLocked(); }">
                            <i class="bi bi-hdd me-2"></i>
                            <span> @Localizer["Update from PLC into THIS repository"]</span>
                        </button>
                    } *@

                        <button class="btn btn-outline-red" @onclick="() => { _modalCreateOpen = false; Vm.UnLocked(); }">@Localizer["Close"]</button>
                    </div>
        </div>
    </Modal>

    <Modal @bind-Value="_modalViewOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Vm.SelectedRecord?.DataEntityId</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalViewOpen = false">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            <RenderableContentControl Context="Vm.RefUIData" Presentation="ShadowDisplay"></RenderableContentControl>
            <div class="flex flex-wrap ms-auto">
                @if (Presentation.Equals("Command"))
                    {
                        @if (EnableDelete)
                        {
                            <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_delete">
                                <Authorized>
                                    <button type="button" class="btn btn-danger me-auto" @onclick="() => { _modalViewOpen = false; _modalDeleteOpen = !_modalCreateOpen;Vm.Locked(); }">@Localizer["Delete"]</button>
                                </Authorized>
                            </AuthorizeView>
                        }

                        @if (EnableCopy)
                        {
                            <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_copy">
                                <Authorized>

                                    <button type="button" class="btn btn-primary" @onclick='() => { _modalViewOpen = false; _modalCreateOpen = !_modalCreateOpen; ButtonOperationName = "Copy"; Vm.Locked(); }'>@Localizer["Copy"]</button>
                                </Authorized>
                            </AuthorizeView>
                        }

                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_edit">
                            <Authorized>

                                <button type="button" class="btn btn-primary" @onclick="() => { _modalViewOpen = false; _modalEditOpen = !_modalEditOpen; Vm.Locked(); }">@Localizer["Edit"]</button>
                            </Authorized>
                        </AuthorizeView>

                        @if (EnableSendToPlc)
                        {
                            <AuthorizeView Roles="@DataExchangeRoleNames.can_data_send_to_plc">
                                <Authorized>

                                    <button type="button" class="btn btn-primary" @onclick="() => { _modalViewOpen = false; _modalAckSendToPlcOpen = !_modalAckSendToPlcOpen; }">@Localizer["Send to PLC"]</button>
                                </Authorized>
                            </AuthorizeView>
                        }

                    }
                    <button type="button" class="btn btn-primary" @onclick="() => { _modalViewOpen = false; _modalChangesOpen = !_modalChangesOpen; }">@Localizer["Changes"]</button>
                <button class="btn btn-outline-red ms-auto" @onclick="() => _modalViewOpen = false">@Localizer["Close"]</button>
            </div>
            
        </div>
    </Modal>

    <Modal @bind-Value="_modalChangesOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Vm.SelectedRecord?.DataEntityId</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalChangesOpen = false">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>DateTime</th>
                                <th>UserName</th>
                                <th>HumanReadable</th>
                                <th>OldValue</th>
                                <th>NewValue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Vm.Changes.Any())
                            {
                                <tr>
                                    <td>
                                        <h3>Collection is empty</h3>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Vm.Changes.ToList())
                                {
                                    <tr>
                                        <td>@item.DateTime</td>
                                        <td>@item.UserName</td>
                                        <td>@item.ValueTag?.HumanReadable</td>
                                        <td>@item.OldValue</td>
                                        <td>@item.NewValue</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
            <div class="flex flex-wrap ms-auto">
                <button type="button" class="btn btn-primary" @onclick="() => { _modalChangesOpen = false; _modalViewOpen = !_modalViewOpen; }">Back</button>
                <button class="btn btn-outline-red ms-auto" @onclick="() => _modalChangesOpen = false">Close modal</button>
            </div>
        </div>
    </Modal>

    <Modal @bind-Value="_modalEditOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Vm.SelectedRecord?.DataEntityId</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => { _modalEditOpen = false; Vm.UnLocked(); ReloadRecordAfterEditWithoutModal(); }">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            @if (Vm.IsLockedByMeOrNull())
                    {
                        <RenderableContentControl Context="Vm.RefUIData" Presentation="ShadowControl"></RenderableContentControl>
                    }
                    else
                    {
                        <RenderableContentControl Context="Vm.RefUIData" Presentation="ShadowDisplay"></RenderableContentControl>
                    }
            <div class="flex flex-wrap ms-auto">
                @if (!Vm.IsLockedByMeOrNull())
                    {
                        <div class="alert alert-danger flex align-center m-0 p-2" role="alert">
                            <div>
                                @Localizer["This repository is locked for editing by another user!"]
                            </div>
                        </div>
                    }
                    @if (!Vm.IsHashCorrect)
                    {
                        <div class="alert alert-danger flex align-center m-0 p-2" role="alert">
                            <div>
                                @Localizer["This record has external modifications!"]
                            </div>
                        </div>
                    }
                    @* <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" data-bs-dismiss="modal" @onclick="async () => { await Vm.Edit(); Vm.UnLocked(); }">@Localizer["Save"]</button> *@
                    <button type="button" class="btn btn-primary mx-1 @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="() => { _modalEditOpen = false; _modalAckEditUpdateOpen = !_modalAckEditUpdateOpen; }">@Localizer["Update"]</button>

                <button class="btn btn-outline-red ms-auto" @onclick="() => { Vm.UnLocked(); ReloadRecordAfterEditWithoutModal(); _modalEditOpen = false; }">@Localizer["Close"]</button>
            </div>
        </div>
    </Modal>

    <Modal @bind-Value="_modalDeleteOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Localizer["Delete"] @Vm.SelectedRecord?.DataEntityId ?</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => { _modalDeleteOpen = false; Vm.UnLocked(); }">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            <div class="flex flex-wrap ms-auto">
                @if (!Vm.IsLockedByMeOrNull())
                    {
                        <div class="alert alert-danger flex align-center m-0 p-2" role="alert">
                            <div>
                                @Localizer["This repository is locked for editing by another user!"]
                            </div>
                        </div>
                    }
                    @if (!Vm.IsHashCorrect)
                    {
                        <div class="alert alert-danger flex align-center m-0 p-2" role="alert">
                            <div>
                                @Localizer["This record has external modifications!"]
                            </div>
                        </div>
                    }

                    @if (Vm.GlobalActions != null)
                    {
                        <button type="button" class="btn btn-danger @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                                @onclick="async () =>
                        {
                            _modalDeleteOpen = false;
                            await Vm.GlobalActions.Delete(Vm.SelectedRecord.DataEntityId);
                            Vm.UnLocked();
                            Vm.UpdateObservableRecords();
                            Vm.InvokeStateHasChanged();
                        }">
                            <span>@Localizer["Delete in All repositories"]</span>
                        </button>
                    }

                    <button type="button" class="btn btn-danger @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                            @onclick="() => {
                                _modalDeleteOpen = false;
                        Vm.Delete();
                        Vm.UnLocked();
                    }">
                        <span>@Localizer["Delete in this repository"]</span>
                    </button>

                <button class="btn btn-outline-red ms-auto" @onclick="() => { _modalDeleteOpen = false; Vm.UnLocked(); }">@Localizer["Close"]</button>
            </div>
        </div>
    </Modal>

    <Modal @bind-Value="_modalAckSendToPlcOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Localizer["Send data to PLC"] : "@Vm.SelectedRecord?.DataEntityId" ?</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalAckSendToPlcOpen = false">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            <div class="flex flex-wrap ms-auto">
                @if (Vm.GlobalActions != null)
                    {
                        <button type="button" class="btn btn-primary"
                                @onclick="async () => {
                                    _modalAckSendToPlcOpen = false;
                                await Vm.GlobalActions.SendToPlc(Vm.SelectedRecord.DataEntityId);}">
                            <span> @Localizer["Send data to ALL PLCs"]</span>
                        </button>

                    }
                    <button type="button" class="btn btn-primary"
                            @onclick="() => {
                                _modalAckSendToPlcOpen = false;
                        Vm.SendToPlc();
                        StateHasChanged();}">

                        <span> @Localizer["Send data to THIS PLC"]</span>
                    </button>

                <button class="btn btn-outline-red ms-auto" @onclick="() => _modalAckSendToPlcOpen = false">@Localizer["Close"]</button>
            </div>
        </div>
    </Modal>

    <Modal @bind-Value="_modalAckEditUpdateOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Localizer["Update"] record : "@Vm.SelectedRecord?.DataEntityId"?</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalAckEditUpdateOpen = false">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            <div class="flex flex-wrap ms-auto">
                <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="async () => { _modalAckEditUpdateOpen = false; await Vm.Edit(); Vm.UnLocked(); }">@Localizer["Update"]</button>

                <button class="btn btn-outline-red ms-auto" @onclick="() => { _modalAckEditUpdateOpen = false; Vm.UnLocked(); ReloadRecordAfterEditWithoutModal(); }">Close modal</button>
            </div>
        </div>
    </Modal>

    <Modal @bind-Value="_modalExportOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Localizer["Export data"]</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="() => { _modalExportOpen = false; ClearClientFiles(); }">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            @if (Vm.exportStatus == eOperationStatus.Busy)
                    {
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    }
                    @if (Vm.exportStatus == eOperationStatus.Done)
                    {
                        <a download href="@ExportDownloadUrl">@Localizer["Download"]</a>
                    }

                    @if (Vm.exportStatus == eOperationStatus.Failed)
                    {
                        <span class="text-muted"> "Export failed"</span>
                    }
            <div class="flex flex-wrap ms-auto">
                @switch (Vm.ExportSet.ExportMode)
                    {
                        case eExportMode.First:
                            <span class="text-muted"> "The first @Vm.ExportSet.FirstNumber items will be exported to a @Vm.ExportSet.ExportFileType."</span>
                            break;
                        case eExportMode.Last:
                            <span class="text-muted">"The last @Vm.ExportSet.FirstNumber items will be exported to a @Vm.ExportSet.ExportFileType."</span>
                            break;
                        case eExportMode.Exact:
                            <span class="text-muted">"Items from @Vm.ExportSet.FirstNumber to @Vm.ExportSet.SecondNumber will be exported to a @Vm.ExportSet.ExportFileType."</span>
                            break;
                    }

                    <button type="button" class="btn btn-secondary" @onclick="() => {  _modalExportOpen = false; _modalExportCustomOpen = !_modalExportCustomOpen; }">@Localizer["Customize export options"]</button>

                    <button type="button" class="btn btn-primary" @onclick='async () => {
                        ClearClientFiles();
                        await Vm.ExportDataAsync(ExportPath);
                        }'>
                        <strong>@Localizer["Export"]</strong>
                    </button>

                <button class="btn btn-outline-red ms-auto" @onclick="() => { _modalExportOpen = false; ClearClientFiles();}">@Localizer["Close"]</button>
            </div>
        </div>
    </Modal>

    <Modal @bind-Value="_modalImportOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Localizer["Import data"]</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="async () => { _modalImportOpen = false; Vm.importStatus = eOperationStatus.Ready; await SaveCustomExportDataAsync(); }">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            <div class="mb-3">

                        <label for="formFile" class="form-label">@Localizer["File input"]</label>

                        <InputFile @key=@(_inputFileId) class="form-control col-10" id="formFile" accept=".zip" OnChange="@LoadFile" />

                        @if (Vm.importStatus == eOperationStatus.Busy)
                        {
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        }

                        @if (Vm.importStatus == eOperationStatus.Done)
                        {
                            <span class="text-muted"> "Import successed"</span>
                        }

                        @if (Vm.importStatus == eOperationStatus.Failed)
                        {
                            <span class="text-muted"> "Import failed"</span>
                        }

                    </div>
            <div class="flex flex-wrap ms-auto">
                <div class="col-12">
                        <div class="btn-group mt-2" role="group" aria-label="File type">
                            @foreach (var item in Vm.DataExchange.Exporters)
                            {
                                <button type="button" class="btn @(Vm.ExportSet.ExportFileType == item.Key ? "btn-primary" : "btn-outline-primary")" @onclick="() => Vm.ExportSet.ExportFileType = item.Key">@item.Key</button>
                            }
                        </div>
                        <div class="input-group mt-2 d-inline-flex w-25 align-middle">
                            <span class="input-group-text">@Localizer["Separator"]</span>
                            <input type="text" class="form-control" placeholder="Separator" aria-label="Separator" @bind="Vm.ExportSet.Separator">
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary @(_fileLoadingStatus != eOperationStatus.Done ? "disabled" : "")"
                            @onclick='async () => {
                            Vm.importStatus = eOperationStatus.Busy;
                            await Vm.ImportDataAsync(ImportPath);
                            _inputFileId = Guid.NewGuid().ToString();
                            _fileLoadingStatus =  eOperationStatus.Ready;}'>
                        @Localizer["Import"]
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="async () => { _modalImportOpen = false; Vm.importStatus = eOperationStatus.Ready; await SaveCustomExportDataAsync();}">@Localizer["Close"]</button>
            </div>
        </div>
    </Modal>

    <Modal @bind-Value="_modalExportCustomOpen">
        <div class="card w-120">
            <div class="flex mb-4">
                <h2 class="text-xl font-bold">@Localizer["Export data"]</h2>
                <button class="cursor-pointer ms-auto my-auto" @onclick="async () => { _modalExportCustomOpen = false; await SaveCustomExportDataAsync();}">
                    <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
                </button>
            </div>
            <div class="accordion">
                        @{
                            bool firstIteration = true;
                        }
                        @foreach (var fragment in Vm.RefUIData.GetChildren().DefaultIfEmpty(Vm.RefUIData))
                        {
                            <div class="accordion-item">
                                <div class="accordion-header">
                                    <div class="input-group flex-nowrap">
                                        <div class="input-group-text bg-transparent border-0">
                                            <input class="form-check-input mt-0" type="checkbox" @attributes="Vm.InDictionary(Vm.GetCustomExportDataValue(fragment.ToString()))" @onchange="@((ChangeEventArgs __e) => Vm.ChangeCustomExportDataValue(__e, fragment.ToString()))">
                                        </div>
                                        <button class="accordion-button @(firstIteration ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@fragment.ToString().Replace(".", "_")-@ViewGuid" aria-expanded="@(firstIteration ? "true" : "false")" aria-controls="@fragment.ToString().Replace(".", "_")-@ViewGuid">
                                            @fragment.ToString()
                                        </button>
                                    </div>
                                </div>
                                <div id="@fragment.ToString().Replace(".", "_")-@ViewGuid" class="accordion-collapse collapse @(firstIteration ? "show" : "")">
                                    <div class="accordion-body @(Vm.GetCustomExportDataValue(fragment.ToString()) ? "" : "opacity-25")">
                                        <ul class="list-group">
                                            @foreach (var item in Vm.GetValueTags(fragment.GetType()))
                                            {
                                                @if (item is ITwinPrimitive)
                                                {
                                                    <li class="list-group-item">
                                                        <input class="form-check-input me-1" type="checkbox" id="@fragment.ToString()-@item.Symbol-@ViewGuid" @attributes="Vm.InDictionary(Vm.GetCustomExportDataValue(fragment.ToString(), item.Symbol))" @onchange="@((ChangeEventArgs __e) => Vm.ChangeCustomExportDataValue(__e, fragment.ToString(), item.Symbol))">
                                                        <label class="form-check-label ms-3" for="@fragment.ToString()-@item.Symbol-@ViewGuid">@item.GetSymbolTail()</label>
                                                    </li>
                                                }
                                                else if (item is ITwinObject)
                                                {
                                                    <AXOpen.Data.Blazor.AxoDataExchange.DataExchangeAccordionComponent AccordionContent="item" Vm="Vm" Fragment="fragment" Parent="_data" ViewGuid="ViewGuid" />
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            firstIteration = false;
                        }
                    </div>
            <div class="flex flex-wrap ms-auto">
                <div class="w-full">
                        <div class="input-group mt-2">
                            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@Localizer[Vm.ExportSet.ExportMode.ToString()]</button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item @(Vm.ExportSet.ExportMode == eExportMode.First ? "active" : "")" @onclick="() => Vm.ExportSet.ExportMode = eExportMode.First">@Localizer["First"]</a></li>
                                <li><a class="dropdown-item @(Vm.ExportSet.ExportMode == eExportMode.Last ? "active" : "")" @onclick="() => Vm.ExportSet.ExportMode = eExportMode.Last">@Localizer["Last"]</a></li>
                                <li><a class="dropdown-item @(Vm.ExportSet.ExportMode == eExportMode.Exact ? "active" : "")" @onclick="() => Vm.ExportSet.ExportMode = eExportMode.Exact">@Localizer["Exact"]</a></li>
                            </ul>
                            @if (Vm.ExportSet.ExportMode == eExportMode.Exact)
                            {
                                <div class="input-group-text">From</div>
                                <input type="text" class="form-control" placeholder="From" @bind="Vm.ExportSet.FirstNumber">
                                <div class="input-group-text">To</div>
                                <input type="text" class="form-control" placeholder="To" @bind="Vm.ExportSet.SecondNumber">
                            }
                            else
                            {
                                <input type="text" class="form-control" @bind="Vm.ExportSet.FirstNumber">
                            }
                            <div class="input-group-text">records</div>
                        </div>
                    </div>
                    <div class="w-full">
                        <div class="btn-group mt-2" role="group" aria-label="File type">
                            @foreach (var item in Vm.DataExchange.Exporters)
                            {
                                <button type="button" class="btn @(Vm.ExportSet.ExportFileType == item.Key ? "btn-primary" : "btn-outline-primary")" @onclick="() => Vm.ExportSet.ExportFileType = item.Key">@item.Key</button>
                            }
                        </div>
                        <div class="input-group mt-2 d-inline-flex w-25 align-middle">
                            <span class="input-group-text">@Localizer["Separator"]</span>
                            <input type="text" class="form-control" placeholder="Separator" aria-label="Separator" @bind="Vm.ExportSet.Separator">
                        </div>
                    </div>
                    @if (!Vm.GetFragmentsExportedValue())
                    {
                        <div class="alert alert-danger flex align-center m-0 p-2" role="alert">
                            <div>
                                @Localizer["This file may not be able to be imported!"]

                            </div>
                        </div>
                    }
                    <button type="button" class="btn btn-primary ms-2" data-bs-target="#exportModal-@ViewGuid"
                            @onclick='async () => {
                                _modalExportCustomOpen = false;
                            await SaveCustomExportDataAsync(); }'>
                        @Localizer["Back"]
                    </button>
            </div>
        </div>
    </Modal>
}


@code{
    private bool _modalCreateOpen = false;
    private bool _modalExportOpen = false;
    private bool _modalExportCustomOpen = false;
    private bool _modalImportOpen = false;
    private bool _modalViewOpen = false;
    private bool _modalAckSendToPlcOpen = false;
    private bool _modalDeleteOpen = false;
    private bool _modalEditOpen = false;
    private bool _modalChangesOpen = false;
    private bool _modalAckEditUpdateOpen = false;

    private bool _dropdownSortCollapsed = true;
}