@namespace AXOpen.Data
@using AXOpen.Base
@using AXOpen.Data;
@using AXSharp.Connector;
@using CommunityToolkit.Mvvm.ComponentModel;
@using CommunityToolkit.Mvvm.Messaging;
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms;
@using AXOpen.Data.Interfaces;
@using AXOpen.Core;
@using AXOpen.Data;
@using AXOpen.Data.Query;
@using Operon.Components
@using Operon.Components.Dropdown
@using Operon.Icons

@if (Vm == null)
{
    <h5>Loading...</h5>
}
else
{
    <div data-data-exchange-view class="flex flex-wrap justify-between">
        @if (Presentation.Equals("Command"))
        {
            <div class="flex flex-wrap mx-2 gap-2">
                @if (EnableCreate)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_create">
                        <Authorized>
                            <button type="button" class="btn btn-primary items-center" @onclick='() => { _modalCreate.Toggle(); ButtonOperationName = "Create"; }'>
                                <Operon.Icons.HeroIcon Icon="plus" Type="Operon.Icons.IconType.Outline" Class="size-5 me-1" />
                                @Localizer["Create"]
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }
                @if (EnableCreateNewFromPlc)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_load_from_plc">
                        <Authorized>
                            <button type="button" class="btn btn-primary items-center" @onclick='() => { _modalCreate.Toggle(); ButtonOperationName = "LoadFromPlc"; }'>
                                <Operon.Icons.HeroIcon Icon="cloud-arrow-down" Type="Operon.Icons.IconType.Outline" Class="size-5 me-1" />
                                @Localizer["Create New from PLC"]
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }
                @if (EnableExport)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_export">
                        <Authorized>
                            <button type="button" class="btn btn-primary" @onclick='async () => { _modalExport.Toggle(); await LoadCustomExportDataAsync();}'>@Localizer["Export"]</button>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_import">
                        <Authorized>
                            <button type="button" class="btn btn-primary" @onclick="async () => { _modalImport.Toggle(); await LoadCustomExportDataAsync(); }">@Localizer["Import"]</button>
                        </Authorized>
                    </AuthorizeView>
                }
            </div>
        }
        <div class="flex flex-wrap mx-2">
            @if (!AdvanceFilterConfig)
            {
                @if (EnableSorting)
                {
                    <Dropdown @ref="_dropdownSort">
                        <DropdownButton>
                            <button type="button" class="btn btn-primary" @onclick="_dropdownSort.Toggle">
                                <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 icon-button-rotate " + (_dropdownSort?.Open ?? false ? "rotated" : null))" />
                            </button>
                        </DropdownButton>
                        <DropdownBody>
                            <a class="dropdown-item @(Vm.DefaulSorting.MemberName == "Default" ? "active" : "")" @onclick='() => setSortExpresionAsync("Default")'>Default</a>
                            @foreach (var element in SortElements)
                            {
                                <a class="dropdown-item @(Vm.DefaulSorting.MemberName == element ? "active" : "")" @onclick='() => setSortExpresionAsync(element)'>@element</a>
                            }
                        </DropdownBody>
                    </Dropdown>

                    <button type="button" class="btn btn-outline-secondary items-center" title="@(Vm.DefaulSorting.IsAscending ? "Sorting ascending" : "Sorting descending")" @onclick="() => setSortAscendingAsync()">
                        <Operon.Icons.HeroIcon Icon="filter" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                    </button>
                }

                <QuerySymbolConfigurationView SymbolConfiguration="@Vm.DefaulQueryDataEntityId" HideDescripion="true"></QuerySymbolConfigurationView>

                <button type="button" class="btn btn-secondary items-center" @onclick="Vm.Filter">
                    <Operon.Icons.HeroIcon Icon="magnifying-glass" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                </button>
            }
            @if (EnableFiltering)
            {
                <AuthorizeView Roles="@DataExchangeRoleNames.can_data_filter_advanced">
                    <Authorized>
                        <button type="button" class="btn @(AdvanceFilterConfig ? "btn-warning" : "btn-primary") items-center mx-2" @onclick="()=>{AdvanceFilterConfig = !AdvanceFilterConfig;}" title="Advanced filter">
                            <Operon.Icons.HeroIcon Icon="funnel" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                        </button>
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </div>

    @if (AdvanceFilterConfig)
    {
        <div class="flex flex-wrap items-center gap-2 rounded m-1">
            <DataExchangeQuery Exchange="@Vm"></DataExchangeQuery>
        </div>
    }

    <div class="overflow-x-auto">
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th>DataEntityId</th>
                    <CascadingValue Value="this" IsFixed>
                        @ChildContent
                    </CascadingValue>
                    @foreach (ColumnData column in Columns)
                    {
                        if (column.HeaderName is null || column.HeaderName == "")
                        {
                            <th>@column.BindingValue</th>
                        }
                        else
                        {
                            <th>@column.HeaderName</th>
                        }
                    }

                    @if (Presentation.Equals("Command"))
                    {
                        <th class="text-right">@Localizer["Actions"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Vm.IsBusy)
                {
                    <tr>
                        <td colspan="@(Columns.Count + 2)" class="text-center">
                            <IconSpinner Class="w-8 h-8" />
                        </td>
                    </tr>
                }
                else if (!Vm.Records.Any())
                {
                    <tr>
                        <td colspan="@(Columns.Count + 2)">
                            <h3>@Localizer["Collection is empty"]</h3>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Vm.Records.ToList())
                    {
                        <tr>
                            <td class="cursor-pointer" @onclick="() => { _modalView.Toggle(); Vm.SelectedRecord = item; }">@item.DataEntityId</td>

                            @foreach (ColumnData column in Columns.ToList())
                            {
                                try
                                {
                                    var propertyValue = PropertyHelper.GetPropertyValue(item, column.BindingValue);

                                    if (column.Clickable)
                                    {
                                        @if (column.PresentationTemplate != null)
                                        {
                                            <td class="cursor-pointer" @onclick="() => { _modalView.Toggle(); Vm.SelectedRecord = item; }">@column.RenderTemplateWithValue(propertyValue)</td> // Template
                                        }
                                        else
                                        {
                                            <td class="cursor-pointer" @onclick="() => { _modalView.Toggle(); Vm.SelectedRecord = item; }">@(propertyValue)</td>
                                        }
                                    }
                                    else
                                    {
                                        @if (column.PresentationTemplate != null)
                                        {
                                            <td> @column.RenderTemplateWithValue(propertyValue)</td> // Template
                                        }
                                        else
                                        {
                                            <td>@(propertyValue)</td>
                                        }
                                    }
                                }
                                catch (Exception ex)
                                {
                                    <td>@ex.Message</td>
                                }
                            }

                            @if (Presentation.Equals("Command"))
                            {
                                <td class="flex flex-wrap justify-end gap-2">
                                    @if (EnableCopy)
                                    {
                                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_copy">
                                            <Authorized>
                                                <button type="button" class="btn btn-primary items-center" title="Copy" @onclick='() => { _modalCreate.Toggle(); Vm.SelectedRecord = item; ButtonOperationName = "Copy"; Vm.Locked(); }'>
                                                    <Operon.Icons.HeroIcon Icon="clipboard-document" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }

                                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_edit">
                                        <Authorized>
                                            <button type="button" class="btn btn-primary items-center" title="Edit" @onclick="() => { _modalEdit.Toggle(); Vm.SelectedRecord = item; Vm.Locked(); }">
                                                <Operon.Icons.HeroIcon Icon="pencil-square" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>

                                    @if (EnableSendToPlc)
                                    {
                                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_send_to_plc">
                                            <Authorized>
                                                <button type="button" class="btn btn-warning items-center" title="Send To Plc" @onclick='() => { _modalAckSendToPlc.Toggle(); Vm.SelectedRecord = item;}'>
                                                    <HeroIcon Icon="computer-desktop" Type="Operon.Icons.IconType.Solid" Class="size-5" />
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }

                                    @if (EnableDelete)
                                    {
                                        <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_delete">
                                            <Authorized>
                                                <button type="button" class="btn btn-danger items-center" title="Delete" @onclick="() => { _modalDelete.Toggle(); Vm.SelectedRecord = item; Vm.Locked(); }">
                                                    <HeroIcon Icon="trash" Type="Operon.Icons.IconType.Solid" Class="size-5" />
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <Operon.Components.Pagination Count="(int)Vm.FilteredCount" @bind-PageSize="Limit" @bind-Selected="Page" PageSizeAndSelectedChangedAsync="PageSizeAndSelectedChangedAsync" />

    <Modal @ref="_modalCreate">
        <div class="modal-header">
            @if (ButtonOperationName.Equals("Create"))
            {
                <h4>@Localizer["Create new item"]</h4>
            }
            else if (ButtonOperationName.Equals("Copy"))
            {
                <h4>@Localizer["Copy item"]</h4>
            }
            else if (ButtonOperationName.Equals("LoadFromPlc"))
            {
                <h4>@Localizer["Load item from PLC"]</h4>
            }
            else if (ButtonOperationName.Equals("UpdateFromPlc"))
            {
                <h4>@Localizer["Update item from PLC"]</h4>
            }
            <button type="button" class="cursor-pointer ms-auto my-auto" @onclick="() => _modalCreate.CloseModal()">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-body">
            @if (ButtonOperationName.Equals("UpdateFromPlc"))
            {
                @Localizer["Update item \"{0}\" from PLC", Vm?.SelectedRecord?.DataEntityId]
            }
            else
            {
                <BaseInput @bind-Value="Vm.CreateItemId" Label="Id" />
            }
        </div>
        <div class="modal-footer flex justify-end gap-1">
            @if (!Vm.IsLockedByMeOrNull())
            {
                <div class="alert alert-danger">
                    <h6>This repository is locked for editing by another user!</h6>
                </div>
            }
            @if (!Vm.IsHashCorrect && ButtonOperationName.Equals("Copy"))
            {
                <div class="alert alert-danger">
                    <h6>This record has external modifications!</h6>
                </div>
            }

            @if (Vm.GlobalActions != null)
            {
                @if (ButtonOperationName.Equals("Create"))
                {
                    <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                            @onclick="async () => {
                                 _modalCreate.CloseModal();
                        await Vm.GlobalActions.Create(Vm.CreateItemId);
                        Vm.UpdateObservableRecords();
                        Vm.InvokeStateHasChanged();
                        Vm.UnLocked();
                    }">
                        @Localizer["Create in ALL repositories"]
                    </button>
                }
                else if (ButtonOperationName.Equals("Copy"))
                {
                    <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                            @onclick="async () => {
                                 _modalCreate.CloseModal();
                        await Vm.GlobalActions.Copy(Vm.SelectedRecord.DataEntityId, Vm.CreateItemId);
                        Vm.UpdateObservableRecords();
                        Vm.InvokeStateHasChanged();
                        Vm.UnLocked();
                    }">
                        @Localizer["Copy in ALL repositories"]
                    </button>
                }
                else if (ButtonOperationName.Equals("LoadFromPlc"))
                {
                    <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                            @onclick="async () => {
                                 _modalCreate.CloseModal();
                        await Vm.GlobalActions.CreateNewFromPlc(Vm.CreateItemId);
                        Vm.UpdateObservableRecords();
                        Vm.InvokeStateHasChanged();
                        Vm.UnLocked();
                    }">
                        @Localizer["Load from ALL PLCs"]
                    </button>
                }
            }

            @if (ButtonOperationName.Equals("Create"))
            {
                <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="() => { _modalCreate.CloseModal(); Vm.CreateNew(); Vm.UnLocked(); }">
                    @Localizer["Create in THIS repository"]
                </button>
            }
            else if (ButtonOperationName.Equals("Copy"))
            {
                <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="() => { _modalCreate.CloseModal(); Vm.Copy(); Vm.UnLocked(); }">
                    @Localizer["Copy in THIS repository"]
                </button>
            }
            else if (ButtonOperationName.Equals("LoadFromPlc"))
            {
                <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="() => { _modalCreate.CloseModal(); Vm.LoadFromPlc(); Vm.UnLocked(); }">
                    @Localizer["Load from PLC into THIS repository"]
                </button>
            }
            <button type="button" class="btn btn-outline-red" @onclick="() => { _modalCreate.CloseModal();; Vm.UnLocked(); }">@Localizer["Close"]</button>
        </div>
    </Modal>

    <Modal @ref="_modalView">
        <div class="modal-header">
            <h4>@Vm.SelectedRecord?.DataEntityId</h4>
            <button type="button" class="cursor-pointer ms-auto my-auto" @onclick="() => _modalView.CloseModal()">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-body">
            <RenderableContentControl Context="Vm.RefUIData" Presentation="ShadowDisplay"></RenderableContentControl>
        </div>
        <div class="modal-footer flex justify-end gap-1">
            @if (Presentation.Equals("Command"))
            {
                @if (EnableDelete)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_delete">
                        <Authorized>
                            <button type="button" class="btn btn-danger me-auto" @onclick="() => { _modalView.CloseModal(); _modalDelete.Toggle();Vm.Locked(); }">@Localizer["Delete"]</button>
                        </Authorized>
                    </AuthorizeView>
                }

                @if (EnableCopy)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_copy">
                        <Authorized>
                            <button type="button" class="btn btn-primary" @onclick='() => { _modalView.CloseModal(); _modalCreate.Toggle(); ButtonOperationName = "Copy"; Vm.Locked(); }'>@Localizer["Copy"]</button>
                        </Authorized>
                    </AuthorizeView>
                }

                <AuthorizeView Roles="@DataExchangeRoleNames.can_data_item_edit">
                    <Authorized>
                        <button type="button" class="btn btn-primary" @onclick="() => { _modalView.CloseModal(); _modalEdit.Toggle(); Vm.Locked(); }">@Localizer["Edit"]</button>
                    </Authorized>
                </AuthorizeView>

                @if (EnableSendToPlc)
                {
                    <AuthorizeView Roles="@DataExchangeRoleNames.can_data_send_to_plc">
                        <Authorized>
                            <button type="button" class="btn btn-primary" @onclick="() => { _modalView.CloseModal(); _modalAckSendToPlc.Toggle(); }">@Localizer["Send to PLC"]</button>
                        </Authorized>
                    </AuthorizeView>
                }

            }
            <button type="button" class="btn btn-primary" @onclick="() => { _modalView.CloseModal(); _modalChanges.Toggle();; }">@Localizer["Changes"]</button>
            <button type="button" class="btn btn-outline-red" @onclick="() => _modalView.CloseModal()">@Localizer["Close"]</button>
        </div>
    </Modal>

    <Modal @ref="_modalChanges">
        <div class="modal-header">
            <h4>@Vm.SelectedRecord?.DataEntityId</h4>
            <button type="button" class="cursor-pointer ms-auto my-auto" @onclick="() => _modalChanges.CloseModal()">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-body">
            <div class="overflow-x-auto"></div>
             <table class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>DateTime</th>
                            <th>UserName</th>
                            <th>HumanReadable</th>
                            <th>OldValue</th>
                            <th>NewValue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Vm.Changes.Any())
                        {
                            <tr>
                                <td colspan="5">
                                    <h3>Collection is empty</h3>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Vm.Changes.ToList())
                            {
                                <tr>
                                    <td>@item.DateTime</td>
                                    <td>@item.UserName</td>
                                    <td>@item.ValueTag?.HumanReadable</td>
                                    <td>@item.OldValue</td>
                                    <td>@item.NewValue</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
        </div>
       
        <div class="modal-footer flex justify-end gap-1">
            <button type="button" class="btn btn-primary" @onclick="() => { _modalChanges.CloseModal(); _modalView.Toggle(); }">Back</button>
            <button type="button" class="btn btn-outline-red" @onclick="() => _modalChanges.CloseModal()">Close modal</button>
        </div>
    </Modal>

    <Modal @ref="_modalEdit">
        <div class="modal-header">
            <h4>@Vm.SelectedRecord?.DataEntityId</h4>
            <button class="cursor-pointer ms-auto my-auto" @onclick="() => { _modalEdit.CloseModal(); Vm.UnLocked(); }">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-body">
            @if (Vm.IsLockedByMeOrNull())
            {
                <RenderableContentControl Context="Vm.RefUIData" Presentation="ShadowControl"></RenderableContentControl>
            }
            else
            {
                <RenderableContentControl Context="Vm.RefUIData" Presentation="ShadowDisplay"></RenderableContentControl>
            }
        </div>
        <div class="modal-footer flex justify-end gap-1">
            @if (!Vm.IsLockedByMeOrNull())
            {
                <div class="alert alert-danger">
                    <h6>@Localizer["This repository is locked for editing by another user!"]</h6>
                </div>
            }
            @if (!Vm.IsHashCorrect)
            {
                <div class="alert alert-danger">
                    <h6>@Localizer["This record has external modifications!"]</h6>
                </div>
            }
            <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="() => { _modalEdit.CloseModal(); _modalAckEditUpdate.Toggle(); }">@Localizer["Update"]</button>
            <button type="button" class="btn btn-outline-red" @onclick="() => { Vm.UnLocked(); _modalEdit.CloseModal(); }">@Localizer["Close"]</button>
        </div>
    </Modal>

    <Modal @ref="_modalDelete">
        <div class="modal-header">
            <h4>@Localizer["Delete"] @Vm.SelectedRecord?.DataEntityId ?</h4>
            <button class="cursor-pointer ms-auto my-auto" @onclick="() => { _modalDelete.CloseModal(); Vm.UnLocked(); }">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-footer flex justify-end gap-1">
            @if (!Vm.IsLockedByMeOrNull())
            {
                <div class="alert alert-danger">
                    <h6>@Localizer["This repository is locked for editing by another user!"]</h6>
                </div>
            }
            @if (!Vm.IsHashCorrect)
            {
                <div class="alert alert-danger">
                    <h6>@Localizer["This record has external modifications!"]</h6>
                </div>
            }
            @if (Vm.GlobalActions != null)
            {
                <button type="button" class="btn btn-danger @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                @onclick="async () =>
                {
                    _modalDelete.CloseModal();
                    await Vm.GlobalActions.Delete(Vm.SelectedRecord.DataEntityId);
                    Vm.UnLocked();
                    Vm.UpdateObservableRecords();
                    Vm.InvokeStateHasChanged();
                }">
                    @Localizer["Delete in All repositories"]
                </button>
            }

            <button type="button" class="btn btn-danger @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)"
                    @onclick="() => {
                        _modalDelete.CloseModal();
                Vm.Delete();
                Vm.UnLocked();
            }">
                @Localizer["Delete in this repository"]
            </button>

            <button type="button" class="btn btn-outline-red" @onclick="() => { _modalDelete.CloseModal(); Vm.UnLocked(); }">@Localizer["Close"]</button>
        </div>
    </Modal>

    <Modal @ref="_modalAckSendToPlc">
        <div class="modal-header">
            <h4>@Localizer["Send data to PLC"] : "@Vm.SelectedRecord?.DataEntityId" ?</h4>
            <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalAckSendToPlc.CloseModal()">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-footer flex justify-end gap-1">
            @if (Vm.GlobalActions != null)
            {
                <button type="button" class="btn btn-primary"
                        @onclick="async () => {
                            _modalAckSendToPlc.CloseModal();
                        await Vm.GlobalActions.SendToPlc(Vm.SelectedRecord.DataEntityId);}">
                    @Localizer["Send data to ALL PLCs"]
                </button>

            }
            <button type="button" class="btn btn-primary"
                    @onclick="() => {
                        _modalAckSendToPlc.CloseModal();
                Vm.SendToPlc();
                StateHasChanged();}">

                @Localizer["Send data to THIS PLC"]
            </button>

            <button class="btn btn-outline-red" @onclick="() => _modalAckSendToPlc.CloseModal()">@Localizer["Close"]</button>
        </div>
    </Modal>

    <Modal @ref="_modalAckEditUpdate">
        <div class="modal-header">
            <h4>@Localizer["Update"] record : "@Vm.SelectedRecord?.DataEntityId"?</h4>
            <button class="cursor-pointer ms-auto my-auto" @onclick="() => _modalAckEditUpdate.CloseModal()">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-footer flex justify-end gap-1">
            <button type="button" class="btn btn-primary @(!Vm.IsLockedByMeOrNull() ? "disabled" : null)" @onclick="async () => { _modalAckEditUpdate.CloseModal(); await Vm.Edit(); Vm.UnLocked(); }">@Localizer["Update"]</button>

            <button type="button" class="btn btn-outline-red" @onclick="() => { _modalAckEditUpdate.CloseModal(); Vm.UnLocked(); }">Close modal</button>
        </div>
    </Modal>

    <Modal @ref="_modalExport">
        <div class="modal-header">
            <h4>@Localizer["Export data"]</h4>
            <button class="cursor-pointer ms-auto my-auto" @onclick="() => { _modalExport.CloseModal(); ClearClientFiles(); }">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-body">
            @if (Vm.exportStatus == eOperationStatus.Busy)
            {
                <IconSpinner Class="w-8 h-8" />
            }
            @if (Vm.exportStatus == eOperationStatus.Done)
            {
                <a download href="@ExportDownloadUrl">@Localizer["Download"]</a>
            }

            @if (Vm.exportStatus == eOperationStatus.Failed)
            {
                <div class="alert alert-danger">
                    <h6>Export failed</h6>
                </div>
            }
            <div class="flex flex-wrap ms-auto">
                @switch (Vm.ExportSet.ExportMode)
                {
                    case eExportMode.First:
                        <div class="alert alert-danger">
                            <h6>The first @Vm.ExportSet.FirstNumber items will be exported to a @Vm.ExportSet.ExportFileType.</h6>
                        </div>
                        break;
                    case eExportMode.Last:
                        <div class="alert alert-danger">
                            <h6>The last @Vm.ExportSet.FirstNumber items will be exported to a @Vm.ExportSet.ExportFileType.</h6>
                        </div>
                        break;
                    case eExportMode.Exact:
                        <div class="alert alert-danger">
                            <h6>Items from @Vm.ExportSet.FirstNumber to @Vm.ExportSet.SecondNumber will be exported to a @Vm.ExportSet.ExportFileType.</h6>
                        </div>
                        break;
                }
            </div>
        </div>
        <div class="modal-footer flex justify-end gap-1">
            <button type="button" class="btn btn-secondary" @onclick="() => {  _modalExport.CloseModal(); _modalExportCustom.Toggle(); }">@Localizer["Customize export options"]</button>

            <button type="button" class="btn btn-primary" @onclick='async () => {
                ClearClientFiles();
                await Vm.ExportDataAsync(ExportPath);
                }'>
                <strong>@Localizer["Export"]</strong>
            </button>

            <button class="btn btn-outline-red" @onclick="() => { _modalExport.CloseModal(); ClearClientFiles();}">@Localizer["Close"]</button>
        </div>
    </Modal>

    <Modal @ref="_modalImport">
        <div class="modal-header">
            <h4>@Localizer["Import data"]</h4>
            <button class="cursor-pointer ms-auto my-auto" @onclick="async () => { _modalImport.CloseModal(); Vm.importStatus = eOperationStatus.Ready; await SaveCustomExportDataAsync(); }">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-body">
            <div class="file-group">
                <label for="formFile">@Localizer["File input"]</label>
                <InputFile @key=@(_inputFileId) id="formFile" accept=".zip" OnChange="@LoadFile" />
            </div>

            @if (Vm.importStatus == eOperationStatus.Busy)
            {
                <IconSpinner Class="w-8 h-8" />
            }
            @if (Vm.importStatus == eOperationStatus.Done)
            {
                <div class="alert alert-danger">
                    <h6>Import successed</h6>
                </div>
            }
            @if (Vm.importStatus == eOperationStatus.Failed)
            {
                <div class="alert alert-danger">
                    <h6>Import failed</h6>
                </div>
            }
        </div>
        <div class="modal-footer flex justify-end gap-1">
            <div class="btn-group">
                @foreach (var item in Vm.DataExchange.Exporters)
                {
                    <button type="button" class="btn @(Vm.ExportSet.ExportFileType == item.Key ? "btn-primary" : "btn-outline-primary")" @onclick="() => Vm.ExportSet.ExportFileType = item.Key">@item.Key</button>
                }
            </div>
            <div class="input-group flex-row! items-center!">
                <label>@Localizer["Separator"]</label>
                <input type="text" placeholder="Separator" @bind="Vm.ExportSet.Separator">
            </div>

            <button type="button" class="btn btn-primary @(_fileLoadingStatus != eOperationStatus.Done ? "disabled" : "")"
                    @onclick='async () => {
                    Vm.importStatus = eOperationStatus.Busy;
                    await Vm.ImportDataAsync(ImportPath);
                    _inputFileId = Guid.NewGuid().ToString();
                    _fileLoadingStatus =  eOperationStatus.Ready;}'>
                @Localizer["Import"]
            </button>
            <button type="button" class="btn btn-secondary" @onclick="async () => { _modalImport.CloseModal(); Vm.importStatus = eOperationStatus.Ready; await SaveCustomExportDataAsync();}">@Localizer["Close"]</button>
        </div> 
    </Modal>

    <Modal @ref="_modalExportCustom">
        <div class="modal-header">
            <h4>@Localizer["Export data"]</h4>
            <button class="cursor-pointer ms-auto my-auto" @onclick="async () => { _modalExportCustom.CloseModal(); await SaveCustomExportDataAsync();}">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-6" />
            </button>
        </div>
        <div class="modal-body">
            <div class="accordion">
                @foreach (var item in Vm.RefUIData.GetChildren().DefaultIfEmpty(Vm.RefUIData))
                {
                    <AXOpen.Data.Blazor.AxoDataExchange.DataExchangeAccordionComponent SourceTwinElement="item" Vm="Vm" Parent="_data" />
                }
            </div>
        </div>
        <div class="modal-footer flex justify-between gap-1 items-center">
            @if (!Vm.GetFragmentsExportedValue())
            {
                <div class="alert alert-danger">
                    <h6>@Localizer["This file may not be able to be imported!"]</h6>
                </div>
            }

            <div class="flex gap-1 items-center">
                <Dropdown @ref="_dropdownExportMode">
                    <DropdownButton>
                        <button type="button" class="btn btn-primary" @onclick="_dropdownExportMode.Toggle">
                            @Localizer[Vm.ExportSet.ExportMode.ToString()]
                            <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 icon-button-rotate " + (_dropdownExportMode?.Open ?? false ? "rotated" : null))" />
                        </button>
                    </DropdownButton>
                    <DropdownBody>
                        <a class="dropdown-item @(Vm.ExportSet.ExportMode == eExportMode.First ? "active" : "")" @onclick="() => Vm.ExportSet.ExportMode = eExportMode.First">@Localizer["First"]</a>
                        <a class="dropdown-item @(Vm.ExportSet.ExportMode == eExportMode.Last ? "active" : "")" @onclick="() => Vm.ExportSet.ExportMode = eExportMode.Last">@Localizer["Last"]</a>
                        <a class="dropdown-item @(Vm.ExportSet.ExportMode == eExportMode.Exact ? "active" : "")" @onclick="() => Vm.ExportSet.ExportMode = eExportMode.Exact">@Localizer["Exact"]</a>
                    </DropdownBody>
                </Dropdown>

                @if (Vm.ExportSet.ExportMode == eExportMode.Exact)
                {
                    <BaseInput @bind-Value="Vm.ExportSet.FirstNumber" Label="@Localizer["From"]" Placeholder="@Localizer["From"]" Class="w-20" />
                    <BaseInput @bind-Value="Vm.ExportSet.SecondNumber" Label="@Localizer["To"]" Placeholder="@Localizer["To"]" Class="w-20" />
                }
                else
                {
                    <BaseInput @bind-Value="Vm.ExportSet.FirstNumber" Class="w-20" />
                }

                <div class="btn-group mt-2">
                    @foreach (var item in Vm.DataExchange.Exporters)
                    {
                        <button type="button" class="btn @(Vm.ExportSet.ExportFileType == item.Key ? "btn-primary" : "btn-outline-primary")" @onclick="() => Vm.ExportSet.ExportFileType = item.Key">@item.Key</button>
                    }
                </div>

                <BaseInput @bind-Value="Vm.ExportSet.Separator" Label="@Localizer["Separator"]" Placeholder="Separator" Class="w-20" />
            </div>

            <button type="button" class="btn btn-primary" data-bs-target="#exportModal-@ViewGuid"
                    @onclick='async () => {
                        _modalExportCustom.CloseModal();
                    await SaveCustomExportDataAsync(); }'>
                @Localizer["Back"]
            </button>
        </div>
    </Modal>
}

@code{
    private Modal _modalCreate { get; set; }
    private Modal _modalExport { get; set; }
    private Modal _modalExportCustom { get; set; }
    private Modal _modalImport { get; set; }
    private Modal _modalView { get; set; }
    private Modal _modalAckSendToPlc { get; set; }
    private Modal _modalDelete { get; set; }
    private Modal _modalEdit { get; set; }
    private Modal _modalChanges { get; set; }
    private Modal _modalAckEditUpdate { get; set; }

    private Dropdown _dropdownSort { get; set; }
    private Dropdown _dropdownExportMode { get; set; }
}