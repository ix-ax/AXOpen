@using AXSharp.Connector;
@namespace AXOpen.Data.Query

<div class="d-flex flex-row align-items-center gap-2">

    <label> @SymbolConfiguration.SymbolPathWithParent</label>

    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@SymbolConfiguration.Operation</button>
    <ul class="dropdown-menu">

        @foreach (var operation in OperationProvider.GetOperationsForType(SymbolConfiguration.SymbolType))
        {
            <li><a class="dropdown-item @(@SymbolConfiguration.Operation == operation ? "active" : "")" style="cursor: pointer" @onclick="() => {SymbolConfiguration.Operation = operation;}">@operation</a></li>
        }

    </ul>

    @if (SymbolConfiguration.IsRangeOperation)
    {
        <label>Min</label>
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" Value="@SymbolConfiguration.MinOrValue" ValueChanged="@(v => SymbolConfiguration.MinOrValue = v)"></DynamicInput>

        <label>Max</label>
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" Value="@SymbolConfiguration.Max" ValueChanged="@(v => SymbolConfiguration.Max = v)"></DynamicInput>
    }
    else
    {
        <label for="minOrValue">Value</label>
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" Value="@SymbolConfiguration.MinOrValue" ValueChanged="@(v => SymbolConfiguration.MinOrValue = v)"></DynamicInput>
    }

</div>
