@using AXSharp.Connector;
@namespace AXOpen.Data.Query

<div class="flex p-0 m-1">

    <div class="flex flex-wrap items-center gap-2 mb-1">

        @if (FilteredSymbols.Count > 0)
        {
            <button class="btn btn-secondary px-2 py-1"
                    type="button"
                    style="width:100px;"
                    @onclick="AddAllDisplayedToQuery">
                <Operon.Icons.HeroIcon Icon="funnel" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                @Localizer["All"]
            </button>
        }
        @if (FilteredSymbols.Count > 0)
        {
            <button class="btn btn-secondary px-2 py-1" type="button" style="width:100px;" @onclick="ClearFilter">
                <Operon.Icons.HeroIcon Icon="x-mark" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                @Localizer["Clean"]
            </button>
        }

        <input id="filterText" @bind="SymbolsQueryFilter" @bind:event="oninput"
               placeholder="Type symbol name here for filter..."
               class="form-control"
               title="Enter a symbol name to filter the results" />

        @if (InjectedQueries.Count > 0)
        {
            <button class="btn btn-warning dropdown-toggle m-1" type="button" @onclick="() => _dropdownInjectedQueriesCollapsed = !_dropdownInjectedQueriesCollapsed">
                @Localizer["Injected query !"]
            </button>

            @if (!_dropdownInjectedQueriesCollapsed)
{
    <div class="dropdown-body card">
        @foreach (var element in InjectedQueries)
                {
                    <a class="block px-4 py-2 text-sm text-gray-700">@element</a>
                }
    </div>
}
        }

        @if (InjectedSorting.Count > 0)
        {
            <button class="btn btn-warning dropdown-toggle m-1" type="button" @onclick="() => _dropdownInjectedSortingCollapsed = !_dropdownInjectedSortingCollapsed">
                @Localizer["Injected sort!"]
            </button>

            @if (!_dropdownInjectedSortingCollapsed)
            {
                <div class="dropdown-body card">
                    @foreach (var element in InjectedSorting)
                    {
                        <a class="block px-4 py-2 text-sm text-gray-700">@element</a>
                    }
                </div>
            }
        }
    </div>

    @if (FilteredSymbols.Count > 0)
    {
        <div class="card flex flex-wrap p-1 my-1">

            @foreach (var symbol in GetDisplaySymbols())
            {
                <p class="m-1">
                    <button class="btn btn-secondary px-2 py-1" type="button" @onclick="() => AddSymbolToQuery(symbol)">
                        <Operon.Icons.HeroIcon Icon="funnel" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                    </button>
                    <button class="btn btn-secondary px-2 py-1" type="button" @onclick="() => AddSymbolToSorting(symbol)">
                        <Operon.Icons.HeroIcon Icon="adjustments-vertical" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                    </button>
                    @symbol
                </p>
            }

            <Operon.Components.Pagination Count="SymbolsQueryCount" @bind-PageSize="SymbolsQueryPageLimit" @bind-Selected="SymbolsQueryPage" PageSizeAndSelectedChangedAsync="PageSizeAndSelectedChangedAsync" />
        </div>
    }

    @if (CurrentQuery.Queries.Count() > 0)
    {

        <div class="card p-1 my-1">
            <div class="flex flex-wrap items-center gap-2">
                <label>@Localizer["Query"]</label>
                <div>

                    @foreach (var querySymbol in CurrentQuery.Queries)
                    {
                        <div class="flex flex-wrap items-center gap-2">
                            <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Remove"]"
                                    @onclick="() => RemoveSymbolFromQuery(querySymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>

                            @*  <label class="ms-2"> @Localizer["Move"]</label>
 *@
                            <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Move Up"]"
                                    @onclick="() => MoveQuerySymbolUp(querySymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="arrow-up" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>

                            <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Move Down"]"
                                    @onclick="() => MoveQuerySymbolDown(querySymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="arrow-down" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>

                            <QuerySymbolConfigurationView @key=querySymbol.TrackSymbolId SymbolConfiguration="@querySymbol"></QuerySymbolConfigurationView>
                        </div>
                    }
                </div>

            </div>

        </div>
    }

    @if (CurrentQuery.Sorting.Count > 0)
    {
        <div class="card p-1 my-1">

            <div class="flex flex-wrap items-center gap-2">

                <label>@Localizer["Sort"]</label>
                <div>
                    @foreach (var sortSymbol in CurrentQuery.Sorting)
                    {
                        <div class="flex flex-wrap items-center gap-2 my-1">
                            <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Remove"]"
                                    @onclick="() => RemoveSymbolFromSorting(sortSymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>
                            @* 
                    <label class="ms-2"> @Localizer["Move"]</label>
 *@
                            <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Move Up"]"
                                    @onclick="() => MoveSortingSymbolUp(sortSymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="arrow-up" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>

                            <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Move Down"]"
                                    @onclick="() => MoveSortingSymbolDown(sortSymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="arrow-down" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>

                            <div class="flex flex-wrap items-center gap-2">
                                <label> @sortSymbol.SymbolPathWithParent</label>
                            </div>

                            <div class="flex flex-wrap items-center gap-2">
                                <label for="sortSymbolName">
                                    @if (sortSymbol.IsAscending)
                                    {
                                        <Operon.Icons.HeroIcon Icon="chevron-up" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                            <span class="ms-2">
                                                @Localizer["Ascending"]
                                            </span>
                                    }
                                    else
                                    {
                                        <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                                            <span class="ms-2">
                                                @Localizer["Descending"]
                                            </span>
                                    }
                                </label>
                                <input id="sortSymbolName" type="checkbox" @bind="sortSymbol.IsAscending" class="form-check-input" />
                            </div>

                        </div>
                    }
                </div>
            </div>
        </div>


    }


    <div class="card flex flex-wrap items-center gap-2 p-1 m-0">

        <label>@Localizer["Filter"]</label>

        <div>
            <button class="btn btn-secondary dropdown-toggle" type="button" @onclick="() => _dropdownHistoryCollapsed = !_dropdownHistoryCollapsed">
                @CurrentQuery.Name
            </button>

            @if (!_dropdownHistoryCollapsed)
            {
                <div class="dropdown-body card">
                    @foreach (var element in History.Items)
                    {
                        <a class="block px-4 py-2 text-sm text-gray-700 @(CurrentQuery.Name == element.Name ? "active" : "")"
                               @onclick='() => SelectlElementFromHistory(element.Name)'>@element.Name (@element.Modified.ToString())</a>
                    }
                </div>
            }
        </div>

        <input id="CurentQueryName" @bind="CurrentQuery.Name" @bind:event="oninput"
               placeholder="Type query name "
               class="form-control"
               style="max-width: 300px;"
               title="Query name" />

        <button class="btn btn-secondary m-1 py-0" type="button" @onclick="async () => await UpdateQueryHistoryToStorage()" title="@Localizer["Save query"]">
            <Operon.Icons.HeroIcon Icon="folder" Type="Operon.Icons.IconType.Outline" Class="size-5" />
        </button>


        <button class="btn btn-secondary m-1 py-0" type="button" @onclick="async () =>await RemoveItemFromHistory()"
                data-bs-toggle="tooltip" title="@Localizer["Delete query"]">
            <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-5" />
        </button>

        @if (CurrentQuery.Queries.Count > 0)
        {
            <button class="btn btn-primary m-1 px-5 py-0 flex items-center gap-2" type="button" @onclick="async () => await ExecuteFilter()">
                <Operon.Icons.HeroIcon Icon="magnifying-glass" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                <span>@Localizer["Filter"]</span>
            </button>
        }

    </div>
</div>

@code {
    private bool _dropdownInjectedQueriesCollapsed = true;
    private bool _dropdownInjectedSortingCollapsed = true;
    private bool _dropdownHistoryCollapsed = true;
}