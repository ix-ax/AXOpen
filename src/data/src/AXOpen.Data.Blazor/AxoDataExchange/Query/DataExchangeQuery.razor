@using AXSharp.Connector;
@using Operon.Components
@using Operon.Components.Dropdown
@using Operon.Icons
@namespace AXOpen.Data.Query

<div data-data-exchange-query class="w-full flex flex-wrap flex-col">

    <div class="w-full flex flex-wrap flex-row items-center gap-1 mt-1">


        <input type="text" class="input flex-1 min-w-0" @bind="SymbolsQueryFilter" @bind:event="oninput" placeholder="Type symbol name here for filter..." title="Enter a symbol name to filter the results" />

        <button type="button" class="btn btn-outline-primary" @onclick="ClearFilter" title="@Localizer["Clean"]">
            <Operon.Icons.HeroIcon Icon="backspace" Type="Operon.Icons.IconType.Outline" Class="size-5" />
        </button>

        @if (FilteredSymbols.Count > 0)
        {
            <button type="button" class="btn btn-outline-primary" @onclick="AddAllDisplayedToQuery">
                @Localizer["All to filter"]
                <Operon.Icons.HeroIcon Icon="funnel" Type="Operon.Icons.IconType.Outline" Class="size-5" />
            </button>
        }

        @if (InjectedQueries.Count > 0)
        {
            <Dropdown @ref="_DropdownInjectedQueries">
                <DropdownButton>
                    <button type="button" class="btn btn-primary" @onclick="_DropdownInjectedQueries.ToggleAsync">
                        @Localizer["Injected query !"]
                        <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 icon-button-rotate " + (_DropdownInjectedQueries?.Open ?? false ? "rotated" : null))" />
                    </button>
                </DropdownButton>
                <DropdownBody>
                    @foreach (var element in InjectedQueries)
                    {
                        <a class="dropdown-item">@element</a>
                    }
                </DropdownBody>
            </Dropdown>
        }

        @if (InjectedSorting.Count > 0)
        {
            <Dropdown @ref="_DropdownInjectedSorting">
                <DropdownButton>
                    <button type="button" class="btn btn-primary" @onclick="_DropdownInjectedSorting.ToggleAsync">
                        @Localizer["Injected sort!"]
                        <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 icon-button-rotate " + (_DropdownInjectedSorting?.Open ?? false ? "rotated" : null))" />
                    </button>
                </DropdownButton>
                <DropdownBody>
                    @foreach (var element in InjectedSorting)
                    {
                        <a class="dropdown-item">@element</a>
                    }
                </DropdownBody>
            </Dropdown>
        }
    </div>

    @if (FilteredSymbols.Count > 0)
    {
        <div class="card flex flex-wrap flex-col p-1">

            @foreach (var symbol in GetDisplaySymbols())
            {
                <div class="flex flex-wrap items-center gap-2 p-1">
                    <button class="btn btn-outline-primary px-1! py-2! w-15" type="button" @onclick="() => AddSymbolToQuery(symbol)">
                        <Operon.Icons.HeroIcon Icon="funnel" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                    </button>

                    <button class="btn btn-outline-primary px-1! py-2! w-15" type="button" @onclick="() => AddSymbolToSorting(symbol)">
                        <Operon.Icons.HeroIcon Icon="adjustments-vertical" Type="Operon.Icons.IconType.Outline" Class="size-4" />
                    </button>
                    <p>@symbol.PresentablePath</p>
                </div>
            }

            <Operon.Components.Pagination Count="PaginationCount" @bind-PageSize="PaginationPageSize" @bind-Selected="PaginationSelected" PageSizeAndSelectedChangedAsync="PageSizeAndSelectedChangedAsync" />
        </div>
    }

    @if (CurrentQuery.Queries.Count() > 0)
    {

        <div class="card p-2">
            <div class="flex flex-wrap items-center gap-2">

                <label>@Localizer["Query"]</label>

                <div class="flex flex-wrap flex-col gap-1">

                    @foreach (var querySymbol in CurrentQuery.Queries)
                    {
                        <div class="flex flex-wrap items-center gap-1">

                            <button type="button" class="btn btn-no-bg-primary px-1! py-2!" title="@Localizer["Remove"]"
                                    @onclick="() => RemoveSymbolFromQuery(querySymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>


                            <button type="button" class="btn btn-no-bg-primary px-1! py-2!" title="@Localizer["Move Up"]"
                                    @onclick="() => MoveQuerySymbolUp(querySymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="arrow-up" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>


                            <button type="button" class="btn btn-no-bg-primary px-1! py-2!" title="@Localizer["Move Down"]"
                                    @onclick="() => MoveQuerySymbolDown(querySymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="arrow-down" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>

                            <QuerySymbolConfigurationView @key=querySymbol.TrackSymbolId SymbolConfiguration="@querySymbol" HiddenPrefix="@RemovedCommonSymbolPrefix"></QuerySymbolConfigurationView>
                        </div>
                    }
                </div>

            </div>

        </div>
    }

    @if (CurrentQuery.Sorting.Count > 0)
    {
        <div class="card p-2">

            <div class="flex flex-wrap items-center gap-2">

                <label>@Localizer["Sort"]</label>

                <div class="flex flex-wrap flex-col gap-1">

                    @foreach (var sortSymbol in CurrentQuery.Sorting)
                    {
                        <div class="flex flex-wrap items-center gap-1">

                            <button type="button" class="btn btn-no-bg-primary px-1! py-2!" title="@Localizer["Remove"]"
                                    @onclick="() => RemoveSymbolFromSorting(sortSymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>


                            <button type="button" class="btn btn-no-bg-primary px-1! py-2!" title="@Localizer["Move Up"]"
                                    @onclick="() => MoveSortingSymbolUp(sortSymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="arrow-up" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>

                            <button type="button" class="btn btn-no-bg-primary px-1! py-2!" title="@Localizer["Move Down"]"
                                    @onclick="() => MoveSortingSymbolDown(sortSymbol.TrackSymbolId)">
                                <Operon.Icons.HeroIcon Icon="arrow-down" Type="Operon.Icons.IconType.Outline" Class="size-5" />
                            </button>

                            <div class="flex flex-wrap items-center gap-2">
                                <label> @sortSymbol.PresentablePath</label>
                            </div>

                            <div class="flex flex-wrap items-center gap-2">
                                <label for="sortSymbolName" class="ms-4">
                                    @if (sortSymbol.IsAscending)
                                    {
                                        @Localizer["Ascending"]
                                    }
                                    else
                                    {
                                        @Localizer["Descending"]
                                    }
                                </label>

                                <BaseInput @bind-Value="sortSymbol.IsAscending" Class="mx-4" />
                            </div>

                        </div>
                    }
                </div>
            </div>
        </div>


    }


    <div class="card p-2">

        <div class="flex flex-wrap items-center gap-2">

            <label>@Localizer["Filter"]</label>


            <Dropdown @ref="_DropdownHistory">
                <DropdownButton>
                    <button type="button" class="btn btn-primary" @onclick="_DropdownHistory.ToggleAsync">
                        @CurrentQuery.Name
                        <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 icon-button-rotate " + (_DropdownHistory?.Open ?? false ? "rotated" : null))" />
                    </button>
                </DropdownButton>
                <DropdownBody>
                    @foreach (var element in History.Items)
                    {
                        <a class="dropdown-item @(CurrentQuery.Name == element.Name ? "active" : "")"
                           @onclick='() => SelectHistoryItem(element.Name)'>@element.Name (@element.Modified.ToString())</a>
                    }
                </DropdownBody>
            </Dropdown>


            <BaseInput @bind-Value="CurrentQuery.Name" Placeholder="Type query name" />

            <button type="button" class="btn btn-outline-primary" @onclick="async () => await SaveHistoryAsync()" title="@Localizer["Save query"]">
                <Operon.Icons.HeroIcon Icon="folder" Type="Operon.Icons.IconType.Outline" Class="size-5" />
            </button>


            <button type="button" class="btn btn-outline-primary" @onclick="async () => await RemoveHistoryItemAsync()" title="@Localizer["Delete query"]">
                <Operon.Icons.HeroIcon Icon="trash" Type="Operon.Icons.IconType.Outline" Class="size-5" />
            </button>

            @if (CurrentQuery.Queries.Count > 0)
            {
                <button type="button" class="btn btn-primary" @onclick="async () => await ExecuteFilterAsync()">
                    @Localizer["Search"]
                </button>
            }
        </div>

    </div>
</div>

@code {
    private Dropdown _DropdownInjectedQueries { get; set; }
    private Dropdown _DropdownInjectedSorting { get; set; }
    private Dropdown _DropdownHistory { get; set; }
}
