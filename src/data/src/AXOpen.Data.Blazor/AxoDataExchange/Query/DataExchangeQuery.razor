@using AXSharp.Connector;
@namespace AXOpen.Data.Query

<div class="container-fluid p-0 m-1">

    <div class="col d-flex align-items-center gap-2 mb-1">

        @if (FilteredSymbols.Count > 0)
        {
            <button class="btn btn-secondary px-2 py-1" type="button" @onclick="AddAllDisplayedToQuery">
                <span class="oi oi-plus" aria-hidden="true">All</span>
            </button>
        }

        <input id="filterText" @bind="SymbolsQueryFilter" @bind:event="oninput"
               placeholder="Type symbol name here for filter..."
               class="form-control"
               title="Enter a symbol name to filter the results"
               data-bs-toggle="tooltip" />



        <button class="btn btn-secondary px-2 py-1" type="button" @onclick="ClearFilter">
            <span class="oi oi-x" aria-hidden="true">Clear</span>
        </button>
    </div>


    @if (FilteredSymbols.Count > 0)
    {
        <div class="card flex p-1 my-2">

            @foreach (var symbol in GetDisplaySymbols())
            {
                <p class="m-1">
                    <button class="btn btn-secondary px-2 py-1" type="button" @onclick="() => AddSymbolToQuery(symbol)">
                        <span class="oi oi-plus" aria-hidden="true"></span>
                    </button>
                    <button class="btn btn-secondary px-2 py-1" type="button" @onclick="() => AddSymbolToSorting(symbol)">
                        <span class="oi oi-random" aria-hidden="true"></span>
                    </button>
                    @symbol
                </p>
            }

            @if (FilteredSymbols.Count > 5)
            {
                <div class="d-flex">

                    <div class="dropup">
                        Showing @(SymbolsQueryPage * SymbolsQueryPageLimit + 1) to @(((SymbolsQueryPage + 1) * SymbolsQueryPageLimit) > SymbolsQueryCount ? SymbolsQueryCount : ((SymbolsQueryPage + 1) * SymbolsQueryPageLimit)) of @SymbolsQueryCount rows
                        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@SymbolsQueryPageLimit</button>
                        <ul class="dropdown-menu m-0">
                            <li><a class="dropdown-item @(SymbolsQueryPageLimit == 5 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(5)">5</a></li>
                            <li><a class="dropdown-item @(SymbolsQueryPageLimit == 10 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(10)">10</a></li>
                            <li><a class="dropdown-item @(SymbolsQueryPageLimit == 25 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(25)">25</a></li>
                            <li><a class="dropdown-item @(SymbolsQueryPageLimit == 50 ? "active" : "")" style="cursor: pointer" @onclick="() => SetLimitAsync(50)">50</a></li>
                        </ul>
                        rows per page
                    </div>
                    <nav class="ms-auto">
                        <ul class="pagination m-0">
                            <li class="page-item"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(Modulo(SymbolsQueryPage - 1, MaxPage + 1))" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a></li>

                            @if (MaxPage < 7)
                            {
                                @for (var i = 0; i < MaxPage + 1; i++)
                                {
                                    var j = i;
                                    <li class="page-item @(SymbolsQueryPage == i ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(j)">@(i + 1)</a></li>
                                }
                            }
                            else
                            {
                                <li class="page-item @(SymbolsQueryPage == 0 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(0)">1</a></li>

                                @if (SymbolsQueryPage < 4)
                                {
                                    <li class="page-item @(SymbolsQueryPage == 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(1)">2</a></li>
                                    <li class="page-item @(SymbolsQueryPage == 2 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(2)">3</a></li>
                                    <li class="page-item @(SymbolsQueryPage == 3 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(3)">4</a></li>
                                    <li class="page-item @(SymbolsQueryPage == 4 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(4)">5</a></li>
                                    <li class="page-item disabled"><a class="page-link">...</a></li>
                                }
                                else if (SymbolsQueryPage > MaxPage - 4)
                                {
                                    <li class="page-item disabled"><a class="page-link">...</a></li>
                                    <li class="page-item @(SymbolsQueryPage == @MaxPage - 4 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 4)">@(MaxPage - 3)</a></li>
                                    <li class="page-item @(SymbolsQueryPage == @MaxPage - 3 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 3)">@(MaxPage - 2)</a></li>
                                    <li class="page-item @(SymbolsQueryPage == @MaxPage - 2 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 2)">@(MaxPage - 1)</a></li>
                                    <li class="page-item @(SymbolsQueryPage == @MaxPage - 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage - 1)">@(MaxPage)</a></li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><a class="page-link">...</a></li>
                                    <li class="page-item @(SymbolsQueryPage == SymbolsQueryPage - 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(SymbolsQueryPage - 1)">@(SymbolsQueryPage)</a></li>
                                    <li class="page-item @(SymbolsQueryPage == SymbolsQueryPage ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(SymbolsQueryPage)">@(SymbolsQueryPage + 1)</a></li>
                                    <li class="page-item @(SymbolsQueryPage == SymbolsQueryPage + 1 ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(SymbolsQueryPage + 1)">@(SymbolsQueryPage + 2)</a></li>
                                    <li class="page-item disabled"><a class="page-link">...</a></li>
                                }

                                <li class="page-item @(SymbolsQueryPage == @MaxPage ? "active" : "")"><a class="page-link" style="cursor: pointer" @onclick="() => SetPageAsync(MaxPage)">@(MaxPage + 1)</a></li>
                            }

                            <li class="page-item"><a class="page-link" style="cursor: pointer" @onclick="async () => { if (MaxPage != -1) await SetPageAsync((SymbolsQueryPage + 1) % (MaxPage + 1)); }" aria-label="Next"><span aria-hidden="true">&raquo;</span></a></li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }

   

    @if (Queries.Count > 0)
    {
        <div class="card p-1 m-0">
            @foreach (var querySymbol in Queries)
            {
                @* <div class="card p-1 m-1"> *@
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Remove"]"
                            @onclick="() => RemoveSymbolFromQuery(querySymbol.TrackSymbolId)">
                        <i class="oi oi-trash"></i>

                    </button>

                    @*  <label class="ms-2"> @Localizer["Move"]</label>
 *@
                    <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Move Up"]"
                            @onclick="() => MoveQuerySymbolUp(querySymbol.TrackSymbolId)">
                        <i class="oi oi-data-transfer-upload">
                        </i>
                    </button>

                    <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Move Donw"]"
                            @onclick="() => MoveQuerySymbolDown(querySymbol.TrackSymbolId)">
                        <i class="oi oi-data-transfer-download">
                        </i>
                    </button>

                    <QuerySymbolConfigurationView @key=querySymbol.TrackSymbolId SymbolConfiguration="@querySymbol"></QuerySymbolConfigurationView>
                </div>
                @* </div> *@
            }
        </div>
    }

    @if (Sorting.Count > 0)
    {
        <div class="card p-1 mt-1">
            @foreach (var sortSymbol in Sorting)
            {
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Remove"]"
                            @onclick="() => RemoveSymbolFromSorting(sortSymbol.TrackSymbolId)">
                        <i class="oi oi-trash"></i>
                    </button>
                    @* 
                    <label class="ms-2"> @Localizer["Move"]</label>
 *@
                    <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Move Up"]"
                            @onclick="() => MoveSortingSymbolUp(sortSymbol.TrackSymbolId)">
                        <i class="oi oi-data-transfer-upload"> </i>
                    </button>

                    <button type="button" class="btn btn-secondary px-3 py-0" title="@Localizer["Move Donw"]"
                            @onclick="() => MoveSortingSymbolDown(sortSymbol.TrackSymbolId)">
                        <i class="oi oi-data-transfer-download"></i>
                    </button>

                    <div class="d-flex flex-row align-items-center gap-2">
                        <label> @sortSymbol.SymbolPathWithParent</label>
                    </div>

                    <div class="d-flex flex-row align-items-center gap-2">
                        <label for="sortSymbolName">
                            @if (sortSymbol.IsAscending)
                            {
                                <i class="oi oi-sort-ascending">
                                    <span class="ms-2">
                                        @Localizer["Ascending"]
                                    </span>
                                </i>
                            }
                            else
                            {
                                <i class="oi oi-sort-descending">
                                    <span class="ms-2">
                                        @Localizer["Descending"]
                                    </span>

                                </i>
                            }
                        </label>
                        <input id="sortSymbolName" type="checkbox" @bind="sortSymbol.IsAscending" class="form-check-input" />
                    </div>

                </div>
            }
        </div>
    }

    @if (InjectedQueries.Count > 0)
    {
        <button class="btn btn-warning dropdown-toggle m-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @Localizer["Injected query parameters will be used!"]
        </button>

        <ul class="dropdown-menu">
            @foreach (var element in InjectedQueries)
            {
                <li><a class="dropdown-item">@element</a></li>
            }
        </ul>
    }

    @if (InjectedSorting.Count > 0)
    {
        <button class="btn btn-warning dropdown-toggle m-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @Localizer["Injected sorting parameters will be used!"]
        </button>

        <ul class="dropdown-menu">
            @foreach (var element in InjectedSorting)
            {
                <li><a class="dropdown-item">@element</a></li>
            }
        </ul>
    }

    @if (Queries.Count > 0)
    {
        <button class="btn btn-primary m-1" type="button" @onclick="async () =>await ExecuteFilter()">FILTER</button>
    }

</div>
