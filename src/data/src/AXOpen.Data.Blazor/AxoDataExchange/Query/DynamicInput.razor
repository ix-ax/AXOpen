@using AXSharp.Connector;
@using System.ComponentModel;
@namespace AXOpen.Data.Query

@if (IsString)
{
    <input type="text" @bind="BoundString" class="form-control" />
}
else if (IsBool)
{
    <input type="checkbox" @bind="BoundBool" class="form-check-input" />
}
else if (IsNumeric)
{
    <input type="number" @bind="BoundNumber" class="form-control" min="@MinValue" max="@MaxValue" step="@StepValue" />
}
else if (IsChar)
{
    <input type="text" maxlength="1" @bind="BoundChar" class="form-control" />
}
else if (IsDateTime)
{
    <input type="datetime-local" @bind="BoundDateTime" class="form-control" min="@MinDateTime" max="@MaxDateTime" />
}
else if (IsDateOnly)
{
    <input type="date" @bind="BoundDateOnly" class="form-control" min="@MinDate" max="@MaxDate" />
}
else if (IsTimeOnly)
{
    <input type="time" @bind="BoundTimeOnly" class="form-control" min="@MinTime" max="@MaxTime" />
}
else if (IsTimeSpan)
{
    <input type="text" placeholder="hh:mm:ss" @bind="BoundTimeSpan" class="form-control" />
}
else if (IsEnum)
{
    <select @bind="BoundEnum" class="form-control">
        @foreach (var option in EnumOptions)
        {
            <option value="@option">@option</option>
        }
    </select>
}
else
{
    <p>Unsupported type</p>
}

@code {
    [Parameter] public Type ValueType { get; set; }

    private object _Value;
    [Parameter]
    public object Value
    {
        get
        {
            if (_Value == null)
            {
                _Value = Activator.CreateInstance(ValueType);
            }
            return _Value;
        }
        set
        {

            if (ValueType != value.GetType())
            {
                ;
            }
            try
            {
                var converted = Convert.ChangeType(value, ValueType);

                if (converted != null)
                {
                    if (!Equals(_Value, value))
                    {
                        _Value = value;
                        ValueChanged.InvokeAsync(value);
                    }
                }
            }
            catch (Exception ex)
            {

                throw;
            }

        }
    }

    [Parameter] public EventCallback<object> ValueChanged { get; set; }


    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (IsNumeric)
        {
            MinDecimalValue = GetDecimalValue(OperationProvider.GetMinForType(ValueType).ToString());
            MaxDecimalValue = GetDecimalValue(OperationProvider.GetMaxForType(ValueType).ToString());
        }
    }

    decimal GetDecimalValue(string val)
    {
        decimal retValue = 0;
        decimal.TryParse(val, out retValue);
        return retValue;
    }


    bool IsString => ValueType == typeof(string);
    bool IsBool => ValueType == typeof(bool);
    bool IsNumeric => ValueType == typeof(byte) || ValueType == typeof(sbyte) || ValueType == typeof(short) ||
                      ValueType == typeof(ushort) || ValueType == typeof(int) || ValueType == typeof(uint) ||
                      ValueType == typeof(long) || ValueType == typeof(ulong) || ValueType == typeof(float) ||
                      ValueType == typeof(double) || ValueType == typeof(decimal);
    bool IsChar => ValueType == typeof(char);
    bool IsDateTime => ValueType == typeof(DateTime);
    bool IsDateOnly => ValueType == typeof(DateOnly);
    bool IsTimeOnly => ValueType == typeof(TimeOnly);
    bool IsTimeSpan => ValueType == typeof(TimeSpan);
    bool IsEnum => ValueType.IsEnum;

    List<object> EnumOptions => IsEnum ? Enum.GetValues(ValueType).Cast<object>().ToList() : new List<object>();

    string BoundString
    {
        get => Value as string ?? string.Empty;
        set
        {
            Value = value;
            ValueChanged.InvokeAsync(Value);
        }
    }

    bool BoundBool
    {
        get => Value is bool b ? b : default;
        set
        {
            Value = value;
            ValueChanged.InvokeAsync(Value);
        }
    }

    string BoundNumber
    {
        get => Value?.ToString() ?? "0";
        set
        {
            if (IsNumeric && decimal.TryParse(value.ToString(), out decimal parsedValue))
            {
                if (parsedValue > MaxDecimalValue) parsedValue = MaxDecimalValue;
                if (parsedValue < MinDecimalValue) parsedValue = MinDecimalValue;

                Value = Convert.ChangeType(parsedValue, ValueType);

                ValueChanged.InvokeAsync(Value);
            }

        }
    }

    char BoundChar
    {
        get => Value is char c ? c : default;
        set
        {
            Value = value;
            ValueChanged.InvokeAsync(Value);
        }
    }

    DateTime BoundDateTime
    {
        get => Value is DateTime dt ? dt : DateTime.Now;
        set
        {
            Value = value;
            ValueChanged.InvokeAsync(Value);
        }
    }

    DateOnly BoundDateOnly
    {
        get => Value is DateOnly d ? d : DateOnly.FromDateTime(DateTime.Now);
        set
        {
            Value = value;
            ValueChanged.InvokeAsync(Value);
        }
    }

    TimeOnly BoundTimeOnly
    {
        get => Value is TimeOnly t ? t : TimeOnly.FromDateTime(DateTime.Now);
        set
        {
            Value = value;
            ValueChanged.InvokeAsync(Value);
        }
    }

    TimeSpan BoundTimeSpan
    {
        get => Value is TimeSpan ts ? ts : TimeSpan.Zero;
        set
        {
            Value = value;
            ValueChanged.InvokeAsync(Value);
        }
    }

    Enum BoundEnum
    {
        get => (Enum)Value;
        set
        {
            Value = Enum.Parse(ValueType, value.ToString());
            ValueChanged.InvokeAsync(Value);
        }
    }

    // Min and Max values based on type
    string MinValue => GetMinValue();
    string MaxValue => GetMaxValue();

    decimal MinDecimalValue;
    decimal MaxDecimalValue;

    string StepValue => IsFloatingPoint ? "any" : "1";

    bool IsFloatingPoint => ValueType == typeof(float) || ValueType == typeof(double) || ValueType == typeof(decimal);

    private string GetMinValue()
    {
        var min = OperationProvider.GetMinForType(ValueType);
        if (min == null) return "0";

        return min switch
        {
            float f => f.ToString("R"),  // "R" ensures round-trip precision
            double d => d.ToString("R"),
            decimal dec => dec.ToString(), // Ensure no precision issues
            _ => min.ToString()
        };
    }

    private string GetMaxValue()
    {
        var max = OperationProvider.GetMaxForType(ValueType);
        if (max == null) return "100";

        return max switch
        {
            float f => f.ToString("R"),
            double d => d.ToString("R"),
            decimal dec => dec.ToString(),
            _ => max.ToString()
        };
    }

    string MinDateTime => ((DateTime)OperationProvider.GetMinForType(ValueType)!).ToString("yyyy-MM-ddTHH:mm");
    string MaxDateTime => ((DateTime)OperationProvider.GetMaxForType(ValueType)!).ToString("yyyy-MM-ddTHH:mm");

    string MinDate => ((DateOnly)OperationProvider.GetMinForType(ValueType)!).ToString("yyyy-MM-dd");
    string MaxDate => ((DateOnly)OperationProvider.GetMaxForType(ValueType)!).ToString("yyyy-MM-dd");

    string MinTime => ((TimeOnly)OperationProvider.GetMinForType(ValueType)!).ToString("HH:mm");
    string MaxTime => ((TimeOnly)OperationProvider.GetMaxForType(ValueType)!).ToString("HH:mm");
}
