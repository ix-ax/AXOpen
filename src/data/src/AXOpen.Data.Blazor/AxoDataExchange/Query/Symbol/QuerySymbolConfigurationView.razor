@using AXSharp.Connector;
@using Operon.Components.Dropdown
@namespace AXOpen.Data.Query

<div class="flex flex-wrap items-center gap-2">

    @if (!HideDescripion)
    {
        <label> @SymbolConfiguration.RootTypeName</label>
        <label> @SymbolConfiguration.SymbolPath</label>
    }

    <div class="select-group">
        <select @bind="Operation" class="min-w-6 m-0!">
            @foreach (var operation in OperationProvider.GetOperationsForType(SymbolConfiguration.SymbolType))
            {
                <option value="@operation">@Localizer[operation]</option>
            }
        </select>
    </div>

    @if (SymbolConfiguration.IsRangeOperation)
    {
        if (!HideDescripion)
        {
            <label>@Localizer["Min"]</label>
        }
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" @bind-Value="MinOrValue" AccessStatusClass="m-0!"></DynamicInput>

        if (!HideDescripion)
        {
            <label>@Localizer["Max"]</label>
        }
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" @bind-Value="@Max" AccessStatusClass="m-0!"></DynamicInput>
    }
    else
    {
        if (!HideDescripion)
        {
            <label for="minOrValue">@Localizer["Value"]</label>
        }
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" @bind-Value="@MinOrValue" AccessStatusClass="m-0!"></DynamicInput>
    }

</div>
