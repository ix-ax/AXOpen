@using AXSharp.Connector;
@using Operon.Components.Dropdown
@namespace AXOpen.Data.Query

<div class="flex flex-wrap items-center gap-2">

    @if (!HideDescripion)
    {
        <label> @SymbolConfiguration.SymbolPathWithParent</label>
    }

    <Dropdown @ref="_dropdownComponent">
        <DropdownButton>
            <button type="button" class="btn btn-secondary" @onclick="_dropdownComponent.Toggle">
                @Operation
                <Operon.Icons.HeroIcon Icon="chevron-down" Type="Operon.Icons.IconType.Outline" Class="@("size-5 ms-2 icon-button-rotate " + (_dropdownComponent?.Open ?? false ? "rotated" : null))" />
            </button>
        </DropdownButton>
        <DropdownBody>
            @foreach (var operation in OperationProvider.GetOperationsForType(SymbolConfiguration.SymbolType))
            {
                <a class="dropdown-item @(@SymbolConfiguration.Operation == operation ? "active" : "")" @onclick="() => {Operation = operation;}">@operation</a>
            }
        </DropdownBody>
    </Dropdown>

    @if (SymbolConfiguration.IsRangeOperation)
    {
        if (!HideDescripion)
        {
            <label>@Localizer["Min"]</label>
        }
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" @bind-Value="MinOrValue"></DynamicInput>

        if (!HideDescripion)
        {
            <label>@Localizer["Max"]</label>
        }
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" @bind-Value="@Max"></DynamicInput>
    }
    else
    {

        if (!HideDescripion)
        {
            <label for="minOrValue">@Localizer["Value"]</label>
        }
        <DynamicInput ValueType="@SymbolConfiguration.SymbolType" @bind-Value="@MinOrValue"></DynamicInput>
    }

</div>

@code {
    private Dropdown _dropdownComponent { get; set; }
}