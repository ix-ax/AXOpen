@using AxOpen.Security
@using AxOpen.Security.Entities
@using AxOpen.Security.Services
@using Microsoft.AspNetCore.Identity
@inherits LayoutComponentBase

<PageTitle>librarytemplate.blazor</PageTitle>
<TopRow />
<div class="page" @onmousedown="OnUserActivity">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@inject InactivityService _inactivityService
@inject NavigationManager _navigationManager
@inject SignInManager<User> _signInManager

@code {
    protected override void OnInitialized()
    {
        _inactivityService.SetAction(() => LogoutUser());
    }

    private void LogoutUser()
    {
        _signInManager.SignOutAsync();
        _navigationManager.Refresh(true);
    }

    private void OnUserActivity()
    {
        _inactivityService.Reset();
    }

    public void Dispose()
    {
        _inactivityService.Dispose();
    }
}