@page "/DistributedData"
@using AXOpen.Base.Dialogs;
@using AXOpen.Data;
@using librarytemplate
@inject AuthenticationStateProvider _authenticationProvider
@inject IAlertService _alertDialogService

<div class="card">
    <div class="card-header">
        <h2>Distributed Data selector</h2>
    </div>
    <div class="card-body">
         //<BlazorViewDistributedDataSelector> 
            <DistributedDataSelectorView GroupName="default" ConfigSuffix=""/>
         //</BlazorViewDistributedDataSelector>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2>Distributed Data View</h2>
    </div>
    <div class="card-body">
         //<BlazorViewDistributedData> 
           <DistributedDataView Presentation="Command"
                     GroupName="default" 
                     ConfigSuffix="" 
                     DisplayOnePerDataType="true" 
                     EnableCreate="true" 
                     EnableDelete="true" 
                     EnableCopy="true" 
                     EnableFiltering="true"
                     EnableSorting="false"
                     EnableExport="true" 
                     EnableSendToPlc="true"
                     EnableCreateNewFromPlc="true"
                     />
         //</BlazorViewDistributedData>
    </div>
</div>
