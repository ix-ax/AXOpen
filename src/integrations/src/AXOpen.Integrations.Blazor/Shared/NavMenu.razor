@using axopen_integrations_blazor
@using axopen_integrations
@using Operon.Icons
@inject NavigationManager NavigationManager
@implements IDisposable


<button class="btn btn-no-bg-primary w-full md:hidden!" @onclick="ToggleNavMenu">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mx-auto">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
    </svg>
</button>

@if (!_navCollapsed)
{
    <nav class="nav w-full md:w-64">
        <NavLink href="Simatic-ax" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            Simatic-AX
        </NavLink>
        <NavLink href="AxoTask" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoTask
        </NavLink>
        <NavLink href="AxoToggleTask" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoToggleTask
        </NavLink>
        <NavLink href="AxoMomentaryTask" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoMomentaryTask
        </NavLink>
        <NavLink href="AxoRemoteTask" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoRemoteTask
        </NavLink>
        <NavLink href="AxoComponentExample" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoComponentExample
        </NavLink>
        <NavLink href="AxoComponentHeaderOnlyExample" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoComponentHeaderOnlyExample
        </NavLink>
        <NavLink href="AxoSequencer" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoSequencer
        </NavLink>
        <NavLink href="AxoSequencerContainer" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoSequencerContainer
        </NavLink>
        <NavLink href="AxoData" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoData
        </NavLink>
        <NavLink href="AxoDataRemote" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoDataRemote
        </NavLink>
        <NavLink href="AxoDataFragmentsRemote" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoDataFragmentsRemote
        </NavLink>
        <NavLink href="AxoDataFragmentsRemote" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoDataFragmentsRemote
        </NavLink>
        <NavLink href="AxoMessagingStatic" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoMessagingStatic
        </NavLink>
        <NavLink href="DocuExamples" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            DocuExamples
        </NavLink>
        <NavLink href="AxoTextListExample" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoTextListExample
        </NavLink>
        <NavLink href="AxoArraysExamples" class="nav-item" activeClass="active" Match="NavLinkMatch.All">
            <HeroIcon Icon="home" Type="Operon.Icons.IconType.Outline" Class="size-5 me-2 my-auto" />
            AxoArraysExamples
        </NavLink>
    </nav>
}

<div class="fixed bottom-0 right-0 hidden md:block w-64">
    <button class="btn btn-no-bg-primary w-full" @onclick="ToggleNavMenu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mx-auto">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
        </svg>
    </button>

    <a href="">
        <img src="logo-header.svg" width="100%" />
    </a>
</div>


@code {
    private bool _navCollapsed = false;

    public void ToggleNavMenu() => _navCollapsed = !_navCollapsed;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navCollapsed = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
