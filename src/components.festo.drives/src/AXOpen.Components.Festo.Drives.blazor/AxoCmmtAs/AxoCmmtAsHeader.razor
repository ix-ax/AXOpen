@namespace AXOpen.Components.Festo.Drives
@using Microsoft.AspNetCore.Components
@using System

<div class="flex flex-wrap items-center justify-between gap-4 border-b border-border/40 pb-3" @onclick="Context.ToggleAdvancedMode">
    <div class="flex items-center gap-2 text-text">
        <span class="text-xs text-text/60">@(Context.DisplayMode == AxoCmmtAsView.eDisplayMode.Advanced ? "▼" : "▶")</span>
        <h4 class="text-lg font-semibold">@Context.Component.AttributeName</h4>
    </div>
    <div class="flex flex-wrap items-center gap-2" @onclick:stopPropagation="true">
        <span class="@Context.PoweredStatePill">Powered</span>
        <span class="@Context.FaultStatePill">Fault</span>
        <span class="@Context.DriveStatePillClass">@Context.DriveStateLabel</span>
        @if (Context.HasActiveMessages)
        {
            <button type="button"
                    @onclick="Context.ToggleMessages"
                    class="@Context.AlarmBadgePillClass hover:bg-background/70 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-amber-400/40"
                    title="@Context.ActiveAlarmCount @(Context.ActiveAlarmCount != 1 ? "alarms" : "alarm") active">
                @Context.ActiveAlarmCount Alarm@(Context.ActiveAlarmCount != 1 ? "s" : string.Empty)
            </button>
        }
        <button type="button"
                class="@Context.ServiceTogglePillClass hover:bg-background/70 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-sky-400/40"
                @onclick="Context.ToggleServiceView">
            @(Context.DisplayMode >= AxoCmmtAsView.eDisplayMode.Raw ? "Normal" : "Service")
        </button>
    </div>
</div>

@code {
    [Parameter]
    public AxoCmmtAsView Context { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Context == null)
        {
            throw new InvalidOperationException("AxoCmmtAsHeader requires a non-null Context.");
        }
    }
}
