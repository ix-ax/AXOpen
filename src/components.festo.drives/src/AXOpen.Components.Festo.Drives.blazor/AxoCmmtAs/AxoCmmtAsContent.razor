@namespace AXOpen.Components.Festo.Drives
@using AXOpen.Core
@using AXOpen.Messaging
@using AXOpen.Messaging.Static
@using AXSharp.Presentation.Blazor.Controls
@using AXSharp.Presentation.Blazor.Controls.RenderableContent
@using Microsoft.AspNetCore.Components
@using System

<div class="grid gap-3 md:grid-cols-2">
    <div class="flex flex-col gap-3 rounded-2xl border border-border/50 bg-background/60 p-4">
        <h5 class="text-base font-semibold text-text">Key telemetry</h5>
        <div class="grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                <span class="text-xs uppercase tracking-wide text-text/60">Actual position</span>
                <strong class="block text-base font-semibold text-text">@Context.PositionText</strong>
            </div>
            <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                <span class="text-xs uppercase tracking-wide text-text/60">Actual velocity</span>
                <strong class="block text-base font-semibold text-text">@Context.VelocityText</strong>
            </div>
            <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                <span class="text-xs uppercase tracking-wide text-text/60">Actual torque</span>
                <strong class="block text-base font-semibold text-text">@Context.TorqueText</strong>
            </div>
            <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                <span class="text-xs uppercase tracking-wide text-text/60">Drive status</span>
                <strong class="block text-base font-semibold text-text">@Context.DriveStateLabel</strong>
            </div>
        </div>
    </div>
    <div class="flex flex-col gap-3 rounded-2xl border border-border/50 bg-background/60 p-4">
        <h5 class="text-base font-semibold text-text">Axis reference bits</h5>
        <div class="grid grid-cols-2 gap-2 text-xs">
            <span class="@Context.AxisReadyPillClass">Operation enabled</span>
            <span class="@Context.AxisFaultPillClass">Fault present</span>
            <span class="@Context.DriveStoppedPillClass">Drive stopped</span>
            <span class="@Context.AxisFollowingPillClass">Following OK</span>
        </div>
    </div>
</div>

<div class="mt-4 flex flex-col gap-3">
    <h5 class="text-base font-semibold text-text">Motion tasks</h5>
    <div class="grid gap-3 md:grid-cols-3">
        <AxoTaskCommandView Component="Context.Component.AxoStop_Task" Text="Stop" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
        <AxoTaskCommandView Component="Context.Component.AxoHalt_Task" Text="Halt" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
        <AxoTaskCommandView Component="Context.Component.AxoHome_Task" Text="Home" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
        <AxoTaskCommandView Component="Context.Component.AxoMoveAbsolute_Task" Text="Move abs" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
        <AxoTaskCommandView Component="Context.Component.AxoMoveRelative_Task" Text="Move rel" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
    </div>
    <div class="grid gap-3 md:grid-cols-4">
        <AxoTaskCommandView Component="Context.Component.AxoMoveAdditive_Task" Text="Move additive" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
        <AxoTaskCommandView Component="Context.Component.AxoMoveVelocity_Task" Text="Move velocity" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
        <AxoTaskCommandView Component="Context.Component.AxoTorqueControl_Task" Text="Torque" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
        <AxoTaskCommandView Component="Context.Component.RestoreTask" Text="Restore" HideRestoreButton="false" Enabled="@Context.Component._isManuallyControllable.Cyclic" />
    </div>
</div>

<details class="rounded-2xl border border-border/50 bg-background/60 p-4 text-text transition open:shadow-xl">
    <summary class="cursor-pointer text-base font-semibold text-text">Setpoints and configuration</summary>
    <div class="mt-4 flex flex-col gap-4">
        <div class="grid gap-3 md:grid-cols-2">
            <RenderableContentControl Context="Context.Component.AxoMoveAbsolute_Position" Presentation="Control" />
            <RenderableContentControl Context="Context.Component.AxoMoveAbsolute_Velocity" Presentation="Control" />
            <RenderableContentControl Context="Context.Component.AxoMoveRelative_Distance" Presentation="Control" />
            <RenderableContentControl Context="Context.Component.AxoMoveRelative_Velocity" Presentation="Control" />
            <RenderableContentControl Context="Context.Component.AxoMoveVelocity_Velocity" Presentation="Control" />
            <RenderableContentControl Context="Context.Component.AxoTorqueControl_Torque" Presentation="Control" />
        </div>
        <div class="mt-3 grid gap-3 md:grid-cols-2">
            <RenderableContentControl Context="Context.Component.DriveStatus" Presentation="Display" />
            <RenderableContentControl Context="Context.Component.AxisRefExt.Config" Presentation="Display" />
            <RenderableContentControl Context="Context.Component.AxisRefExt.Status" Presentation="Display" />
            <RenderableContentControl Context="Context.Component.AxisRefExt.Telegram111_In" Presentation="Display" />
            <RenderableContentControl Context="Context.Component.AxisRefExt.Telegram111_Out" Presentation="Display" />
            <RenderableContentControl Context="Context.Component.AxisRefExt.Data" Presentation="Display" />
        </div>
        <RenderableContentControl class="mt-3"
                                  Context="Context.Component.HardwareDiagnosticsTask"
                                  Presentation="Display" />
    </div>
</details>

@if (Context.Component.TaskMessenger != null)
{
    <details class="rounded-2xl border border-border/50 bg-background/60 p-4 text-text transition open:shadow-xl">
        <summary class="cursor-pointer text-base font-semibold text-text">Task messenger</summary>
        <div class="mt-4">
            <AxoMessengerView Component="Context.Component.TaskMessenger" />
        </div>
    </details>
}

@code {
    [Parameter]
    public AxoCmmtAsView Context { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Context == null)
        {
            throw new InvalidOperationException("AxoCmmtAsContent requires a non-null Context.");
        }
    }
}
