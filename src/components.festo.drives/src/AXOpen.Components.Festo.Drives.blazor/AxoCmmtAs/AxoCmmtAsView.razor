@namespace AXOpen.Components.Festo.Drives
@using AXOpen.Components.Festo.Drives
@using AXOpen.Core
@using AXOpen.Messaging
@using AXOpen.Messaging.Static
@using AXSharp.Presentation.Blazor.Controls
@using AXSharp.Presentation.Blazor.Controls.RenderableContent
@inherits RenderableComplexComponentBase<AxoCmmtAs>

<div data-axo-component-view
     class="relative"
     @onmouseenter="BringToForeGround"
     @onmouseleave="BringToZIndexBack">
@if (DisplayMode >= eDisplayMode.Spot)
{
    <div class="drive-card @AlarmBorderClass @AlarmBackgroundClass"
         @onclick="async () => await OpenDetails()">
        <button type="button" @onclick="ToggleSpotMode" class="w-full text-left">
            <div class="drive-hero"
                 data-powered="@(IsPowered ? "true" : "false")"
                 data-fault="@(HasFault ? "true" : "false")"
                 data-warning="@(HasWarning ? "true" : "false")"
                 data-motion="@HeroMotionClass">
                <div class="drive-hero__dial">
                    <div class="drive-hero__needle" style="transform: rotate(@NeedleRotationdeg);"></div>
                    <div class="drive-hero__value">@VelocityText</div>
                    <span class="drive-hero__label">VEL</span>
                </div>
                <div class="drive-hero__metrics">
                    <div>
                        <span class="label">Position</span>
                        <strong>@PositionText</strong>
                    </div>
                    <div>
                        <span class="label">Torque</span>
                        <strong>@TorqueText</strong>
                    </div>
                    <div>
                        <span class="label">State</span>
                        <strong>@DriveStateLabel</strong>
                    </div>
                </div>
                <div class="drive-hero__indicators">
                    <span class="badge @(IsPowered ? "badge-success" : "badge-outline")">Ready</span>
                    <span class="badge @(HasFault ? "badge-danger" : "badge-outline")">Fault</span>
                    <span class="badge @(IsStopping ? "badge-warning" : "badge-outline")">Stopping</span>
                </div>
            </div>
        </button>
    </div>
}

@if (DisplayMode != eDisplayMode.Spot)
{
    <div class="drive-panel border rounded-lg bg-background/80 @AlarmBorderClass">
        @if (DisplayMode >= eDisplayMode.Basic)
        {
            <div class="drive-panel__header" @onclick="ToggleAdvancedMode">
                <div class="flex items-center gap-2">
                    <span class="text-xs">@(DisplayMode == eDisplayMode.Advanced ? "▼" : "▶")</span>
                    <h4 class="text-lg font-semibold text-text">@Component.AttributeName</h4>
                </div>
                <div class="flex items-center gap-2" @onclick:stopPropagation="true">
                    <span class="badge @(IsPowered ? "badge-success" : "badge-outline")">Powered</span>
                    <span class="badge @(HasFault ? "badge-danger" : "badge-outline")">Fault</span>
                    <span class="badge badge-outline">@DriveStateLabel</span>
                    @if (HasActiveMessages)
                    {
                        <button type="button"
                                @onclick="ToggleMessages"
                                class="badge @AlarmBadgeClass"
                                title="@ActiveAlarmCount @(ActiveAlarmCount != 1 ? "alarms" : "alarm") active">
                            @ActiveAlarmCount Alarm@(ActiveAlarmCount != 1 ? "s" : string.Empty)
                        </button>
                    }
                    <button type="button"
                            class="badge badge-primary"
                            @onclick="ToggleServiceView">
                        @(DisplayMode >= eDisplayMode.Raw ? "Normal" : "Service")
                    </button>
                </div>
            </div>

            @if (ShowMessages && _alarmCount > 0 && _messageProvider?.Messengers != null)
            {
                <div class="flex flex-col gap-2 border-t border-border pt-3">
                    @foreach (var alarm in _messageProvider.Messengers)
                    {
                        if (alarm.State != eAxoMessengerState.Idle)
                        {
                            <AxoMessengerView Component="alarm" />
                        }
                    }
                </div>
            }
        }

        @if (DisplayMode == eDisplayMode.Advanced)
        {           
            <div class="grid gap-3 md:grid-cols-2">
                <div class="p-4 rounded-lg border border-border flex flex-col gap-3">
                    <h5 class="text-base font-semibold text-text">Key telemetry</h5>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                        <div>
                            <span class="label">Actual position</span>
                            <strong>@PositionText</strong>
                        </div>
                        <div>
                            <span class="label">Actual velocity</span>
                            <strong>@VelocityText</strong>
                        </div>
                        <div>
                            <span class="label">Actual torque</span>
                            <strong>@TorqueText</strong>
                        </div>
                        <div>
                            <span class="label">Drive status</span>
                            <strong>@DriveStateLabel</strong>
                        </div>
                    </div>
                </div>
                <div class="p-4 rounded-lg border border-border flex flex-col gap-3">
                    <h5 class="text-base font-semibold text-text">Axis reference bits</h5>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <span class="badge @(AxisReady ? "badge-success" : "badge-outline")">Operation enabled</span>
                        <span class="badge @(AxisFault ? "badge-danger" : "badge-outline")">Fault present</span>
                        <span class="badge @(DriveStopped ? "badge-info" : "badge-outline")">Drive stopped</span>
                        <span class="badge @(AxisFollowing ? "badge-primary" : "badge-outline")">Following OK</span>
                    </div>
                </div>
            </div>

            <div class="mt-4 flex flex-col gap-3">
                <h5 class="text-base font-semibold text-text">Motion tasks</h5>
                <div class="grid gap-3 md:grid-cols-3">
                    <AxoTaskCommandView Component="Component.AxoStop_Task" Text="Stop" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                        <AxoTaskCommandView Component="Component.AxoHalt_Task" Text="Halt" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                        <AxoTaskCommandView Component="Component.AxoHome_Task" Text="Home" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                        <AxoTaskCommandView Component="Component.AxoMoveAbsolute_Task" Text="Move abs" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                        <AxoTaskCommandView Component="Component.AxoMoveRelative_Task" Text="Move rel" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                </div>
                <div class="grid gap-3 md:grid-cols-4">
                        <AxoTaskCommandView Component="Component.AxoMoveAdditive_Task" Text="Move additive" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                        <AxoTaskCommandView Component="Component.AxoMoveVelocity_Task" Text="Move velocity" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                        <AxoTaskCommandView Component="Component.AxoTorqueControl_Task" Text="Torque" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                        <AxoTaskCommandView Component="Component.RestoreTask" Text="Restore" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                </div>
            </div>

            <details class="drive-details">
                <summary>Setpoints and configuration</summary>
                <div class="drive-details__body">
                    <div class="grid gap-3 md:grid-cols-2">
                        <RenderableContentControl Context="Component.AxoMoveAbsolute_Position" Presentation="Control" />
                        <RenderableContentControl Context="Component.AxoMoveAbsolute_Velocity" Presentation="Control" />
                        <RenderableContentControl Context="Component.AxoMoveRelative_Distance" Presentation="Control" />
                        <RenderableContentControl Context="Component.AxoMoveRelative_Velocity" Presentation="Control" />
                        <RenderableContentControl Context="Component.AxoMoveVelocity_Velocity" Presentation="Control" />
                        <RenderableContentControl Context="Component.AxoTorqueControl_Torque" Presentation="Control" />
                    </div>
                    <div class="grid gap-3 md:grid-cols-2 mt-3">
                        <RenderableContentControl Context="Component.DriveStatus" Presentation="Display" />
                        <RenderableContentControl Context="Component.AxisRefExt.Config" Presentation="Display" />
                        <RenderableContentControl Context="Component.AxisRefExt.Status" Presentation="Display" />
                        <RenderableContentControl Context="Component.AxisRefExt.Telegram111_In" Presentation="Display" />
                        <RenderableContentControl Context="Component.AxisRefExt.Telegram111_Out" Presentation="Display" />
                        <RenderableContentControl Context="Component.AxisRefExt.Data" Presentation="Display" />
                    </div>
                    <RenderableContentControl class="mt-3"
                                              Context="Component.HardwareDiagnosticsTask"
                                              Presentation="Display" />
                </div>
            </details>

            @if (Component.TaskMessenger != null)
            {
                <details class="drive-details">
                    <summary>Task messenger</summary>
                    <div class="drive-details__body">
                        <AxoMessengerView Component="Component.TaskMessenger" />
                    </div>
                </details>
            }
        }

        @if (DisplayMode == eDisplayMode.Raw)
        {
            <AxoComponentView Component="Component" HideHeader="true" IsControllable="true" />
        }
    </div>
}
</div>
