                            <RenderableContentControl Context="Component.AxoReadDigitalInput_InputNumber" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoReadDigitalInput_Value" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoReadDigitalInput_Valid" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoReadDigitalOutput_OutputNumber" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoReadDigitalOutput_Value" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoReadDigitalOutput_Valid" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoWriteDigitalOutput_OutputNumber" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoWriteDigitalOutput_Value" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoWriteDigitalOutput_ExecutionMode" Presentation="Display" />
                        </div>
                    </div>
                </TabPage>

                <TabPage Title="@Localizer["ExplicitReads"]">
                    <div class="flex flex-col gap-3 p-2">
                        <div class="grid gap-2 md:grid-cols-2">
                            <AxoToggleTaskStatusView Text="@Localizer["ReadActualPosition"]" Component="Component.AxoReadActualPosition_Task" HideRestoreButton="false" />
                            <AxoToggleTaskStatusView Text="@Localizer["ReadActualVelocity"]" Component="Component.AxoReadActualVelocity_Task" HideRestoreButton="false" />
                            <AxoToggleTaskStatusView Text="@Localizer["ReadActualTorque"]" Component="Component.AxoReadActualTorque_Task" HideRestoreButton="false" />
                            <AxoToggleTaskStatusView Text="@Localizer["ReadStatus"]" Component="Component.AxoReadStatus_Task" HideRestoreButton="false" />
                            <AxoToggleTaskStatusView Text="@Localizer["ReadMotionState"]" Component="Component.AxoReadMotionState_Task" HideRestoreButton="false" />
                            <AxoToggleTaskStatusView Text="@Localizer["ReadAxisInfo"]" Component="Component.AxoReadAxisInfo_Task" HideRestoreButton="false" />
                        </div>
                        <div class="grid gap-3 md:grid-cols-3">
                            <RenderableContentControl Context="Component.AxoReadActualPosition_Value" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoReadActualVelocity_Value" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoReadActualTorque_Value" Presentation="Display" />
                            <RenderableContentControl Context="Component.AxoReadMotionState_Source" Presentation="Display" />
                        </div>
                    </div>
                </TabPage>
            </Tab>
        </div>
    </CommandsMonitorContent>

    <ConfigAndStateViewContent>
        <div class="grid gap-4 w-full" @onclick:stopPropagation="true">
            <section class="flex flex-col gap-3 p-4 rounded-xl border border-slate-400/35 bg-slate-900/35 backdrop-blur-sm">
                <div class="section-header">
                    <h6 class="m-0 font-semibold text-[0.95rem] text-slate-100/95">@Localizer["DriveFeedback"]</h6>
                    <p class="m-0 text-[0.8rem] text-slate-400/90">@Localizer["DriveFeedbackDescription"]</p>
                </div>
                <div class="grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.DriveStatus" Presentation="Status-Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Status" Presentation="Status-Display" />
                    <RenderableContentControl Context="Component.Messenger" Presentation="Status-Display" />
                    <RenderableContentControl Context="Component.TaskMessenger" Presentation="Status-Display" />
                    <RenderableContentControl Context="Component.HardwareDiagnosticsTask" Presentation="Status-Display" />
                </div>
            </section>

            <section class="flex flex-col gap-3 p-4 rounded-xl border border-slate-400/35 bg-slate-900/35 backdrop-blur-sm">
                <div class="section-header">
                    <h6 class="m-0 font-semibold text-[0.95rem] text-slate-100/95">@Localizer["ScalingConstants"]</h6>
                    <p class="m-0 text-[0.8rem] text-slate-400/90">@Localizer["ScalingConstantsDescription"]</p>
                </div>
                <div class="grid gap-3 md:grid-cols-3">
                    <RenderableContentControl Context="Component.ScalingConstantRequiredPosition" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualPosition" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredVelocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualVelocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredAcceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualAcceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredDeceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualDeceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredTorque" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualTorque" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredJerk" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualJerk" Presentation="Display" />
                </div>
            </section>

            <section class="flex flex-col gap-3 p-4 rounded-xl border border-slate-400/35 bg-slate-900/35 backdrop-blur-sm">
                <div class="section-header">
                    <h6 class="m-0 font-semibold text-[0.95rem] text-slate-100/95">@Localizer["AxisReference"]</h6>
                    <p class="m-0 text-[0.8rem] text-slate-400/90">@Localizer["AxisReferenceDescription"]</p>
                </div>
                <div class="grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram111_In" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram111_Out" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram750_In" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram750_Out" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.HWIDs" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Data" Presentation="Display" />
                </div>
            </section>
        </div>
    </ConfigAndStateViewContent>

    <SpotContent>
        <div class="drive-spot">
            <div class="drive-spot__state">
                <span>@DriveStateLabel</span>
                
                @* <span>@CurrentMotionTaskLabel</span> *@
            </div>
            <div class="drive-spot__metric">
                <p>@Localizer["Position"]</p>
                <strong>@FormattedPosition</strong>
            </div>
            <div class="drive-spot__metric">
                <p>@Localizer["Velocity"]</p>
                <strong>@FormattedVelocity</strong>
            </div>
            <div class="drive-spot__metric">
                <p>@Localizer["Torque"]</p>
                <strong>@FormattedTorque</strong>
            </div>
        </div>
    </SpotContent>
</AxoComponentContainerView>
