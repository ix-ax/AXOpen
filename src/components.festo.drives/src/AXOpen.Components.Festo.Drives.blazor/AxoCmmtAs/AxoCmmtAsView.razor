@namespace AXOpen.Components.Festo.Drives
@using AXOpen.Core.Blazor
@inherits AxoComponentViewBase<AxoCmmtAs>

<AxoComponentContainerView Component="@Component" ParentReference="this">
    <HeaderContent>       
        <div class="flex flex-wrap items-center gap-2" @onclick:stopPropagation="true">
            <span class="@PoweredStatePill">Powered</span>
            <span class="@FaultStatePill">Fault</span>
            <span class="@DriveStatePillClass">@DriveStateLabel</span>          
        </div>
    </HeaderContent>
    <CommandsContent>
        <div class="grid gap-3 md:grid-cols-2">
            <div class="flex flex-col gap-3 rounded-2xl border border-border/50 bg-background/60 p-4">
                <h5 class="text-base font-semibold text-text">Key telemetry</h5>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <span class="text-xs uppercase tracking-wide text-text/60">Actual position</span>
                        <strong class="block text-base font-semibold text-text">@PositionText</strong>
                    </div>
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <span class="text-xs uppercase tracking-wide text-text/60">Actual velocity</span>
                        <strong class="block text-base font-semibold text-text">@VelocityText</strong>
                    </div>
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <span class="text-xs uppercase tracking-wide text-text/60">Actual torque</span>
                        <strong class="block text-base font-semibold text-text">@TorqueText</strong>
                    </div>
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <span class="text-xs uppercase tracking-wide text-text/60">Drive status</span>
                        <strong class="block text-base font-semibold text-text">@DriveStateLabel</strong>
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-3 rounded-2xl border border-border/50 bg-background/60 p-4">
                <h5 class="text-base font-semibold text-text">Axis reference bits</h5>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <span class="@AxisReadyPillClass">Operation enabled</span>
                    <span class="@AxisFaultPillClass">Fault present</span>
                    <span class="@DriveStoppedPillClass">Drive stopped</span>
                    <span class="@AxisFollowingPillClass">Following OK</span>
                </div>
            </div>
        </div>

        <div class="mt-4 flex flex-col gap-3">
            <h5 class="text-base font-semibold text-text">Motion tasks</h5>
            <div class="grid gap-3 md:grid-cols-3">
                <AxoTaskCommandView Component="Component.AxoStop_Task" Text="Stop" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoHalt_Task" Text="Halt" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoHome_Task" Text="Home" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoMoveAbsolute_Task" Text="Move abs" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoMoveRelative_Task" Text="Move rel" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
            </div>
            <div class="grid gap-3 md:grid-cols-4">
                <AxoTaskCommandView Component="Component.AxoMoveAdditive_Task" Text="Move additive" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoMoveVelocity_Task" Text="Move velocity" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoTorqueControl_Task" Text="Torque" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.RestoreTask" Text="Restore" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
            </div>
        </div>

        <details class="rounded-2xl border border-border/50 bg-background/60 p-4 text-text transition open:shadow-xl">
            <summary class="cursor-pointer text-base font-semibold text-text">Setpoints and configuration</summary>
            <div class="mt-4 flex flex-col gap-4">
                <div class="grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Position" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Distance" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Torque" Presentation="Control" />
                </div>
                <div class="mt-3 grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.DriveStatus" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Config" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Status" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram111_In" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram111_Out" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Data" Presentation="Display" />
                </div>
                <RenderableContentControl class="mt-3"
                                          Context="Component.HardwareDiagnosticsTask"
                                          Presentation="Display" />
            </div>
        </details>
    </CommandsContent>

    <StatusContent>
        <div class="grid gap-3 md:grid-cols-2">
            <div class="flex flex-col gap-3 rounded-2xl border border-border/50 bg-background/60 p-4">
                <h5 class="text-base font-semibold text-text">Key telemetry</h5>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <span class="text-xs uppercase tracking-wide text-text/60">Actual position</span>
                        <strong class="block text-base font-semibold text-text">@PositionText</strong>
                    </div>
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <span class="text-xs uppercase tracking-wide text-text/60">Actual velocity</span>
                        <strong class="block text-base font-semibold text-text">@VelocityText</strong>
                    </div>
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <span class="text-xs uppercase tracking-wide text-text/60">Actual torque</span>
                        <strong class="block text-base font-semibold text-text">@TorqueText</strong>
                    </div>
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <span class="text-xs uppercase tracking-wide text-text/60">Drive status</span>
                        <strong class="block text-base font-semibold text-text">@DriveStateLabel</strong>
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-3 rounded-2xl border border-border/50 bg-background/60 p-4">
                <h5 class="text-base font-semibold text-text">Axis reference bits</h5>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <span class="@AxisReadyPillClass">Operation enabled</span>
                    <span class="@AxisFaultPillClass">Fault present</span>
                    <span class="@DriveStoppedPillClass">Drive stopped</span>
                    <span class="@AxisFollowingPillClass">Following OK</span>
                </div>
            </div>
        </div>

        <div class="mt-4 flex flex-col gap-3">
            <h5 class="text-base font-semibold text-text">Motion tasks</h5>
            <div class="grid gap-3 md:grid-cols-3">
                <AxoTaskCommandView Component="Component.AxoStop_Task" Text="Stop" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoHalt_Task" Text="Halt" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoHome_Task" Text="Home" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoMoveAbsolute_Task" Text="Move abs" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoMoveRelative_Task" Text="Move rel" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
            </div>
            <div class="grid gap-3 md:grid-cols-4">
                <AxoTaskCommandView Component="Component.AxoMoveAdditive_Task" Text="Move additive" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoMoveVelocity_Task" Text="Move velocity" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.AxoTorqueControl_Task" Text="Torque" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
                <AxoTaskCommandView Component="Component.RestoreTask" Text="Restore" HideRestoreButton="false" Enabled="@Component._isManuallyControllable.Cyclic" />
            </div>
        </div>

        <details class="rounded-2xl border border-border/50 bg-background/60 p-4 text-text transition open:shadow-xl">
            <summary class="cursor-pointer text-base font-semibold text-text">Setpoints and configuration</summary>
            <div class="mt-4 flex flex-col gap-4">
                <div class="grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Position" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Distance" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Torque" Presentation="Control" />
                </div>
                <div class="mt-3 grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.DriveStatus" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Config" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Status" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram111_In" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram111_Out" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Data" Presentation="Display" />
                </div>
                <RenderableContentControl class="mt-3"
                                          Context="Component.HardwareDiagnosticsTask"
                                          Presentation="Display" />
            </div>
        </details>
    </StatusContent>

    <StateContent>
        <!--
            TODO: Here add `State` details consider this as an expanded version of the header.
        -->
    </StateContent>
    <SpotContent>
        <div class="flex flex-col gap-6 rounded-2xl border border-border/40 bg-background/80 px-6 py-5 backdrop-blur @HeroStateClasses">
            <div class="flex flex-wrap items-center gap-6">
                <div class="relative h-32 w-32 shrink-0">
                    <div class="absolute inset-0 rounded-full border border-border/50 bg-black/30"></div>
                    <div class="absolute inset-3 rounded-full border border-border/30 bg-background/70"></div>
                    <div class="absolute left-1/2 bottom-1/2 h-16 w-0.5 origin-bottom -translate-x-1/2 rounded-full bg-emerald-400 shadow-lg transition-[transform] duration-500 ease-out"
                         style="transform: rotate(@NeedleRotationdeg);"></div>
                    <div class="relative flex h-full w-full flex-col items-center justify-center gap-1 text-center">
                        <span class="text-[0.65rem] uppercase tracking-[0.4em] text-text/50">Vel</span>
                        <strong class="text-2xl font-semibold">@VelocityText</strong>
                    </div>
                </div>

                <dl class="grid flex-1 min-w-[14rem] grid-cols-3 gap-3 text-sm">
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <dt class="text-xs uppercase tracking-wide text-text/60">Position</dt>
                        <dd class="text-base font-semibold text-text">@PositionText</dd>
                    </div>
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <dt class="text-xs uppercase tracking-wide text-text/60">Torque</dt>
                        <dd class="text-base font-semibold text-text">@TorqueText</dd>
                    </div>
                    <div class="rounded-xl border border-border/30 bg-background/40 p-3">
                        <dt class="text-xs uppercase tracking-wide text-text/60">State</dt>
                        <dd class="text-base font-semibold text-text">@DriveStateLabel</dd>
                    </div>
                </dl>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <span class="@PoweredStatePill">Ready</span>
                <span class="@FaultStatePill">Fault</span>
                <span class="@StoppingStatePill">Stopping</span>
            </div>
        </div>
    </SpotContent>
</AxoComponentContainerView>

