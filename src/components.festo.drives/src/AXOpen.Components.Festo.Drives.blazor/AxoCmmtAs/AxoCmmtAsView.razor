@namespace AXOpen.Components.Festo.Drives
@using AXOpen.Core
@using AXOpen.Core.Blazor
@using AXOpen.Components.Drives
@inherits AxoComponentViewBase<AxoCmmtAs>

<AxoComponentContainerView Component="@Component" ParentReference="this">
    <HeaderContent>
        <div class="flex flex-wrap items-center gap-3 text-xs md:text-sm" @onclick:stopPropagation="true">
            <span class="badge @DriveStateBadgeClass">@DriveStateLabel</span>
            <span class="badge badge-soft">@CurrentMotionTaskLabel</span>
            <div class="metric-pill">
                <span>Position</span>
                <strong>@FormattedPosition</strong>
            </div>
            <div class="metric-pill">
                <span>Velocity</span>
                <strong>@FormattedVelocity</strong>
            </div>
            <div class="metric-pill">
                <span>Torque</span>
                <strong>@FormattedTorque</strong>
            </div>
        </div>
    </HeaderContent>

    <CommandsContent>
        <div class="flex flex-col gap-4 w-full" @onclick:stopPropagation="true">
            <section class="drive-section">
                <div class="section-header">
                    <h6>Power &amp; safety</h6>
                    <p>Enable the power stage, toggle brakes and trigger controlled stops.</p>
                </div>
                <div class="tasks-grid">
                    <AxoToggleTaskCommandView Text="Power stage" Component="Component.AxoPower_Task" HideRestoreButton="false" />
                    <AxoTaskCommandView Text="Controlled stop" Component="Component.AxoStop_Task" HideRestoreButton="false" />
                    <AxoTaskCommandView Text="Halt" Component="Component.AxoHalt_Task" HideRestoreButton="false" />
                </div>
                <div class="grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.AxoPower_Status" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoPower_ErrorID" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoStop_Deceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoStop_Jerk" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoHalt_Deceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoHalt_Jerk" Presentation="Control" />
                </div>
            </section>

            <section class="drive-section">
                <div class="section-header">
                    <h6>Homing &amp; referencing</h6>
                    <p>Align the axis, set offsets and manage override factors.</p>
                </div>
                <div class="tasks-grid">
                    <AxoTaskCommandView Text="Home" Component="Component.AxoHome_Task" HideRestoreButton="false" />
                    <AxoTaskCommandView Text="Set position" Component="Component.AxoSetPosition_Task" HideRestoreButton="false" />
                    <AxoToggleTaskCommandView Text="Override" Component="Component.AxoSetOverride_Task" HideRestoreButton="false" />
                </div>
                <div class="grid gap-3 md:grid-cols-3">
                    <RenderableContentControl Context="Component.AxoHome_Position" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoHome_HommingMode" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoHome_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoHome_Acceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoHome_Deceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoSetPosition_Position" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoSetPosition_Relative" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoSetOverride_VelFactor" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoSetOverride_AccFactor" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoSetOverride_JerkFactor" Presentation="Control" />
                </div>
            </section>

            <section class="drive-section">
                <div class="section-header">
                    <h6>Discrete motion</h6>
                    <p>Execute absolute, relative or additive positioning moves.</p>
                </div>
                <div class="tasks-grid">
                    <AxoTaskCommandView Text="Move absolute" Component="Component.AxoMoveAbsolute_Task" HideRestoreButton="false" />
                    <AxoTaskCommandView Text="Move relative" Component="Component.AxoMoveRelative_Task" HideRestoreButton="false" />
                    <AxoTaskCommandView Text="Move additive" Component="Component.AxoMoveAdditive_Task" HideRestoreButton="false" />
                </div>
                <div class="grid gap-3 md:grid-cols-3">
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Position" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Acceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Deceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Jerk" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Distance" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Acceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Deceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAdditive_Distance" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAdditive_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveAdditive_Acceleration" Presentation="Control" />
                </div>
            </section>

            <section class="drive-section">
                <div class="section-header">
                    <h6>Continuous motion &amp; torque</h6>
                    <p>Manage velocity mode and torque-controlled moves.</p>
                </div>
                <div class="tasks-grid">
                    <AxoTaskCommandView Text="Velocity" Component="Component.AxoMoveVelocity_Task" HideRestoreButton="false" />
                    <AxoTaskCommandView Text="Torque control" Component="Component.AxoTorqueControl_Task" HideRestoreButton="false" />
                </div>
                <div class="grid gap-3 md:grid-cols-3">
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Acceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Deceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Jerk" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Torque" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_TorqueRamp" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Velocity" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Acceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Deceleration" Presentation="Control" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Jerk" Presentation="Control" />
                </div>
            </section>
        </div>
    </CommandsContent>

    <StatusContent>
        <div class="flex flex-col gap-4 w-full" @onclick:stopPropagation="true">
            <section class="drive-section">
                <div class="section-header">
                    <h6>Power &amp; safety</h6>
                    <p>Live feedback when manual control is disabled.</p>
                </div>
                <div class="tasks-grid">
                    <AxoToggleTaskStatusView Text="Power stage" Component="Component.AxoPower_Task" HideRestoreButton="false" />
                    <AxoTaskStatusView Text="Controlled stop" Component="Component.AxoStop_Task" HideRestoreButton="false" />
                    <AxoTaskStatusView Text="Halt" Component="Component.AxoHalt_Task" HideRestoreButton="false" />
                </div>
                <div class="grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.AxoPower_Status" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoPower_ErrorID" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoStop_Deceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoStop_Jerk" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoHalt_Deceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoHalt_Jerk" Presentation="Display" />
                </div>
            </section>

            <section class="drive-section">
                <div class="section-header">
                    <h6>Homing &amp; referencing</h6>
                    <p>Monitor reference tasks, offsets and override factors.</p>
                </div>
                <div class="tasks-grid">
                    <AxoTaskStatusView Text="Home" Component="Component.AxoHome_Task" HideRestoreButton="false" />
                    <AxoTaskStatusView Text="Set position" Component="Component.AxoSetPosition_Task" HideRestoreButton="false" />
                    <AxoToggleTaskStatusView Text="Override" Component="Component.AxoSetOverride_Task" HideRestoreButton="false" />
                </div>
                <div class="grid gap-3 md:grid-cols-3">
                    <RenderableContentControl Context="Component.AxoHome_Position" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoHome_HommingMode" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoHome_Velocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoHome_Acceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoHome_Deceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoSetPosition_Position" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoSetPosition_Relative" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoSetOverride_VelFactor" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoSetOverride_AccFactor" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoSetOverride_JerkFactor" Presentation="Display" />
                </div>
            </section>

            <section class="drive-section">
                <div class="section-header">
                    <h6>Discrete motion</h6>
                    <p>Command queues, feed rates and progress of traversing moves.</p>
                </div>
                <div class="tasks-grid">
                    <AxoTaskStatusView Text="Move absolute" Component="Component.AxoMoveAbsolute_Task" HideRestoreButton="false" />
                    <AxoTaskStatusView Text="Move relative" Component="Component.AxoMoveRelative_Task" HideRestoreButton="false" />
                    <AxoTaskStatusView Text="Move additive" Component="Component.AxoMoveAdditive_Task" HideRestoreButton="false" />
                </div>
                <div class="grid gap-3 md:grid-cols-3">
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Position" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Velocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Acceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Deceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveAbsolute_Jerk" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Distance" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Velocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Acceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveRelative_Deceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveAdditive_Distance" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveAdditive_Velocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveAdditive_Acceleration" Presentation="Display" />
                </div>
            </section>

            <section class="drive-section">
                <div class="section-header">
                    <h6>Continuous motion &amp; torque</h6>
                    <p>Observe velocity and torque control loops.</p>
                </div>
                <div class="tasks-grid">
                    <AxoTaskStatusView Text="Velocity" Component="Component.AxoMoveVelocity_Task" HideRestoreButton="false" />
                    <AxoTaskStatusView Text="Torque control" Component="Component.AxoTorqueControl_Task" HideRestoreButton="false" />
                </div>
                <div class="grid gap-3 md:grid-cols-3">
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Velocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Acceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Deceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoMoveVelocity_Jerk" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Torque" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_TorqueRamp" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Velocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Acceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Deceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxoTorqueControl_Jerk" Presentation="Display" />
                </div>
            </section>
        </div>
    </StatusContent>

    <StateContent>
        <div class="grid gap-4 w-full" @onclick:stopPropagation="true">
            <section class="drive-section">
                <div class="section-header">
                    <h6>Drive feedback</h6>
                    <p>Status bits, active tasks and current diagnostics.</p>
                </div>
                <div class="grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.DriveStatus" Presentation="Status-Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Status" Presentation="Status-Display" />
                    <RenderableContentControl Context="Component.Messenger" Presentation="Status-Display" />
                    <RenderableContentControl Context="Component.TaskMessenger" Presentation="Status-Display" />
                    <RenderableContentControl Context="Component.HardwareDiagnosticsTask" Presentation="Status-Display" />
                </div>
            </section>

            <section class="drive-section">
                <div class="section-header">
                    <h6>Scaling constants</h6>
                    <p>Realtime factors calculated from PROFIdrive parameters.</p>
                </div>
                <div class="grid gap-3 md:grid-cols-3">
                    <RenderableContentControl Context="Component.ScalingConstantRequiredPosition" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualPosition" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredVelocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualVelocity" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredAcceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualAcceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredDeceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualDeceleration" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredTorque" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualTorque" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantRequiredJerk" Presentation="Display" />
                    <RenderableContentControl Context="Component.ScalingConstantActualJerk" Presentation="Display" />
                </div>
            </section>

            <section class="drive-section">
                <div class="section-header">
                    <h6>Axis reference</h6>
                    <p>Inspect telegrams, hardware IDs and cached axis data.</p>
                </div>
                <div class="grid gap-3 md:grid-cols-2">
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram111_In" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram111_Out" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram750_In" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Telegram750_Out" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.HWIDs" Presentation="Display" />
                    <RenderableContentControl Context="Component.AxisRefExt.Data" Presentation="Display" />
                </div>
            </section>
        </div>
    </StateContent>

    <SpotContent>
        <div class="drive-spot">
            <div class="drive-spot__state">
                <span>@DriveStateLabel</span>
                <span>@CurrentMotionTaskLabel</span>
            </div>
            <div class="drive-spot__metric">
                <p>Position</p>
                <strong>@FormattedPosition</strong>
            </div>
            <div class="drive-spot__metric">
                <p>Velocity</p>
                <strong>@FormattedVelocity</strong>
            </div>
            <div class="drive-spot__metric">
                <p>Torque</p>
                <strong>@FormattedTorque</strong>
            </div>
        </div>
    </SpotContent>
</AxoComponentContainerView>
