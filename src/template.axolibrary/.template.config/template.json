{
  "$schema": "http://json.schemastore.org/template",
  "author": "MTS spol. s r.o.",
  "classifications": [ "AXOpen", "axolibrary" ],
  "identity": "librarytemplate",
  "name": "AXOpen Library Template",
  "shortName": "axolibrary",
  "tags": {
    "language": "C#",
    "type": "project"
  },  
  "sourceName": "librarytemplate",
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [".vs/**", ".cr/**", "app/.apax/**", "ctrl/.apax/**", ".apax/**", "**/bin/**", "**/obj/**" , "*.sln"  , "*.code-workspace" ]
        }
      ]
    }
  ],
  "symbols": {

    "projname": {
      "type": "parameter",
      "description": ".NET name",
      "datatype": "text",
      "defaultValue": "projname",
      "replaces": "projname",
      "fileRename" : "projname"
    },    
    "inxton_apaxlibname_csproj": {
      "type": "parameter",
      "description": "library dotnet twin csproj name",
      "datatype": "text",
      "defaultValue": "inxton_apaxlibname.csproj",
      "replaces": "inxton_apaxlibname.csproj"
    },    
    "app_apaxappname_csproj": {
      "type": "parameter",
      "description": "application dotnet twin csproj name",
      "datatype": "text",
      "defaultValue": "app_apaxappname.csproj",
      "replaces": "app_apaxappname.csproj"
    },    
    "apaxlibname": {
      "type": "derived",
      "valueSource": "projname",
      "valueTransform": "ConvertToLower",
      "datatype": "text",
      "defaultValue": "apaxlibname",
      "replaces": "apaxlibname"
    },  
    "namespace": {
      "type": "derived",
      "valueSource": "projname",
      "valueTransform": "notTransform",
      "datatype": "text",
      "defaultValue": "Template.Axolibrary",
      "replaces": "Template.Axolibrary"
    }, 

    "axlibname":{
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source":"projname",
        "toLower": true
      },
      "defaultValue": "axolib",
      "replaces": "axolib"
    },



    "name": {
      "type": "derived",
      "valueSource": "axlibname",
      "valueTransform": "DeleteDotsInFileName",
      "datatype": "text",
      "defaultValue": "librarytemplate",
      "replaces": "librarytemplate",
      "fileRename": "librarytemplate",
      "description": "A value derived from the 'axlibname' prop, used to rename librarytemplate"
    }, 

 
    "apaxappname.csproj": {
      "type": "derived",
      "valueSource": "projname",
      "valueTransform": "ConvertToLowerReplaceTheDotsAndAppendCsproj",
      "datatype": "text",
      "defaultValue": "apaxappname.csproj",
      "replaces": "apaxappname.csproj"
    },  
    "apaxappname": {
      "type": "derived",
      "valueSource": "projname",
      "valueTransform": "ConvertToLower",
      "datatype": "text",
      "defaultValue": "apaxappname",
      "replaces": "apaxappname"
    },  
    "appconnectorname": {
      "type": "derived",
      "valueSource": "axlibname",
      "valueTransform": "ReplaceDotsInFileName",
      "datatype": "text",
      "defaultValue": "appconnectorname",
      "replaces": "appconnectorname",
      "fileRename": "appconnectorname",
      "description": "AX# connector name for testing application."
    },
    "renameDotNetTwinCsProjFileName": {
      "include" : "*.csproj",
      "exclude" : "apax.yml",
      "type": "derived",  
      "valueSource": "axlibname",  
      "valueTransform": "ReplaceDotsInFileName",  
      "fileRename": "axolib",  
      "description": "A value derived from the 'name' param, used to rename Application1.cs"
    },
    "renameDotNetTwinCsProjReferences": {
      "include" : "*.csproj",
      "exclude" : "apax.yml", 
      "type": "derived",  
      "valueSource": "axlibname",  
      "valueTransform": "ReplaceDotsInFileName",  
      "replaces": "axolib",  
      "description": "A value derived from the 'name' param, used to rename Application1.cs"
    },   
    "projnameLower":{
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source":"projname",
        "toLower": true
      }
    }, 
    
    "nameUpper":{
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source":"projname",
        "toLower": false
      }
    }
  },
  "forms": {
    "ReplaceDotsInFileName": {
      "identifier": "replace",
      "pattern": "\\.",        
      "replacement": "_"  
    },
    "DeleteDotsInFileName": {
      "identifier": "replace",
      "pattern": "\\.",        
      "replacement": ""  
    },
    "notTransform":{    
    },
    "ReplaceDots": {
      "identifier": "replace",
      "pattern": "\\.",        
      "replacement": "_"  
    },
    "ConvertToLower": {
      "identifier": "lowerCase"
    },
    "ConvertToLowerAndReplaceTheDots": {
      "identifier": "chain",
      "steps": [
        "ConvertToLower",
        "ReplaceDots"
      ]
    },
    "ConvertToLowerReplaceTheDotsAndAppendCsproj": {
      "identifier": "chain",
      "steps": [
        "ConvertToLowerAndReplaceTheDots",
        "AppendCsproj"
      ]
    },    
    "AppendCsproj": {
      "identifier": "postfix",
      "postfix": ".csproj"
    },
    "AddInxtonPrefix": {
      "identifier": "prefix",
      "prefix": "inxton_"
    },
    "AddInxtonPrefixConvertToLowerReplaceTheDotsAndAppendCsproj": {
      "identifier": "chain",
      "steps": [
        "ConvertToLowerAndReplaceTheDots",
        "AddInxtonPrefix",
        "AppendCsproj"
      ]
    }
  } 
}

