@page "/core/doc-snippets/AxoToggleTaskDocu"
@using AXOpen.Core;
<h3>AxoToggleTaskDocu</h3>

<div class="max-w-4xl mx-auto">
    <div class="card">
        <div class="flex items-center px-4 py-3 border-b border-primary">
            <div class="text-primary font-semibold">ToggleTask example.</div>
        </div>
        <div class="card-body">
            <div class="text-left">
                <div class="flex flex-col gap-4">
                    <div class="flex-1">
                        <div class="card p-2">
                            <label>Displayed using AxoToggleTaskView. Controlable as the value of Disable is FALSE"</label>
                            //<AxoToggleTaskViewControlable>
                                <AxoToggleTaskView Component="@Entry.Plc.Ctx.AxoToggleTaskDocu._myToggleTask" Disable="false" />
                            //</AxoToggleTaskViewControlable>
                        </div>
                        <div class="card p-2">
                            <label>Displayed using AxoToggleTaskView. Viewable only as the value of Disable is TRUE"</label>
                            //<AxoToggleTaskViewDisplayOnly>
                                <AxoToggleTaskView Component="@Entry.Plc.Ctx.AxoToggleTaskDocu._myToggleTask" Disable="true" />
                            //</AxoToggleTaskViewDisplayOnly>
                        </div>
                        <div class="card p-2">
                            <label>Rendered by using RenderableContentControl. Controllable as the Presentation is Command</label>
                            //<RenderableContentControlCommand>
                                <RenderableContentControl Context="@Entry.Plc.Ctx.AxoToggleTaskDocu._myToggleTask" Presentation="Command" />
                            //</RenderableContentControlCommand>
                        </div>
                        <div class="card p-2">
                            <label>Rendered by using RenderableContentControl. Viewable only as the Presentation is Status</label>
                            //<RenderableContentControlStatus>
                                <RenderableContentControl Context="@Entry.Plc.Ctx.AxoToggleTaskDocu._myToggleTask" Presentation="Status" />
                            //</RenderableContentControlStatus>
                        </div>
                   </div>
                </div>
            </div>
        </div>
     </div>
</div>

